# Properties for SmartContract
observable:contractAddress
    a owl:DatatypeProperty ;
    rdfs:label "Contract Address"@en-US ;
    rdfs:comment "The blockchain address where the smart contract is deployed."@en ;
    rdfs:domain observable:SmartContract ;
    rdfs:range xsd:string ;
    .

observable:contractBytecode
    a owl:DatatypeProperty ;
    rdfs:label "Contract Bytecode"@en-US ;
    rdfs:comment "The compiled bytecode of the smart contract."@en ;
    rdfs:domain observable:SmartContract ;
    rdfs:range xsd:string ;
    .

observable:contractABI
    a owl:DatatypeProperty ;
    rdfs:label "Contract ABI"@en-US ;
    rdfs:comment "The Application Binary Interface (ABI) of the smart contract."@en ;
    rdfs:domain observable:SmartContract ;
    rdfs:range xsd:string ;
    .

observable:deploymentDate
    a owl:DatatypeProperty ;
    rdfs:label "Deployment Date"@en-US ;
    rdfs:comment "The date and time when the smart contract was deployed."@en ;
    rdfs:domain observable:SmartContract ;
    rdfs:range xsd:dateTime ;
    .

# Properties for ContractEvent
observable:eventName
    a owl:DatatypeProperty ;
    rdfs:label "event name"@en ;
    rdfs:comment "The name of the contract event."@en ;
    rdfs:range xsd:string ;
    .

observable:eventSignature
    a owl:DatatypeProperty ;
    rdfs:label "event signature"@en ;
    rdfs:comment "The signature of the contract event."@en ;
    rdfs:range xsd:string ;
    .

observable:eventData
    a owl:DatatypeProperty ;
    rdfs:label "event data"@en ;
    rdfs:comment "The data associated with the contract event."@en ;
    rdfs:range xsd:string ;
    .

# Properties for ContractCall
observable:functionName
    a owl:DatatypeProperty ;
    rdfs:label "function name"@en ;
    rdfs:comment "The name of the contract function being called."@en ;
    rdfs:range xsd:string ;
    .

observable:functionSignature
    a owl:DatatypeProperty ;
    rdfs:label "function signature"@en ;
    rdfs:comment "The signature of the contract function being called."@en ;
    rdfs:range xsd:string ;
    .

observable:functionParameters
    a owl:DatatypeProperty ;
    rdfs:label "function parameters"@en ;
    rdfs:comment "The parameters passed to the contract function."@en ;
    rdfs:range xsd:string ;
    .

# Token Classes
observable:Token
    a owl:Class ;
    rdfs:subClassOf observable:BlockchainObservable ;
    rdfs:label "Token"@en-US ;
    rdfs:comment "A digital asset that represents value or utility on a blockchain. Based on ERC-20 (https://eips.ethereum.org/EIPS/eip-20) and ERC-721 (https://eips.ethereum.org/EIPS/eip-721) standards."@en ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:minCount "1"^^xsd:integer ;
            sh:nodeKind sh:Literal ;
            sh:path observable:tokenAddress ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:minCount "1"^^xsd:integer ;
            sh:nodeKind sh:Literal ;
            sh:path observable:tokenSymbol ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:minCount "1"^^xsd:integer ;
            sh:nodeKind sh:Literal ;
            sh:path observable:tokenDecimals ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:minCount "1"^^xsd:integer ;
            sh:nodeKind sh:Literal ;
            sh:path observable:totalSupply ;
        ] ;
    .

# Properties for Token
observable:tokenAddress
    a owl:DatatypeProperty ;
    rdfs:label "Token Address"@en-US ;
    rdfs:comment "The blockchain address of the token contract."@en ;
    rdfs:domain observable:Token ;
    rdfs:range xsd:string ;
    .

observable:tokenSymbol
    a owl:DatatypeProperty ;
    rdfs:label "Token Symbol"@en-US ;
    rdfs:comment "The symbol used to represent the token."@en ;
    rdfs:domain observable:Token ;
    rdfs:range xsd:string ;
    .

observable:tokenDecimals
    a owl:DatatypeProperty ;
    rdfs:label "Token Decimals"@en-US ;
    rdfs:comment "The number of decimal places the token can be divided into."@en ;
    rdfs:domain observable:Token ;
    rdfs:range xsd:integer ;
    .

observable:totalSupply
    a owl:DatatypeProperty ;
    rdfs:label "Total Supply"@en-US ;
    rdfs:comment "The total supply of the token."@en ;
    rdfs:domain observable:Token ;
    rdfs:range xsd:integer ;
    .

# Relationships between classes
observable:isDeployedOn
    a owl:ObjectProperty ;
    rdfs:label "Is Deployed On"@en-US ;
    rdfs:comment "Indicates that a smart contract is deployed on a blockchain. Based on Ethereum Contract Deployment (https://ethereum.org/en/developers/docs/smart-contracts/deploying/)."@en ;
    rdfs:domain observable:SmartContract ;
    rdfs:range observable:Blockchain ;
    .

observable:hasDeployedContract
    a owl:ObjectProperty ;
    owl:inverseOf observable:isDeployedOn ;
    rdfs:label "Has Deployed Contract"@en-US ;
    rdfs:comment "Indicates that a blockchain has deployed smart contracts."@en ;
    rdfs:domain observable:Blockchain ;
    rdfs:range observable:SmartContract ;
    .

observable:isTokenOf
    a owl:ObjectProperty ;
    rdfs:label "Is Token Of"@en-US ;
    rdfs:comment "Indicates that a token is part of a blockchain. Based on ERC-20 and ERC-721 standards."@en ;
    rdfs:domain observable:Token ;
    rdfs:range observable:Blockchain ;
    .

observable:hasToken
    a owl:ObjectProperty ;
    owl:inverseOf observable:isTokenOf ;
    rdfs:label "Has Token"@en-US ;
    rdfs:comment "Indicates that a blockchain has tokens."@en ;
    rdfs:domain observable:Blockchain ;
    rdfs:range observable:Token ;
    .

observable:isImplementedBy
    a owl:ObjectProperty ;
    rdfs:label "Is Implemented By"@en-US ;
    rdfs:comment "Indicates that a token is implemented by a smart contract. Based on ERC-20 and ERC-721 standards."@en ;
    rdfs:domain observable:Token ;
    rdfs:range observable:SmartContract ;
    .

observable:implementsToken
    a owl:ObjectProperty ;
    owl:inverseOf observable:isImplementedBy ;
    rdfs:label "Implements Token"@en-US ;
    rdfs:comment "Indicates that a smart contract implements a token."@en ;
    rdfs:domain observable:SmartContract ;
    rdfs:range observable:Token ;
    .
