# imports: https://ontology.unifiedcyberontology.org/uco/action/1.3.0
# imports: https://ontology.unifiedcyberontology.org/uco/configuration/1.3.0
# imports: https://ontology.unifiedcyberontology.org/uco/core/1.3.0
# imports: https://ontology.unifiedcyberontology.org/uco/identity/1.3.0
# imports: https://ontology.unifiedcyberontology.org/uco/location/1.3.0
# imports: https://ontology.unifiedcyberontology.org/uco/observable/observable-core/1.3.0
# imports: https://ontology.unifiedcyberontology.org/uco/types/1.3.0
# imports: https://ontology.unifiedcyberontology.org/uco/vocabulary/1.3.0

@prefix action: <https://ontology.unifiedcyberontology.org/uco/action/> .
@prefix co: <http://purl.org/co/> .
@prefix configuration: <https://ontology.unifiedcyberontology.org/uco/configuration/> .
@prefix core: <https://ontology.unifiedcyberontology.org/uco/core/> .
@prefix identity: <https://ontology.unifiedcyberontology.org/uco/identity/> .
@prefix location: <https://ontology.unifiedcyberontology.org/uco/location/> .
@prefix observable: <https://ontology.unifiedcyberontology.org/uco/observable/> .
@prefix observable-core: <https://ontology.unifiedcyberontology.org/uco/observable/observable-core/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix types: <https://ontology.unifiedcyberontology.org/uco/types/> .
@prefix vocabulary: <https://ontology.unifiedcyberontology.org/uco/vocabulary/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ontology.unifiedcyberontology.org/uco/observable/observable-software-execution>
	a owl:Ontology ;
	rdfs:label "uco-observable-software-execution"@en ;
	owl:imports
		action:1.3.0 ,
		configuration:1.3.0 ,
		core:1.3.0 ,
		identity:1.3.0 ,
		location:1.3.0 ,
		observable-core:1.3.0 ,
		types:1.3.0 ,
		vocabulary:1.3.0
		;
	owl:versionIRI observable:1.3.0 ;
	.

# Software & Execution Observable base class
observable:SoftwareExecutionObservable
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable-core:ObservableObject ;
	rdfs:label "SoftwareExecutionObservable"@en ;
	rdfs:comment "A software and execution observable is an observable artifact that represents software programs, applications, and code execution."@en ;
	sh:targetClass observable:SoftwareExecutionObservable ;
	owl:disjointWith observable:HostObservable ;
	owl:disjointWith observable:NetworkObservable ;
	owl:disjointWith observable:IdentityAccountObservable ;
	owl:disjointWith observable:CommunicationObservable ;
	owl:disjointWith observable:SocialMediaObservable ;
	owl:disjointWith observable:DeviceObservable ;
	owl:disjointWith observable:CloudObservable ;
	owl:disjointWith observable:ICSObservable ;
	owl:disjointWith observable:ContentMediaObservable ;
	.

# Software Classes
observable:Software
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:SoftwareExecutionObservable ;
	rdfs:label "Software"@en ;
	rdfs:comment "Software is a program or set of instructions that can be executed by a computer."@en ;
	sh:targetClass observable:Software ;
	.

observable:SoftwareFacet
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf core:Facet ;
	rdfs:label "SoftwareFacet"@en ;
	rdfs:comment "A software facet is a grouping of characteristics unique to a program or set of instructions that can be executed by a computer."@en ;
	sh:property
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:swid ;
		] ,
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:version ;
		]
		;
	sh:targetClass observable:SoftwareFacet ;
	.

observable:Application
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:Software ;
	rdfs:label "Application"@en ;
	rdfs:comment "An application is software designed to perform specific tasks for users."@en ;
	sh:targetClass observable:Application ;
	.

observable:ApplicationFacet
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf core:Facet ;
	rdfs:label "ApplicationFacet"@en ;
	rdfs:comment "An application facet is a grouping of characteristics unique to software designed to perform specific tasks for users."@en ;
	sh:property
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:applicationIdentifier ;
		] ,
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:version ;
		] ,
		[
			sh:datatype xsd:integer ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:numberOfLaunches ;
		]
		;
	sh:targetClass observable:ApplicationFacet ;
	.

observable:ApplicationVersion
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:SoftwareExecutionObservable ;
	rdfs:label "ApplicationVersion"@en ;
	rdfs:comment "An application version represents a specific version of an application."@en ;
	sh:targetClass observable:ApplicationVersion ;
	.

observable:ApplicationVersionFacet
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf core:Facet ;
	rdfs:label "ApplicationVersionFacet"@en ;
	rdfs:comment "An application version facet is a grouping of characteristics unique to a specific version of an application."@en ;
	sh:property
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:version ;
		] ,
		[
			sh:datatype xsd:dateTime ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:installDate ;
		] ,
		[
			sh:datatype xsd:dateTime ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:uninstallDate ;
		]
		;
	sh:targetClass observable:ApplicationVersionFacet ;
	.

observable:Library
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:Software ;
	rdfs:label "Library"@en ;
	rdfs:comment "A library is a collection of reusable software components."@en ;
	sh:targetClass observable:Library ;
	.

# Code Classes
observable:Code
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:SoftwareExecutionObservable ;
	rdfs:label "Code"@en ;
	rdfs:comment "Code is a set of instructions written in a programming language."@en ;
	sh:targetClass observable:Code ;
	.

observable:SourceCode
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:Code ;
	rdfs:label "SourceCode"@en ;
	rdfs:comment "Source code is human-readable code written in a programming language."@en ;
	sh:targetClass observable:SourceCode ;
	.

# API Classes
observable:API
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:SoftwareExecutionObservable ;
	rdfs:label "API"@en ;
	rdfs:comment "An API (Application Programming Interface) is a set of rules and protocols for building software applications."@en ;
	sh:targetClass observable:API ;
	.

# Bot Configuration Classes
observable:BotConfiguration
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:SoftwareExecutionObservable ;
	rdfs:label "BotConfiguration"@en ;
	rdfs:comment "A bot configuration is a set of settings and parameters for automated software."@en ;
	sh:targetClass observable:BotConfiguration ;
	.

# Profiling Data Classes
observable:ProfilingData
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:SoftwareExecutionObservable ;
	rdfs:label "ProfilingData"@en ;
	rdfs:comment "Profiling data is information about software execution performance and behavior."@en ;
	sh:targetClass observable:ProfilingData ;
	.

observable:ProfilingDataFacet
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf core:Facet ;
	rdfs:label "ProfilingDataFacet"@en ;
	rdfs:comment "A profiling data facet is a grouping of characteristics unique to information about software execution performance and behavior."@en ;
	sh:property
		[
			sh:datatype xsd:integer ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:programCounter ;
		] ,
		[
			sh:datatype xsd:integer ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:stackPointer ;
		]
		;
	sh:targetClass observable:ProfilingDataFacet ;
	.

# Configured Software Classes
observable:ConfiguredSoftware
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:Software ;
	rdfs:label "ConfiguredSoftware"@en ;
	rdfs:comment "Configured software is software that has been installed and configured on a system."@en ;
	sh:targetClass observable:ConfiguredSoftware ;
	.
