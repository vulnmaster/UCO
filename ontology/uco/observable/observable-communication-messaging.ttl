# imports: https://ontology.unifiedcyberontology.org/uco/action/1.3.0
# imports: https://ontology.unifiedcyberontology.org/uco/configuration/1.3.0
# imports: https://ontology.unifiedcyberontology.org/uco/core/1.3.0
# imports: https://ontology.unifiedcyberontology.org/uco/identity/1.3.0
# imports: https://ontology.unifiedcyberontology.org/uco/location/1.3.0
# imports: https://ontology.unifiedcyberontology.org/uco/observable/observable-core/1.3.0
# imports: https://ontology.unifiedcyberontology.org/uco/types/1.3.0
# imports: https://ontology.unifiedcyberontology.org/uco/vocabulary/1.3.0

@prefix action: <https://ontology.unifiedcyberontology.org/uco/action/> .
@prefix co: <http://purl.org/co/> .
@prefix configuration: <https://ontology.unifiedcyberontology.org/uco/configuration/> .
@prefix core: <https://ontology.unifiedcyberontology.org/uco/core/> .
@prefix identity: <https://ontology.unifiedcyberontology.org/uco/identity/> .
@prefix location: <https://ontology.unifiedcyberontology.org/uco/location/> .
@prefix observable: <https://ontology.unifiedcyberontology.org/uco/observable/> .
@prefix observable-core: <https://ontology.unifiedcyberontology.org/uco/observable/observable-core/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix types: <https://ontology.unifiedcyberontology.org/uco/types/> .
@prefix vocabulary: <https://ontology.unifiedcyberontology.org/uco/vocabulary/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ontology.unifiedcyberontology.org/uco/observable/observable-communication-messaging>
	a owl:Ontology ;
	rdfs:label "uco-observable-communication-messaging"@en ;
    rdfs:comment "This ontology defines classes and properties for characterizing observables from communication and messaging systems. "@en-US ;
	owl:imports
		action:1.3.0 ,
		configuration:1.3.0 ,
		core:1.3.0 ,
		identity:1.3.0 ,
		location:1.3.0 ,
		observable-core:1.3.0 ,
		types:1.3.0 ,
		vocabulary:1.3.0
		;
	owl:versionIRI observable:1.3.0 ;
	.

# Communication & Messaging Observable base class
observable:CommunicationMessagingObservable
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable-core:ObservableObject ;
	rdfs:label "CommunicationMessagingObservable"@en ;
	rdfs:comment "A communication and messaging observable is an observable artifact that represents communication content between parties."@en ;
	sh:targetClass observable:CommunicationMessagingObservable ;
	owl:disjointWith observable:HostObservable ;
	owl:disjointWith observable:NetworkObservable ;
	owl:disjointWith observable:IdentityAccountObservable ;
	owl:disjointWith observable:SoftwareObservable ;
	owl:disjointWith observable:SocialMediaObservable ;
	owl:disjointWith observable:DeviceObservable ;
	owl:disjointWith observable:CloudObservable ;
	owl:disjointWith observable:ICSObservable ;
	owl:disjointWith observable:ContentMediaObservable ;
	.

# Message Classes
observable:Message
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:CommunicationMessagingObservable ;
	rdfs:label "Message"@en ;
	rdfs:comment "A message is a communication between parties."@en ;
	sh:targetClass observable:Message ;
	.

observable:MessageFacet
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf core:Facet ;
	rdfs:label "MessageFacet"@en ;
	rdfs:comment "A message facet is a grouping of characteristics unique to a communication between parties."@en ;
	sh:property
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:application ;
		] ,
		[
			sh:datatype xsd:dateTime ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:sentTime ;
		] ,
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:from ;
		]
		;
	sh:targetClass observable:MessageFacet ;
	.

observable:MessageThread
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:CommunicationMessagingObservable ;
	rdfs:label "MessageThread"@en ;
	rdfs:comment "A message thread is a collection of related messages."@en ;
	sh:targetClass observable:MessageThread ;
	.

observable:MessageThreadFacet
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf core:Facet ;
	rdfs:label "MessageThreadFacet"@en ;
	rdfs:comment "A message thread facet is a grouping of characteristics unique to a collection of related messages."@en ;
	sh:property
		[
			sh:datatype xsd:string ;
			sh:nodeKind sh:Literal ;
			sh:path observable:visibility ;
		] ,
		[
			sh:datatype xsd:string ;
			sh:nodeKind sh:Literal ;
			sh:path observable:participants ;
		]
		;
	sh:targetClass observable:MessageThreadFacet ;
	.

# Email Classes
observable:EmailMessage
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:Message ;
	rdfs:label "EmailMessage"@en ;
	rdfs:comment "An email message is a communication sent via email."@en ;
	sh:targetClass observable:EmailMessage ;
	.

observable:EmailMessageFacet
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf core:Facet ;
	rdfs:label "EmailMessageFacet"@en ;
	rdfs:comment "An email message facet is a grouping of characteristics unique to a communication sent via email."@en ;
	sh:property
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:body ;
		] ,
		[
			sh:datatype xsd:dateTime ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:sentTime ;
		] ,
		[
			sh:datatype xsd:string ;
			sh:nodeKind sh:Literal ;
			sh:path observable:recipients ;
		] ,
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:subject ;
		]
		;
	sh:targetClass observable:EmailMessageFacet ;
	.

# SMS Classes
