			sh:path observable:messageType ;
		]
		;
	sh:targetClass observable:SMSMessageFacet ;
	.

# Instant Messaging Classes
observable:InstantMessaging
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:Message ;
	rdfs:label "InstantMessaging"@en ;
	rdfs:comment "An instant message is a real-time communication between parties."@en ;
	sh:targetClass observable:InstantMessaging ;
	.

observable:InstantMessagingAddress
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:CommunicationMessagingObservable ;
	rdfs:label "InstantMessagingAddress"@en ;
	rdfs:comment "An instant messaging address is an identifier for instant messaging communication."@en ;
	sh:targetClass observable:InstantMessagingAddress ;
	.

# Phone Call Classes
observable:Call
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:CommunicationMessagingObservable ;
	rdfs:label "Call"@en ;
	rdfs:comment "A call is a voice communication between parties."@en ;
	sh:targetClass observable:Call ;
	.

observable:CallFacet
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf core:Facet ;
	rdfs:label "CallFacet"@en ;
	rdfs:comment "A call facet is a grouping of characteristics unique to a voice communication between parties."@en ;
	sh:property
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:callType ;
		] ,
		[
			sh:datatype xsd:integer ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:duration ;
		] ,
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:participant ;
		] ,
		[
			sh:datatype xsd:dateTime ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:startTime ;
		]
		;
	sh:targetClass observable:CallFacet ;
	.

# VoIP Classes
observable:VoIP
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:CommunicationMessagingObservable ;
	rdfs:label "VoIP"@en ;
	rdfs:comment "VoIP (Voice over IP) is a voice communication transmitted over the internet."@en ;
	sh:targetClass observable:VoIP ;
	.

observable:VoIPFacet
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf core:Facet ;
	rdfs:label "VoIPFacet"@en ;
	rdfs:comment "A VoIP facet is a grouping of characteristics unique to a voice communication transmitted over the internet."@en ;
	sh:property
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:application ;
		]
		;
	sh:targetClass observable:VoIPFacet ;
	.

