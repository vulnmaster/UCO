# Contact Classes
observable:Contact
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:CommunicationMessagingObservable ;
	rdfs:label "Contact"@en ;
	rdfs:comment "A contact is information about a person or organization used for communication."@en ;
	sh:targetClass observable:Contact ;
	.

observable:ContactFacet
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf core:Facet ;
	rdfs:label "ContactFacet"@en ;
	rdfs:comment "A contact facet is a grouping of characteristics unique to information about a person or organization used for communication."@en ;
	sh:property
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:contactID ;
		] ,
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:lastName ;
		] ,
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:firstName ;
		]
		;
	sh:targetClass observable:ContactFacet ;
	.

observable:ContactList
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:CommunicationMessagingObservable ;
	rdfs:label "ContactList"@en ;
	rdfs:comment "A contact list is a collection of contacts."@en ;
	sh:targetClass observable:ContactList ;
	.

observable:ContactListFacet
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf core:Facet ;
	rdfs:label "ContactListFacet"@en ;
	rdfs:comment "A contact list facet is a grouping of characteristics unique to a collection of contacts."@en ;
	sh:property
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:contactListName ;
		] ,
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:owner ;
		] ,
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:sourceApplication ;
		]
		;
	sh:targetClass observable:ContactListFacet ;
	.

# Captured Telecommunications Classes
observable:CapturedTelecommunicationsInformation
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf observable:CommunicationMessagingObservable ;
	rdfs:label "CapturedTelecommunicationsInformation"@en ;
	rdfs:comment "Captured telecommunications information is intercepted communication data."@en ;
	sh:targetClass observable:CapturedTelecommunicationsInformation ;
	.

observable:CapturedTelecommunicationsInformationFacet
	a
		owl:Class ,
		sh:NodeShape
		;
	rdfs:subClassOf core:Facet ;
	rdfs:label "CapturedTelecommunicationsInformationFacet"@en ;
	rdfs:comment "A captured telecommunications information facet is a grouping of characteristics unique to intercepted communication data."@en ;
	sh:property
		[
			sh:datatype xsd:string ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:captureCellSite ;
		] ,
		[
			sh:datatype xsd:dateTime ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:startTime ;
		] ,
		[
			sh:datatype xsd:dateTime ;
			sh:maxCount "1"^^xsd:integer ;
			sh:nodeKind sh:Literal ;
			sh:path observable:endTime ;
		]
		;
	sh:targetClass observable:CapturedTelecommunicationsInformationFacet ;
	.
