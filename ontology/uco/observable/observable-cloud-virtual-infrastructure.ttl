# Serverless Computing Classes
observable:ServerlessFunction
    a owl:Class ;
    rdfs:subClassOf observable:CloudService ;
    rdfs:label "Serverless Function"@en-US ;
    rdfs:comment "A serverless function that runs in response to events. Based on AWS Lambda (https://docs.aws.amazon.com/lambda/latest/dg/welcome.html) and Azure Functions (https://docs.microsoft.com/en-us/azure/azure-functions/functions-overview)."@en ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:minCount "1"^^xsd:integer ;
            sh:nodeKind sh:Literal ;
            sh:path observable:functionName ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:minCount "1"^^xsd:integer ;
            sh:nodeKind sh:Literal ;
            sh:path observable:runtime ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:minCount "1"^^xsd:integer ;
            sh:nodeKind sh:Literal ;
            sh:path observable:memorySize ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:minCount "1"^^xsd:integer ;
            sh:nodeKind sh:Literal ;
            sh:path observable:timeout ;
        ] ;
    .

# Properties for ServerlessFunction
observable:functionName
    a owl:DatatypeProperty ;
    rdfs:label "Function Name"@en-US ;
    rdfs:comment "The name of the serverless function."@en ;
    rdfs:domain observable:ServerlessFunction ;
    rdfs:range xsd:string ;
    .

observable:runtime
    a owl:DatatypeProperty ;
    rdfs:label "Runtime"@en-US ;
    rdfs:comment "The runtime environment for the serverless function."@en ;
    rdfs:domain observable:ServerlessFunction ;
    rdfs:range xsd:string ;
    .

observable:memorySize
    a owl:DatatypeProperty ;
    rdfs:label "Memory Size"@en-US ;
    rdfs:comment "The amount of memory allocated to the serverless function in MB."@en ;
    rdfs:domain observable:ServerlessFunction ;
    rdfs:range xsd:integer ;
    .

observable:timeout
    a owl:DatatypeProperty ;
    rdfs:label "Timeout"@en-US ;
    rdfs:comment "The maximum execution time for the serverless function in seconds."@en ;
    rdfs:domain observable:ServerlessFunction ;
    rdfs:range xsd:integer ;
    .

# Add relationship between CloudInstance and CloudRegion
observable:isDeployedInRegion
    a owl:ObjectProperty ;
    rdfs:label "Is Deployed In Region"@en-US ;
    rdfs:comment "Indicates that a cloud resource is deployed in a specific cloud region. Based on AWS Global Infrastructure (https://aws.amazon.com/about-aws/global-infrastructure/) and Azure Global Infrastructure (https://azure.microsoft.com/en-us/global-infrastructure/)."@en ;
    rdfs:domain observable:CloudVirtualInfrastructureObservable ;
    rdfs:range observable:CloudRegion ;
    .

observable:hasDeployedResource
    a owl:ObjectProperty ;
    owl:inverseOf observable:isDeployedInRegion ;
    rdfs:label "Has Deployed Resource"@en-US ;
    rdfs:comment "Indicates that a cloud region contains deployed cloud resources."@en ;
    rdfs:domain observable:CloudRegion ;
    rdfs:range observable:CloudVirtualInfrastructureObservable ;
    .

# Add relationship between CloudInstance and VirtualNetwork
observable:isDeployedInNetwork
    a owl:ObjectProperty ;
    rdfs:label "Is Deployed In Network"@en-US ;
    rdfs:comment "Indicates that a cloud resource is deployed within a virtual network. Based on AWS VPC (https://docs.aws.amazon.com/vpc/latest/userguide/what-is-amazon-vpc.html) and Azure Virtual Network (https://docs.microsoft.com/en-us/azure/virtual-network/virtual-networks-overview)."@en ;
    rdfs:domain observable:CloudVirtualInfrastructureObservable ;
    rdfs:range observable:VirtualNetwork ;
    .

observable:hasDeployedInstance
    a owl:ObjectProperty ;
    owl:inverseOf observable:isDeployedInNetwork ;
    rdfs:label "Has Deployed Instance"@en-US ;
    rdfs:comment "Indicates that a virtual network contains deployed cloud instances."@en ;
    rdfs:domain observable:VirtualNetwork ;
    rdfs:range observable:CloudVirtualInfrastructureObservable ;
    .

# Add relationship between Transaction and Blockchain
observable:isPartOfBlockchain
    a owl:ObjectProperty ;
    rdfs:label "Is Part Of Blockchain"@en-US ;
    rdfs:comment "Indicates that a transaction is part of a blockchain. Based on Bitcoin Core documentation and Ethereum Yellow Paper."@en ;
    rdfs:domain observable:Transaction ;
    rdfs:range observable:Blockchain ;
    .

observable:hasTransaction
    a owl:ObjectProperty ;
    owl:inverseOf observable:isPartOfBlockchain ;
    rdfs:label "Has Transaction"@en-US ;
    rdfs:comment "Indicates that a blockchain contains transactions."@en ;
    rdfs:domain observable:Blockchain ;
    rdfs:range observable:Transaction ;
    .
