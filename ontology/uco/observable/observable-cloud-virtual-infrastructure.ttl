observable:SecurityGroup
    a owl:Class ;
    rdfs:label "Security Group"@en-US ;
    rdfs:comment "A virtual firewall that controls inbound and outbound traffic for cloud resources. Based on NIST SP 800-145 Cloud Computing Security Reference Architecture and IETF Security Standards."@en ;
    rdfs:subClassOf observable:CloudService ;
    owl:disjointWith (
        observable:CloudInstance
        observable:Container
        observable:CloudStorage
        observable:LoadBalancer
    ) ;
    .

observable:IAMRole
    a owl:Class ;
    rdfs:label "IAM Role"@en-US ;
    rdfs:comment "An IAM role that defines a set of permissions for making AWS service requests. Based on NIST SP 800-63 Digital Identity Guidelines and OAuth 2.0 Authorization Framework."@en ;
    rdfs:subClassOf observable:CloudIdentity ;
    owl:disjointWith (
        observable:ServicePrincipal
        observable:ManagedIdentity
    ) ;
    .

observable:IAMPolicy
    a owl:Class ;
    rdfs:label "IAM Policy"@en-US ;
    rdfs:comment "A document that defines permissions for IAM identities."@en ;
    rdfs:subClassOf observable:CloudService ;
    owl:disjointWith (
        observable:CloudInstance
        observable:Container
        observable:CloudStorage
        observable:LoadBalancer
        observable:SecurityGroup
    ) ;
    .

observable:KeyManagementService
    a owl:Class ;
    rdfs:label "Key Management Service"@en-US ;
    rdfs:comment "A service for managing cryptographic keys and secrets."@en ;
    rdfs:subClassOf observable:CloudService ;
    owl:disjointWith (
        observable:CloudInstance
        observable:Container
        observable:CloudStorage
        observable:LoadBalancer
        observable:SecurityGroup
        observable:IAMPolicy
    ) ;
    .

observable:Secret
    a owl:Class ;
    rdfs:label "Secret"@en-US ;
    rdfs:comment "A secret value stored in a key management service."@en ;
    rdfs:subClassOf observable:CloudService ;
    owl:disjointWith (
        observable:CloudInstance
        observable:Container
        observable:CloudStorage
        observable:LoadBalancer
        observable:SecurityGroup
        observable:IAMPolicy
        observable:KeyManagementService
    ) ;
    .

