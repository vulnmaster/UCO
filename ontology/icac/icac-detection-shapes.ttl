@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core#> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/uco/action#> .
@prefix uco-identity: <https://ontology.unifiedcyberontology.org/uco/identity#> .
@prefix uco-tool: <https://ontology.unifiedcyberontology.org/uco/tool#> .
@prefix uco-types: <https://ontology.unifiedcyberontology.org/uco/types#> .
@prefix uco-observable: <https://ontology.unifiedcyberontology.org/uco/observable#> .
@prefix icac: <https://ontology.unifiedcyberontology.org/icac#> .
@prefix icac-detection: <https://ontology.unifiedcyberontology.org/icac/detection#> .

# =============================================================================
# DETECTION TOOL SHAPES
# =============================================================================

icac-detection:ContentHashingToolShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:ContentHashingTool ;
    rdfs:label "Content Hashing Tool Shape"@en ;
    rdfs:comment "Validation shape for content hashing tool instances."@en ;
    sh:property [
        sh:path uco-core:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 2 ;
        sh:maxLength 100 ;
        sh:message "Content hashing tool must have a name (2-100 characters)."@en
    ] ;
    sh:property [
        sh:path uco-tool:version ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" ;
        sh:message "Tool version must follow semantic versioning pattern (e.g., '1.0', '2.1.3')."@en
    ] .

icac-detection:MachineLearningDetectionToolShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:MachineLearningDetectionTool ;
    rdfs:label "Machine Learning Detection Tool Shape"@en ;
    rdfs:comment "Validation shape for machine learning detection tool instances."@en ;
    sh:property [
        sh:path uco-core:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 2 ;
        sh:maxLength 100 ;
        sh:message "ML detection tool must have a name (2-100 characters)."@en
    ] ;
    sh:property [
        sh:path icac-detection:modelVersion ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:maxLength 50 ;
        sh:message "Model version should be 1-50 characters when specified."@en
    ] ;
    sh:property [
        sh:path icac-detection:detectionThreshold ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "Detection threshold must be between 0.0 and 1.0."@en
    ] .

icac-detection:DatabaseMatchingToolShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:DatabaseMatchingTool ;
    rdfs:label "Database Matching Tool Shape"@en ;
    rdfs:comment "Validation shape for database matching tool instances."@en ;
    sh:property [
        sh:path uco-core:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 2 ;
        sh:maxLength 100 ;
        sh:message "Database matching tool must have a name (2-100 characters)."@en
    ] .

icac-detection:ManualReviewToolShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:ManualReviewTool ;
    rdfs:label "Manual Review Tool Shape"@en ;
    rdfs:comment "Validation shape for manual review tool instances."@en ;
    sh:property [
        sh:path uco-core:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 2 ;
        sh:maxLength 100 ;
        sh:message "Manual review tool must have a name (2-100 characters)."@en
    ] .

# =============================================================================
# DETECTION ACTION SHAPES
# =============================================================================

icac-detection:ContentHashingActionShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:ContentHashingAction ;
    rdfs:label "Content Hashing Action Shape"@en ;
    rdfs:comment "Validation shape for content hashing action instances."@en ;
    sh:property [
        sh:path uco-core:startTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Content hashing action must specify start time."@en
    ] ;
    sh:property [
        sh:path uco-action:instrument ;
        sh:class icac-detection:ContentHashingTool ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Content hashing action must specify the hashing tool used."@en
    ] .

icac-detection:AutomatedDetectionActionShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:AutomatedDetectionAction ;
    rdfs:label "Automated Detection Action Shape"@en ;
    rdfs:comment "Validation shape for automated detection action instances."@en ;
    sh:property [
        sh:path uco-core:startTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Automated detection action must specify start time."@en
    ] ;
    sh:property [
        sh:path uco-action:instrument ;
        sh:class icac-detection:MachineLearningDetectionTool ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Automated detection action must specify the ML tool used."@en
    ] ;
    sh:property [
        sh:path icac-detection:confidenceScore ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "Confidence score must be between 0.0 and 1.0."@en
    ] .

icac-detection:ManualClassificationActionShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:ManualClassificationAction ;
    rdfs:label "Manual Classification Action Shape"@en ;
    rdfs:comment "Validation shape for manual classification action instances."@en ;
    sh:property [
        sh:path uco-core:startTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Manual classification action must specify start time."@en
    ] ;
    sh:property [
        sh:path uco-action:performer ;
        sh:class uco-identity:Person ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Manual classification action must specify the person performing the review."@en
    ] ;
    sh:property [
        sh:path icac-detection:reviewDecision ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "confirmed_csam" "not_csam" "requires_further_review" "inconclusive" "false_positive" ) ;
        sh:message "Review decision must be from the allowed list."@en
    ] .

icac-detection:DatabaseMatchActionShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:DatabaseMatchAction ;
    rdfs:label "Database Match Action Shape"@en ;
    rdfs:comment "Validation shape for database match action instances."@en ;
    sh:property [
        sh:path uco-core:startTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Database match action must specify start time."@en
    ] ;
    sh:property [
        sh:path icac-detection:matchType ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "exact_match" "near_match" "no_match" "hash_collision" ) ;
        sh:message "Match type must be from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-detection:similarityScore ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "Similarity score must be between 0.0 and 1.0."@en
    ] .

icac-detection:FalsePositiveAnalysisActionShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:FalsePositiveAnalysisAction ;
    rdfs:label "False Positive Analysis Action Shape"@en ;
    rdfs:comment "Validation shape for false positive analysis action instances."@en ;
    sh:property [
        sh:path uco-core:startTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "False positive analysis action must specify start time."@en
    ] ;
    sh:property [
        sh:path icac-detection:falsePositiveReason ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "adult_content" "artistic_content" "medical_content" "algorithm_error" "hash_collision" "context_misinterpretation" ) ;
        sh:message "False positive reason must be from the allowed list."@en
    ] .

# =============================================================================
# HASH ARTIFACT SHAPES
# =============================================================================

icac-detection:PhotoDNAHashShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:PhotoDNAHash ;
    rdfs:label "PhotoDNA Hash Shape"@en ;
    rdfs:comment "Validation shape for PhotoDNA hash instances."@en ;
    sh:property [
        sh:path icac-detection:photoDNAValue ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9A-Fa-f]+$" ;
        sh:minLength 32 ;
        sh:maxLength 128 ;
        sh:message "PhotoDNA value must be a hexadecimal string (32-128 characters)."@en
    ] .

icac-detection:PerceptualHashShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:PerceptualHash ;
    rdfs:label "Perceptual Hash Shape"@en ;
    rdfs:comment "Validation shape for perceptual hash instances."@en ;
    sh:property [
        sh:path icac-detection:perceptualHashValue ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9A-Fa-f]+$" ;
        sh:minLength 8 ;
        sh:maxLength 128 ;
        sh:message "Perceptual hash value must be a hexadecimal string (8-128 characters)."@en
    ] ;
    sh:property [
        sh:path icac-detection:hashAlgorithm ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "pHash" "aHash" "dHash" "wHash" "colorHash" "blockHash" ) ;
        sh:message "Hash algorithm must be from the allowed list."@en
    ] .

# =============================================================================
# DETECTION RESULT SHAPES
# =============================================================================

icac-detection:DetectionResultShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:DetectionResult ;
    rdfs:label "Detection Result Shape"@en ;
    rdfs:comment "Validation shape for detection result instances."@en ;
    sh:property [
        sh:path icac-detection:confidenceScore ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "Detection result must have a confidence score between 0.0 and 1.0."@en
    ] ;
    sh:property [
        sh:path uco-core:createdTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Detection result must specify creation time."@en
    ] .

icac-detection:ClassificationResultShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:ClassificationResult ;
    rdfs:label "Classification Result Shape"@en ;
    rdfs:comment "Validation shape for classification result instances."@en ;
    sh:property [
        sh:path uco-core:createdTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Classification result must specify creation time."@en
    ] ;
    sh:property [
        sh:path icac-detection:ageEstimate ;
        sh:datatype xsd:integer ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minInclusive 0 ;
        sh:maxInclusive 25 ;
        sh:message "Age estimate must be between 0 and 25 years when specified."@en
    ] ;
    sh:property [
        sh:path icac-detection:tannerStage ;
        sh:datatype xsd:integer ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minInclusive 1 ;
        sh:maxInclusive 5 ;
        sh:message "Tanner stage must be between 1 and 5 when specified."@en
    ] .

# =============================================================================
# CLASSIFICATION SCHEME SHAPES
# =============================================================================

icac-detection:SARClassificationShape rdf:type sh:NodeShape ;
    sh:targetNode icac-detection:sar-1 ,
                  icac-detection:sar-2 ,
                  icac-detection:sar-3 ,
                  icac-detection:sar-4 ,
                  icac-detection:sar-5 ;
    rdfs:label "SAR Classification Shape"@en ;
    rdfs:comment "Validation shape for SAR classification concept instances."@en ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 5 ;
        sh:maxLength 100 ;
        sh:message "SAR classification must have a preferred label (5-100 characters)."@en
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 10 ;
        sh:maxLength 500 ;
        sh:message "SAR classification must have a definition (10-500 characters)."@en
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue icac-detection:SARClassificationScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "SAR classification must be in the SAR Classification Scheme."@en
    ] .

icac-detection:COPINEClassificationShape rdf:type sh:NodeShape ;
    sh:targetNode icac-detection:copine-1 ,
                  icac-detection:copine-4 ,
                  icac-detection:copine-7 ,
                  icac-detection:copine-8 ,
                  icac-detection:copine-10 ;
    rdfs:label "COPINE Classification Shape"@en ;
    rdfs:comment "Validation shape for COPINE classification concept instances."@en ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 5 ;
        sh:maxLength 100 ;
        sh:message "COPINE classification must have a preferred label (5-100 characters)."@en
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 10 ;
        sh:maxLength 500 ;
        sh:message "COPINE classification must have a definition (10-500 characters)."@en
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue icac-detection:COPINEClassificationScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "COPINE classification must be in the COPINE Classification Scheme."@en
    ] .

# =============================================================================
# CROSS-REFERENCE VALIDATION SHAPES
# =============================================================================

icac-detection:HashingActionCrossReferenceShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:ContentHashingAction ;
    rdfs:label "Hashing Action Cross Reference Shape"@en ;
    rdfs:comment "Validates that hashing actions produce hash results."@en ;
    sh:sparql [
        sh:message "Content hashing action should produce hash results."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this a icac-detection:ContentHashingAction .
                FILTER NOT EXISTS {
                    $this uco-action:result ?hash .
                    ?hash a ?hashType .
                    FILTER (?hashType IN (
                        icac-detection:PhotoDNAHash,
                        icac-detection:PerceptualHash,
                        uco-types:Hash
                    ))
                }
            }
        """
    ] .

icac-detection:DetectionActionCrossReferenceShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:AutomatedDetectionAction ;
    rdfs:label "Detection Action Cross Reference Shape"@en ;
    rdfs:comment "Validates that detection actions produce detection results."@en ;
    sh:sparql [
        sh:message "Automated detection action should produce detection results."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this a icac-detection:AutomatedDetectionAction .
                FILTER NOT EXISTS {
                    $this uco-action:result ?result .
                    ?result a icac-detection:DetectionResult .
                }
            }
        """
    ] .

icac-detection:ClassificationActionCrossReferenceShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:ManualClassificationAction ;
    rdfs:label "Classification Action Cross Reference Shape"@en ;
    rdfs:comment "Validates that classification actions produce classification results."@en ;
    sh:sparql [
        sh:message "Manual classification action should produce classification results."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this a icac-detection:ManualClassificationAction .
                FILTER NOT EXISTS {
                    $this uco-action:result ?result .
                    ?result a icac-detection:ClassificationResult .
                }
            }
        """
    ] .

icac-detection:DatabaseMatchCrossReferenceShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:DatabaseMatchAction ;
    rdfs:label "Database Match Cross Reference Shape"@en ;
    rdfs:comment "Validates that database match actions have associated hash inputs."@en ;
    sh:sparql [
        sh:message "Database match action should have hash inputs for comparison."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this a icac-detection:DatabaseMatchAction .
                FILTER NOT EXISTS {
                    $this uco-action:object ?hash .
                    ?hash a ?hashType .
                    FILTER (?hashType IN (
                        icac-detection:PhotoDNAHash,
                        icac-detection:PerceptualHash,
                        uco-types:Hash
                    ))
                }
            }
        """
    ] .

# =============================================================================
# TEMPORAL VALIDATION SHAPES
# =============================================================================

icac-detection:TemporalValidationShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:ContentHashingAction ,
                   icac-detection:AutomatedDetectionAction ,
                   icac-detection:ManualClassificationAction ,
                   icac-detection:DatabaseMatchAction ,
                   icac-detection:FalsePositiveAnalysisAction ;
    rdfs:label "Temporal Validation Shape"@en ;
    rdfs:comment "Validates temporal consistency for detection actions."@en ;
    sh:sparql [
        sh:message "Start time must be before end time when both are specified."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this uco-core:startTime ?start ;
                      uco-core:endTime ?end .
                FILTER (?start >= ?end)
            }
        """
    ] .

icac-detection:DetectionSequenceValidationShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:ManualClassificationAction ;
    rdfs:label "Detection Sequence Validation Shape"@en ;
    rdfs:comment "Validates that manual classification follows automated detection."@en ;
    sh:sparql [
        sh:message "Manual classification should typically follow automated detection."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this a icac-detection:ManualClassificationAction ;
                      uco-core:startTime ?manualTime .
                ?autoDetection a icac-detection:AutomatedDetectionAction ;
                               uco-core:startTime ?autoTime ;
                               uco-action:object ?content .
                $this uco-action:object ?content .
                FILTER (?manualTime < ?autoTime)
            }
        """
    ] .

# =============================================================================
# DATA QUALITY SHAPES
# =============================================================================

icac-detection:DataQualityShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:ContentHashingTool ,
                   icac-detection:MachineLearningDetectionTool ,
                   icac-detection:DatabaseMatchingTool ,
                   icac-detection:ManualReviewTool ;
    rdfs:label "Data Quality Shape"@en ;
    rdfs:comment "Validates data quality for detection tool entities."@en ;
    sh:property [
        sh:path uco-core:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 2 ;
        sh:maxLength 100 ;
        sh:message "Tool name must be between 2 and 100 characters."@en
    ] ;
    sh:property [
        sh:path uco-core:description ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minLength 10 ;
        sh:maxLength 1000 ;
        sh:message "Tool description should be between 10 and 1000 characters when provided."@en
    ] .

icac-detection:ConfidenceScoreValidationShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:AutomatedDetectionAction ,
                   icac-detection:DetectionResult ;
    rdfs:label "Confidence Score Validation Shape"@en ;
    rdfs:comment "Validates confidence score consistency and reasonableness."@en ;
    sh:sparql [
        sh:message "High confidence scores should correlate with positive detection decisions."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this icac-detection:confidenceScore ?score ;
                      icac-detection:reviewDecision "false_positive" .
                FILTER (?score > 0.8)
            }
        """
    ] .

icac-detection:HashValidationShape rdf:type sh:NodeShape ;
    sh:targetClass icac-detection:PhotoDNAHash ,
                   icac-detection:PerceptualHash ;
    rdfs:label "Hash Validation Shape"@en ;
    rdfs:comment "Validates hash format and consistency."@en ;
    sh:property [
        sh:path uco-core:createdTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:message "Hash creation time should be specified when available."@en
    ] . 