@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core#> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/uco/action#> .
@prefix uco-identity: <https://ontology.unifiedcyberontology.org/uco/identity#> .
@prefix uco-role: <https://ontology.unifiedcyberontology.org/uco/role#> .

@prefix icac: <https://ontology.unifiedcyberontology.org/icac#> .
@prefix icac-training: <https://ontology.unifiedcyberontology.org/icac/training#> .

<https://ontology.unifiedcyberontology.org/icac/training> rdf:type owl:Ontology ;
    rdfs:label "ICAC Training and Capacity Building Ontology"@en ;
    rdfs:comment "An ontology for modeling professional development, training programs, and capacity building initiatives for child protection professionals, based on ICMEC's training of 155,000+ professionals globally."@en ;
    owl:versionInfo "0.1.0" .

# =============================================================================
# TRAINING INFRASTRUCTURE
# =============================================================================

icac-training:InternationalTraining rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "International Training"@en ;
    rdfs:comment "Training program conducted across multiple countries."@en .

icac-training:CapacityBuildingProgram rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Capacity Building Program"@en ;
    rdfs:comment "Structured program for building organizational and individual capacity."@en .

icac-training:ProfessionalCertification rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Professional Certification"@en ;
    rdfs:comment "Formal certification for child protection professionals."@en .

icac-training:TrainingModule rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Training Module"@en ;
    rdfs:comment "Individual training module covering specific topics."@en .

icac-training:SkillsDevelopmentProgram rdf:type owl:Class ;
    rdfs:subClassOf icac-training:CapacityBuildingProgram ;
    rdfs:label "Skills Development Program"@en ;
    rdfs:comment "Program focused on developing specific professional skills."@en .

icac-training:TrainingCurriculum rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Training Curriculum"@en ;
    rdfs:comment "Structured curriculum for child protection training."@en .

# =============================================================================
# TRAINING DELIVERY METHODS
# =============================================================================

icac-training:OnlineTraining rdf:type owl:Class ;
    rdfs:subClassOf icac-training:InternationalTraining ;
    rdfs:label "Online Training"@en ;
    rdfs:comment "Training delivered through online platforms."@en .

icac-training:InPersonTraining rdf:type owl:Class ;
    rdfs:subClassOf icac-training:InternationalTraining ;
    rdfs:label "In-Person Training"@en ;
    rdfs:comment "Training delivered in physical classroom settings."@en .

icac-training:HybridTraining rdf:type owl:Class ;
    rdfs:subClassOf icac-training:InternationalTraining ;
    rdfs:label "Hybrid Training"@en ;
    rdfs:comment "Training combining online and in-person delivery."@en .

icac-training:MentorshipProgram rdf:type owl:Class ;
    rdfs:subClassOf icac-training:CapacityBuildingProgram ;
    rdfs:label "Mentorship Program"@en ;
    rdfs:comment "One-on-one mentorship for professional development."@en .

# =============================================================================
# SPECIALIZED TRAINING TYPES
# =============================================================================

icac-training:CriminalJusticeTraining rdf:type owl:Class ;
    rdfs:subClassOf icac-training:InternationalTraining ;
    rdfs:label "Criminal Justice Training"@en ;
    rdfs:comment "Training for criminal justice professionals on child protection."@en .

icac-training:ChildProtectionTraining rdf:type owl:Class ;
    rdfs:subClassOf icac-training:InternationalTraining ;
    rdfs:label "Child Protection Training"@en ;
    rdfs:comment "Training focused on child protection methodologies."@en .

icac-training:DigitalForensicsTraining rdf:type owl:Class ;
    rdfs:subClassOf icac-training:InternationalTraining ;
    rdfs:label "Digital Forensics Training"@en ;
    rdfs:comment "Training on digital forensics techniques for child protection cases."@en .

icac-training:InvestigationTraining rdf:type owl:Class ;
    rdfs:subClassOf icac-training:InternationalTraining ;
    rdfs:label "Investigation Training"@en ;
    rdfs:comment "Training on investigation methodologies and techniques."@en .

icac-training:LegalTraining rdf:type owl:Class ;
    rdfs:subClassOf icac-training:InternationalTraining ;
    rdfs:label "Legal Training"@en ;
    rdfs:comment "Training on legal aspects of child protection."@en .

icac-training:VictimServiceTraining rdf:type owl:Class ;
    rdfs:subClassOf icac-training:InternationalTraining ;
    rdfs:label "Victim Service Training"@en ;
    rdfs:comment "Training for professionals providing victim services."@en .

icac-training:HotlineTraining rdf:type owl:Class ;
    rdfs:subClassOf icac-training:InternationalTraining ;
    rdfs:label "Hotline Training"@en ;
    rdfs:comment "Training for hotline operators and managers."@en .

# =============================================================================
# TRAINING OUTCOMES AND ASSESSMENT
# =============================================================================

icac-training:TrainingCertificate rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Training Certificate"@en ;
    rdfs:comment "Certificate awarded upon successful completion of training."@en .

icac-training:CompetencyAssessment rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Competency Assessment"@en ;
    rdfs:comment "Assessment of professional competencies acquired through training."@en .

icac-training:SkillsValidation rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Skills Validation"@en ;
    rdfs:comment "Validation of skills acquired through training programs."@en .

icac-training:ContinuingEducation rdf:type owl:Class ;
    rdfs:subClassOf icac-training:CapacityBuildingProgram ;
    rdfs:label "Continuing Education"@en ;
    rdfs:comment "Ongoing education for certified professionals."@en .

icac-training:ProfessionalDevelopment rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Professional Development"@en ;
    rdfs:comment "Career development for child protection professionals."@en .

# =============================================================================
# TRAINING ROLES
# =============================================================================

icac-training:InternationalTrainer rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "International Trainer"@en ;
    rdfs:comment "Trainer delivering international training programs."@en .

icac-training:TrainingCoordinator rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "Training Coordinator"@en ;
    rdfs:comment "Coordinator responsible for organizing training programs."@en .

icac-training:SubjectMatterExpert rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "Subject Matter Expert"@en ;
    rdfs:comment "Expert providing specialized knowledge in training."@en .

icac-training:TrainingParticipant rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "Training Participant"@en ;
    rdfs:comment "Professional participating in training programs."@en .

icac-training:CertifiedProfessional rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "Certified Professional"@en ;
    rdfs:comment "Professional who has achieved certification."@en .

# =============================================================================
# TRAINING INSTITUTIONS AND ORGANIZATIONS
# =============================================================================

icac-training:TrainingInstitution rdf:type owl:Class ;
    rdfs:subClassOf uco-identity:Organization ;
    rdfs:label "Training Institution"@en ;
    rdfs:comment "Institution providing child protection training."@en .

icac-training:CapacityBuildingPartner rdf:type owl:Class ;
    rdfs:subClassOf uco-identity:Organization ;
    rdfs:label "Capacity Building Partner"@en ;
    rdfs:comment "Partner organization supporting capacity building efforts."@en .

icac-training:CertificationBody rdf:type owl:Class ;
    rdfs:subClassOf uco-identity:Organization ;
    rdfs:label "Certification Body"@en ;
    rdfs:comment "Organization responsible for professional certification."@en .

# =============================================================================
# TRAINING METRICS AND ANALYTICS
# =============================================================================

icac-training:TrainingMetrics rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Training Metrics"@en ;
    rdfs:comment "Metrics measuring training effectiveness and reach."@en .

icac-training:GlobalTrainingReach rdf:type owl:Class ;
    rdfs:subClassOf icac-training:TrainingMetrics ;
    rdfs:label "Global Training Reach"@en ;
    rdfs:comment "Measurement of global training program reach."@en .

icac-training:TrainingEffectiveness rdf:type owl:Class ;
    rdfs:subClassOf icac-training:TrainingMetrics ;
    rdfs:label "Training Effectiveness"@en ;
    rdfs:comment "Assessment of training program effectiveness."@en .

icac-training:CapacityImpact rdf:type owl:Class ;
    rdfs:subClassOf icac-training:TrainingMetrics ;
    rdfs:label "Capacity Impact"@en ;
    rdfs:comment "Impact measurement of capacity building initiatives."@en .

# Enhanced Community Engagement Metrics (Idaho Case Analysis)
icac-training:CommunityEngagementMetrics rdf:type owl:Class ;
    rdfs:subClassOf icac-training:TrainingMetrics ;
    rdfs:label "Community Engagement Metrics"@en ;
    rdfs:comment "Detailed metrics for community outreach and engagement programs."@en .

icac-training:OutreachEventMetrics rdf:type owl:Class ;
    rdfs:subClassOf icac-training:CommunityEngagementMetrics ;
    rdfs:label "Outreach Event Metrics"@en ;
    rdfs:comment "Metrics tracking community outreach events and their effectiveness."@en .

icac-training:ProfessionalTrainingMetrics rdf:type owl:Class ;
    rdfs:subClassOf icac-training:TrainingMetrics ;
    rdfs:label "Professional Training Metrics"@en ;
    rdfs:comment "Specialized metrics for professional training programs."@en .

icac-training:K9ProgramMetrics rdf:type owl:Class ;
    rdfs:subClassOf icac-training:TrainingMetrics ;
    rdfs:label "K9 Program Metrics"@en ;
    rdfs:comment "Metrics specific to K9 program training and deployment."@en .

icac-training:OperationalTrainingMetrics rdf:type owl:Class ;
    rdfs:subClassOf icac-training:TrainingMetrics ;
    rdfs:label "Operational Training Metrics"@en ;
    rdfs:comment "Metrics tracking operational training effectiveness in real deployments."@en .

# =============================================================================
# PROPERTIES FOR TRAINING DATA
# =============================================================================

icac-training:professionalsTrained rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:GlobalTrainingReach ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "professionals trained"@en ;
    rdfs:comment "Total number of professionals trained."@en .

icac-training:trainingReachCount rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:InternationalTraining ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "training reach count"@en ;
    rdfs:comment "Number of participants reached by training program."@en .

icac-training:capacityLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:CapacityBuildingProgram ;
    rdfs:range xsd:string ;
    rdfs:label "capacity level"@en ;
    rdfs:comment "Level of capacity being built (basic, intermediate, advanced, expert)."@en .

icac-training:competencyLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:CompetencyAssessment ;
    rdfs:range xsd:string ;
    rdfs:label "competency level"@en ;
    rdfs:comment "Level of competency achieved (novice, competent, proficient, expert)."@en .

icac-training:trainingEffectiveness rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:TrainingEffectiveness ;
    rdfs:range xsd:decimal ;
    rdfs:label "training effectiveness"@en ;
    rdfs:comment "Effectiveness score of training program (0.0-1.0)."@en .

icac-training:certificationStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:ProfessionalCertification ;
    rdfs:range xsd:string ;
    rdfs:label "certification status"@en ;
    rdfs:comment "Status of professional certification (active, expired, suspended)."@en .

icac-training:trainingDuration rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:InternationalTraining ;
    rdfs:range xsd:decimal ;
    rdfs:label "training duration"@en ;
    rdfs:comment "Duration of training program in hours."@en .

icac-training:participationRate rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:InternationalTraining ;
    rdfs:range xsd:decimal ;
    rdfs:label "participation rate"@en ;
    rdfs:comment "Rate of participation in training program (0.0-1.0)."@en .

icac-training:completionRate rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:InternationalTraining ;
    rdfs:range xsd:decimal ;
    rdfs:label "completion rate"@en ;
    rdfs:comment "Rate of completion for training program (0.0-1.0)."@en .

icac-training:certificationValidityPeriod rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:ProfessionalCertification ;
    rdfs:range xsd:decimal ;
    rdfs:label "certification validity period"@en ;
    rdfs:comment "Validity period of certification in months."@en .

icac-training:skillsAcquired rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:SkillsValidation ;
    rdfs:range xsd:string ;
    rdfs:label "skills acquired"@en ;
    rdfs:comment "Description of skills acquired through training."@en .

icac-training:trainingLanguage rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:InternationalTraining ;
    rdfs:range xsd:string ;
    rdfs:label "training language"@en ;
    rdfs:comment "Language in which training is delivered."@en .

# Enhanced Metrics Properties (Idaho Case Analysis)
icac-training:outreachEventsCount rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:OutreachEventMetrics ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "outreach events count"@en ;
    rdfs:comment "Number of community outreach events conducted."@en .

icac-training:totalAttendeesReached rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:OutreachEventMetrics ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "total attendees reached"@en ;
    rdfs:comment "Total number of community members reached through outreach events."@en .

icac-training:professionalsTrainedCount rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:ProfessionalTrainingMetrics ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "professionals trained count"@en ;
    rdfs:comment "Number of professionals trained in specialized programs."@en .

icac-training:k9SearchWarrantsAssisted rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:K9ProgramMetrics ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "K9 search warrants assisted"@en ;
    rdfs:comment "Number of search warrants where K9 units provided assistance."@en .

icac-training:k9PublicPresentations rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:K9ProgramMetrics ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "K9 public presentations"@en ;
    rdfs:comment "Number of public presentations featuring K9 units."@en .

icac-training:operationalDeploymentCount rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:OperationalTrainingMetrics ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "operational deployment count"@en ;
    rdfs:comment "Number of times training was applied in operational deployments."@en .

icac-training:trainingToOperationEffectiveness rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-training:OperationalTrainingMetrics ;
    rdfs:range xsd:decimal ;
    rdfs:label "training to operation effectiveness"@en ;
    rdfs:comment "Effectiveness ratio of training application in operations (0.0-1.0)."@en .

# =============================================================================
# OBJECT PROPERTIES FOR TRAINING RELATIONSHIPS
# =============================================================================

icac-training:deliveredBy rdf:type owl:ObjectProperty ;
    rdfs:domain icac-training:InternationalTraining ;
    rdfs:range icac-training:InternationalTrainer ;
    rdfs:label "delivered by"@en ;
    rdfs:comment "Trainer delivering the training program."@en .

icac-training:participatedIn rdf:type owl:ObjectProperty ;
    rdfs:domain uco-identity:Person ;
    rdfs:range icac-training:InternationalTraining ;
    rdfs:label "participated in"@en ;
    rdfs:comment "Training program participated in by a person."@en .

icac-training:certifiedBy rdf:type owl:ObjectProperty ;
    rdfs:domain icac-training:ProfessionalCertification ;
    rdfs:range icac-training:CertificationBody ;
    rdfs:label "certified by"@en ;
    rdfs:comment "Organization providing the certification."@en .

icac-training:includedInCurriculum rdf:type owl:ObjectProperty ;
    rdfs:domain icac-training:TrainingModule ;
    rdfs:range icac-training:TrainingCurriculum ;
    rdfs:label "included in curriculum"@en ;
    rdfs:comment "Training module included in curriculum."@en .

icac-training:assessedBy rdf:type owl:ObjectProperty ;
    rdfs:domain icac-training:TrainingParticipant ;
    rdfs:range icac-training:CompetencyAssessment ;
    rdfs:label "assessed by"@en ;
    rdfs:comment "Assessment conducted for training participant."@en .

icac-training:buildsCapacityFor rdf:type owl:ObjectProperty ;
    rdfs:domain icac-training:CapacityBuildingProgram ;
    rdfs:range uco-identity:Organization ;
    rdfs:label "builds capacity for"@en ;
    rdfs:comment "Organization for which capacity is being built."@en .

icac-training:supportedBy rdf:type owl:ObjectProperty ;
    rdfs:domain icac-training:InternationalTraining ;
    rdfs:range icac-training:CapacityBuildingPartner ;
    rdfs:label "supported by"@en ;
    rdfs:comment "Partner supporting the training program."@en .

icac-training:mentors rdf:type owl:ObjectProperty ;
    rdfs:domain icac-training:InternationalTrainer ;
    rdfs:range icac-training:TrainingParticipant ;
    rdfs:label "mentors"@en ;
    rdfs:comment "Participant being mentored by trainer."@en .

icac-training:validatesSkills rdf:type owl:ObjectProperty ;
    rdfs:domain icac-training:SkillsValidation ;
    rdfs:range icac-training:TrainingParticipant ;
    rdfs:label "validates skills"@en ;
    rdfs:comment "Participant whose skills are being validated."@en .

icac-training:improvesProficiency rdf:type owl:ObjectProperty ;
    rdfs:domain icac-training:InternationalTraining ;
    rdfs:range uco-core:UcoObject ;
    rdfs:label "improves proficiency"@en ;
    rdfs:comment "Area of proficiency improved by training."@en . 