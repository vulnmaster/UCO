# Query: Q1 find_automated_reports
# Purpose: Operations dashboard - reports from automated systems (ESP crawlers, etc.)
# Parameters: ?from (dateTime), ?to (dateTime), ?limit (integer)
# Security: TLP-RED content excluded by default

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX hotline: <https://ontology.unifiedcyberontology.org/hotlines/2025/core#>
PREFIX uco-core: <https://ontology.unifiedcyberontology.org/core#>
PREFIX uco-observable: <https://ontology.unifiedcyberontology.org/observable#>
PREFIX uco-confidentiality: <https://ontology.unifiedcyberontology.org/confidentiality#>

SELECT DISTINCT ?report ?reporter ?softwareVersion ?vendorName 
       ?intakeTime ?intakeChannel ?evidenceCount
WHERE {
    # Parameter defaults
    VALUES (?from ?to ?limit) {
        ("2025-01-01T00:00:00Z"^^xsd:dateTime "2025-12-31T23:59:59Z"^^xsd:dateTime 100)
    }
    
    # Core report data
    ?report a hotline:ESPReport ;
            hotline:createdTime ?createdTime ;
            hotline:reportedBy ?reporter ;
            hotline:hasEvidence ?evidence .
    
    # Reporter details
    ?reporter a hotline:AutomatedReporterAgent ;
              hotline:softwareVersion ?softwareVersion ;
              hotline:vendorName ?vendorName .
    
    # Optional intake channel
    OPTIONAL {
        ?report hotline:intakeChannel ?intakeChannel .
    }
    
    # Evidence count subquery
    {
        SELECT ?report (COUNT(?evidence) as ?evidenceCount)
        WHERE {
            ?report hotline:hasEvidence ?evidence .
        }
        GROUP BY ?report
    }
    
    # Human-friendly timestamp
    BIND(STRDT(STR(?createdTime), "xsd:dateTime") AS ?intakeTime)
    
    # Status filter
    VALUES ?status { hotline:status-new hotline:status-in-progress hotline:status-in-review }
    ?report hotline:status ?status .
    
    # Date range filter
    FILTER(?createdTime >= ?from && ?createdTime <= ?to)
    
    # Security filter
    FILTER NOT EXISTS {
        ?report uco-confidentiality:TLP-RED ?whatever .
    }
}
ORDER BY DESC(?createdTime)
LIMIT ?limit 