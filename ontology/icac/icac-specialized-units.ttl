@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core#> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/uco/action#> .
@prefix uco-identity: <https://ontology.unifiedcyberontology.org/uco/identity#> .
@prefix uco-role: <https://ontology.unifiedcyberontology.org/uco/role#> .

@prefix icac: <https://ontology.unifiedcyberontology.org/icac#> .
@prefix icac-specialized: <https://ontology.unifiedcyberontology.org/icac/specialized-units#> .

<https://ontology.unifiedcyberontology.org/icac/specialized-units> rdf:type owl:Ontology ;
    rdfs:label "ICAC Specialized Units Ontology"@en ;
    rdfs:comment "An ontology for modeling specialized units including K9 detection programs, officer wellness support, advanced investigative capabilities, seasonal operations, and affiliate management in ICAC operations."@en ;
    owl:versionInfo "0.1.0" .

# =============================================================================
# K9 DETECTION PROGRAMS
# =============================================================================

icac-specialized:K9DetectionProgram rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "K9 Detection Program"@en ;
    rdfs:comment "Program utilizing trained detection dogs for ICAC investigations."@en .

icac-specialized:ElectronicStorageDeviceK9 rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:K9DetectionProgram ;
    rdfs:label "Electronic Storage Device K9"@en ;
    rdfs:comment "K9 trained to detect electronic storage devices during search operations."@en .

icac-specialized:K9Officer rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "K9 Officer"@en ;
    rdfs:comment "Law enforcement officer handling and working with detection dogs."@en .

icac-specialized:DetectionDog rdf:type owl:Class ;
    rdfs:subClassOf uco-identity:Identity ;
    rdfs:label "Detection Dog"@en ;
    rdfs:comment "Trained dog used for detection operations in ICAC investigations."@en .

icac-specialized:K9SearchOperation rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "K9 Search Operation"@en ;
    rdfs:comment "Search operation utilizing K9 detection capabilities."@en .

icac-specialized:DeviceDetection rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Device Detection"@en ;
    rdfs:comment "Detection of electronic storage devices during search operations."@en .

icac-specialized:K9TrainingProgram rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "K9 Training Program"@en ;
    rdfs:comment "Training program for K9 units and handlers."@en .

icac-specialized:CommunityEngagementK9 rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:K9DetectionProgram ;
    rdfs:label "Community Engagement K9"@en ;
    rdfs:comment "K9 utilized for community outreach and educational programs."@en .

# =============================================================================
# OFFICER WELLNESS AND SUPPORT
# =============================================================================

icac-specialized:OfficerWellnessProgram rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Officer Wellness Program"@en ;
    rdfs:comment "Program providing mental health and wellness support to ICAC officers."@en .

icac-specialized:MentalHealthSupport rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:OfficerWellnessProgram ;
    rdfs:label "Mental Health Support"@en ;
    rdfs:comment "Mental health services and support for officers dealing with traumatic content."@en .

icac-specialized:TherapyDog rdf:type owl:Class ;
    rdfs:subClassOf uco-identity:Identity ;
    rdfs:label "Therapy Dog"@en ;
    rdfs:comment "Trained therapy dog providing emotional support to officers."@en .

icac-specialized:StressManagement rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:OfficerWellnessProgram ;
    rdfs:label "Stress Management"@en ;
    rdfs:comment "Programs and techniques for managing work-related stress."@en .

icac-specialized:PeerSupport rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:OfficerWellnessProgram ;
    rdfs:label "Peer Support"@en ;
    rdfs:comment "Peer-to-peer support programs for ICAC personnel."@en .

icac-specialized:CriticalIncidentDebriefing rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Critical Incident Debriefing"@en ;
    rdfs:comment "Structured debriefing process following traumatic incidents."@en .

icac-specialized:WellnessCheck rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Wellness Check"@en ;
    rdfs:comment "Regular check on officer mental health and wellbeing."@en .

# =============================================================================
# SPECIALIZED INVESTIGATIVE UNITS
# =============================================================================

icac-specialized:SpecializedInvestigativeUnit rdf:type owl:Class ;
    rdfs:subClassOf uco-identity:Organization ;
    rdfs:label "Specialized Investigative Unit"@en ;
    rdfs:comment "Specialized unit with unique capabilities for ICAC investigations."@en .

icac-specialized:CyberCrimeUnit rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:SpecializedInvestigativeUnit ;
    rdfs:label "Cyber Crime Unit"@en ;
    rdfs:comment "Unit specialized in cyber crime investigations."@en .

icac-specialized:DigitalForensicsUnit rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:SpecializedInvestigativeUnit ;
    rdfs:label "Digital Forensics Unit"@en ;
    rdfs:comment "Unit specialized in digital forensics analysis."@en .

icac-specialized:UndercoverUnit rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:SpecializedInvestigativeUnit ;
    rdfs:label "Undercover Unit"@en ;
    rdfs:comment "Unit conducting undercover operations."@en .

icac-specialized:TacticalUnit rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:SpecializedInvestigativeUnit ;
    rdfs:label "Tactical Unit"@en ;
    rdfs:comment "Unit handling high-risk tactical operations."@en .

icac-specialized:VictimServicesUnit rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:SpecializedInvestigativeUnit ;
    rdfs:label "Victim Services Unit"@en ;
    rdfs:comment "Unit providing specialized victim services and support."@en .

# =============================================================================
# ENHANCED OPERATION COORDINATION
# =============================================================================

icac-specialized:NamedOperation rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Named Operation"@en ;
    rdfs:comment "Formally named multi-phase operation with specific objectives."@en .

icac-specialized:OperationUnhinged rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:NamedOperation ;
    rdfs:label "Operation Unhinged"@en ;
    rdfs:comment "Specific operation conducted by Idaho ICAC resulting in 12 arrests."@en .

icac-specialized:OperationSafeOnlineSummer rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:NamedOperation ;
    rdfs:label "Operation Safe Online Summer"@en ;
    rdfs:comment "National operation across 61 ICAC Task Forces during summer months."@en .

icac-specialized:MultiJurisdictionalOperation rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:NamedOperation ;
    rdfs:label "Multi-Jurisdictional Operation"@en ;
    rdfs:comment "Operation involving multiple jurisdictions and agencies."@en .

icac-specialized:CoordinatedArrest rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Coordinated Arrest"@en ;
    rdfs:comment "Arrest coordinated as part of larger operation."@en .

icac-specialized:OperationMetrics rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Operation Metrics"@en ;
    rdfs:comment "Metrics tracking operation effectiveness and outcomes."@en .

# =============================================================================
# COMMUNITY ENGAGEMENT AND OUTREACH
# =============================================================================

icac-specialized:CommunityOutreachProgram rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Community Outreach Program"@en ;
    rdfs:comment "Program for engaging with community members on child safety."@en .

icac-specialized:PublicPresentation rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Public Presentation"@en ;
    rdfs:comment "Educational presentation to community groups."@en .

icac-specialized:SafetyEducationEvent rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Safety Education Event"@en ;
    rdfs:comment "Event focused on educating public about online safety."@en .

icac-specialized:ProfessionalTrainingEvent rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Professional Training Event"@en ;
    rdfs:comment "Training event for professionals in child protection field."@en .

icac-specialized:CommunityPartnership rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Community Partnership"@en ;
    rdfs:comment "Partnership with community organizations for child protection."@en .

# =============================================================================
# SEASONAL OPERATIONS FRAMEWORK (Arkansas Case Analysis)
# =============================================================================

icac-specialized:SeasonalOperationsUnit rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:SpecializedInvestigativeUnit ;
    rdfs:label "Seasonal Operations Unit"@en ;
    rdfs:comment "Specialized unit for coordinating operations based on seasonal cyber tip patterns."@en .

icac-specialized:SpringBreakOperation rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Spring Break Operation"@en ;
    rdfs:comment "Operation timed to coincide with spring break periods when online activity increases."@en .

icac-specialized:SchoolYearEndOperation rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "School Year End Operation"@en ;
    rdfs:comment "Operation timed for end of school year when children have increased online presence."@en .

icac-specialized:SeasonalCyberTipPattern rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Seasonal Cyber Tip Pattern"@en ;
    rdfs:comment "Pattern of cyber tips that correlates with seasonal activities and school schedules."@en .

icac-specialized:HighwayCheckpointOperation rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Highway Checkpoint Operation"@en ;
    rdfs:comment "Operation using highway checkpoints for sex offender compliance and public education."@en .

icac-specialized:TimingCoordinator rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "Timing Coordinator"@en ;
    rdfs:comment "Specialist responsible for optimizing operation timing based on seasonal patterns."@en .

# =============================================================================
# CHILD RESCUE OPERATIONS (Arkansas Analysis)
# =============================================================================

icac-specialized:ChildRescueUnit rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:SpecializedInvestigativeUnit ;
    rdfs:label "Child Rescue Unit"@en ;
    rdfs:comment "Specialized unit focused on child rescue from ongoing abuse situations."@en .

icac-specialized:ActiveRescueOperation rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Active Rescue Operation"@en ;
    rdfs:comment "Operation to rescue children from ongoing abuse or exploitation."@en .

icac-specialized:VictimRecoverySpecialist rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "Victim Recovery Specialist"@en ;
    rdfs:comment "Specialist trained in recovering child victims from dangerous situations."@en .

icac-specialized:EmergencyResponseCoordination rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Emergency Response Coordination"@en ;
    rdfs:comment "Coordination of emergency response for immediate child rescue."@en .

icac-specialized:OngoingAbuseInvestigation rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Ongoing Abuse Investigation"@en ;
    rdfs:comment "Investigation identifying children in ongoing abuse situations."@en .

icac-specialized:RescuePreparationTask rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Rescue Preparation Task"@en ;
    rdfs:comment "Task involved in preparing for child rescue operation."@en .

# =============================================================================
# ENHANCED OPERATIONAL COORDINATION (Arkansas Scale)
# =============================================================================

icac-specialized:HighVolumeOperationsUnit rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:SpecializedInvestigativeUnit ;
    rdfs:label "High Volume Operations Unit"@en ;
    rdfs:comment "Unit specialized in managing high-volume operations with 100+ actions."@en .

icac-specialized:RapidResponseTeam rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:SpecializedInvestigativeUnit ;
    rdfs:label "Rapid Response Team"@en ;
    rdfs:comment "Team specialized in rapid response to time-sensitive situations."@en .

icac-specialized:MultiTaskForceCoordination rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Multi-Task Force Coordination"@en ;
    rdfs:comment "Coordination activities across multiple task forces for large operations."@en .

icac-specialized:OperationalScaleManagement rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Operational Scale Management"@en ;
    rdfs:comment "Management of operational scale involving hundreds of actions."@en .

icac-specialized:ProactiveSearchSpecialist rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "Proactive Search Specialist"@en ;
    rdfs:comment "Specialist focused on proactive search operations rather than reactive response."@en .

# =============================================================================
# AFFILIATE ORGANIZATION MANAGEMENT (Wisconsin ICAC Inspired)
# =============================================================================

icac-specialized:ICACAffiliateOrganization rdf:type owl:Class ;
    rdfs:subClassOf uco-identity:Organization ;
    rdfs:label "ICAC Affiliate Organization"@en ;
    rdfs:comment "Formally affiliated organization within the ICAC network for coordinated child protection efforts."@en .

icac-specialized:AffiliateManagementUnit rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:SpecializedInvestigativeUnit ;
    rdfs:label "Affiliate Management Unit"@en ;
    rdfs:comment "Specialized unit responsible for managing and coordinating ICAC affiliate relationships."@en .

icac-specialized:AffiliateCoordinationCenter rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Affiliate Coordination Center"@en ;
    rdfs:comment "Central coordination center for managing affiliate organization activities and resource sharing."@en .

icac-specialized:AffiliateResourceLibrary rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Affiliate Resource Library"@en ;
    rdfs:comment "Centralized library of resources available for sharing among ICAC affiliate organizations."@en .

icac-specialized:AffiliateNetworkCoordination rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Affiliate Network Coordination"@en ;
    rdfs:comment "Coordination activities across the network of ICAC affiliate organizations."@en .

icac-specialized:InterAffiliateResourceSharing rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Inter-Affiliate Resource Sharing"@en ;
    rdfs:comment "Resource sharing activities between different ICAC affiliate organizations."@en .

icac-specialized:AffiliateJointOperation rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Affiliate Joint Operation"@en ;
    rdfs:comment "Joint operations conducted by multiple ICAC affiliate organizations."@en .

icac-specialized:AffiliateSupport rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Affiliate Support"@en ;
    rdfs:comment "Support services provided to ICAC affiliate organizations."@en .

icac-specialized:AffiliateTechnicalAssistance rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:AffiliateSupport ;
    rdfs:label "Affiliate Technical Assistance"@en ;
    rdfs:comment "Technical assistance and support provided to affiliate organizations."@en .

icac-specialized:AffiliateResourceRequest rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Affiliate Resource Request"@en ;
    rdfs:comment "Request for resources made by an affiliate organization to the network."@en .

icac-specialized:AffiliateResourceAllocation rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Affiliate Resource Allocation"@en ;
    rdfs:comment "Allocation of resources to affiliate organizations based on needs and availability."@en .

icac-specialized:AffiliatePerformanceAssessment rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Affiliate Performance Assessment"@en ;
    rdfs:comment "Assessment of affiliate organization performance and contribution to network goals."@en .

# =============================================================================
# SPECIALIZED CAPABILITIES
# =============================================================================

icac-specialized:TripleThreatCapability rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Triple Threat Capability"@en ;
    rdfs:comment "K9 capability combining detection, community engagement, and officer wellness support."@en .

icac-specialized:DetectionCapability rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Detection Capability"@en ;
    rdfs:comment "Capability to detect specific items or substances."@en .

icac-specialized:CommunityEngagementCapability rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Community Engagement Capability"@en ;
    rdfs:comment "Capability to engage effectively with community members."@en .

icac-specialized:WellnessSupportCapability rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Wellness Support Capability"@en ;
    rdfs:comment "Capability to provide wellness and emotional support."@en .

# =============================================================================
# SPECIALIZED ROLES
# =============================================================================

icac-specialized:K9Handler rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "K9 Handler"@en ;
    rdfs:comment "Officer responsible for handling and working with K9 units."@en .

icac-specialized:WellnessCoordinator rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "Wellness Coordinator"@en ;
    rdfs:comment "Person responsible for coordinating officer wellness programs."@en .

icac-specialized:CommunityLiaison rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "Community Liaison"@en ;
    rdfs:comment "Person responsible for community engagement and outreach."@en .

icac-specialized:OperationCommander rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "Operation Commander"@en ;
    rdfs:comment "Person commanding a named operation."@en .

icac-specialized:SpecializedInvestigator rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "Specialized Investigator"@en ;
    rdfs:comment "Investigator with specialized training and capabilities."@en .

icac-specialized:AffiliateCoordinator rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "Affiliate Coordinator"@en ;
    rdfs:comment "Coordinator responsible for managing relationships with affiliate organizations."@en .

icac-specialized:AffiliateNetworkManager rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "Affiliate Network Manager"@en ;
    rdfs:comment "Manager overseeing the entire network of ICAC affiliate organizations."@en .

icac-specialized:AffiliateResourceManager rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "Affiliate Resource Manager"@en ;
    rdfs:comment "Manager responsible for affiliate resource library and sharing systems."@en .

icac-specialized:AffiliateLiaison rdf:type owl:Class ;
    rdfs:subClassOf uco-role:Role ;
    rdfs:label "Affiliate Liaison"@en ;
    rdfs:comment "Liaison responsible for communication between affiliate organizations and central ICAC."@en .

# =============================================================================
# METRICS AND PERFORMANCE
# =============================================================================

icac-specialized:AffiliateNetworkMetrics rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Affiliate Network Metrics"@en ;
    rdfs:comment "Metrics measuring the performance and effectiveness of the affiliate network."@en .

icac-specialized:AffiliateEngagementMetrics rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:AffiliateNetworkMetrics ;
    rdfs:label "Affiliate Engagement Metrics"@en ;
    rdfs:comment "Metrics measuring affiliate organization engagement and participation levels."@en .

icac-specialized:ResourceSharingMetrics rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:AffiliateNetworkMetrics ;
    rdfs:label "Resource Sharing Metrics"@en ;
    rdfs:comment "Metrics tracking resource sharing effectiveness among affiliate organizations."@en .

icac-specialized:AffiliateCapacityMetrics rdf:type owl:Class ;
    rdfs:subClassOf icac-specialized:AffiliateNetworkMetrics ;
    rdfs:label "Affiliate Capacity Metrics"@en ;
    rdfs:comment "Metrics measuring the collective capacity of affiliate organizations."@en .

# =============================================================================
# OBJECT PROPERTIES
# =============================================================================

icac-specialized:operatesK9 rdf:type owl:ObjectProperty ;
    rdfs:domain icac-specialized:K9Officer ;
    rdfs:range icac-specialized:DetectionDog ;
    rdfs:label "operates K9"@en ;
    rdfs:comment "Relationship between K9 officer and their detection dog."@en .

icac-specialized:assistsInSearch rdf:type owl:ObjectProperty ;
    rdfs:domain icac-specialized:DetectionDog ;
    rdfs:range icac-specialized:K9SearchOperation ;
    rdfs:label "assists in search"@en ;
    rdfs:comment "Dog assists in a specific search operation."@en .

icac-specialized:providesWellnessSupport rdf:type owl:ObjectProperty ;
    rdfs:domain icac-specialized:TherapyDog ;
    rdfs:range uco-identity:Person ;
    rdfs:label "provides wellness support"@en ;
    rdfs:comment "Therapy dog provides wellness support to person."@en .

icac-specialized:participatesInOperation rdf:type owl:ObjectProperty ;
    rdfs:domain icac-specialized:SpecializedInvestigativeUnit ;
    rdfs:range icac-specialized:NamedOperation ;
    rdfs:label "participates in operation"@en ;
    rdfs:comment "Unit participates in named operation."@en .

icac-specialized:hasOutreachMetrics rdf:type owl:ObjectProperty ;
    rdfs:domain icac-specialized:CommunityOutreachProgram ;
    rdfs:range icac-specialized:OperationMetrics ;
    rdfs:label "has outreach metrics"@en ;
    rdfs:comment "Program has associated metrics tracking its effectiveness."@en .

icac-specialized:hasCapability rdf:type owl:ObjectProperty ;
    rdfs:domain icac-specialized:DetectionDog ;
    rdfs:range icac-specialized:TripleThreatCapability ;
    rdfs:label "has capability"@en ;
    rdfs:comment "Detection dog has specific specialized capability."@en .

icac-specialized:coordinatesSeasonalTiming rdf:type owl:ObjectProperty ;
    rdfs:domain icac-specialized:TimingCoordinator ;
    rdfs:range icac-specialized:SeasonalOperationsUnit ;
    rdfs:label "coordinates seasonal timing"@en ;
    rdfs:comment "Coordinator manages seasonal timing for operations unit."@en .

icac-specialized:identifiesSeasonalPattern rdf:type owl:ObjectProperty ;
    rdfs:domain icac-specialized:SeasonalOperationsUnit ;
    rdfs:range icac-specialized:SeasonalCyberTipPattern ;
    rdfs:label "identifies seasonal pattern"@en ;
    rdfs:comment "Unit identifies and responds to seasonal cyber tip patterns."@en .

icac-specialized:conductsRescueOperation rdf:type owl:ObjectProperty ;
    rdfs:domain icac-specialized:ChildRescueUnit ;
    rdfs:range icac-specialized:ActiveRescueOperation ;
    rdfs:label "conducts rescue operation"@en ;
    rdfs:comment "Unit conducts active child rescue operations."@en .

icac-specialized:respondsToEmergency rdf:type owl:ObjectProperty ;
    rdfs:domain icac-specialized:RapidResponseTeam ;
    rdfs:range icac-specialized:EmergencyResponseCoordination ;
    rdfs:label "responds to emergency"@en ;
    rdfs:comment "Team responds to emergency child rescue situations."@en .

icac-specialized:managesHighVolume rdf:type owl:ObjectProperty ;
    rdfs:domain icac-specialized:HighVolumeOperationsUnit ;
    rdfs:range icac-specialized:OperationalScaleManagement ;
    rdfs:label "manages high volume"@en ;
    rdfs:comment "Unit manages high-volume operational activities."@en .

icac-specialized:utilizesCheckpoint rdf:type owl:ObjectProperty ;
    rdfs:domain icac-specialized:SeasonalOperationsUnit ;
    rdfs:range icac-specialized:HighwayCheckpointOperation ;
    rdfs:label "utilizes checkpoint"@en ;
    rdfs:comment "Unit utilizes highway checkpoint operations."@en .

icac-specialized:managesAffiliate rdf:type owl:ObjectProperty ;
    rdfs:domain icac-specialized:AffiliateManagementUnit ;
    rdfs:range icac-specialized:ICACAffiliateOrganization ;
    rdfs:label "manages affiliate"@en ;
    rdfs:comment "Management unit oversees specific affiliate organization."@en .

icac-specialized:coordinatesWithAffiliate rdf:type owl:ObjectProperty ;
    rdfs:domain icac-specialized:AffiliateNetworkCoordination ;
    rdfs:range icac-specialized:ICACAffiliateOrganization ;
    rdfs:label "coordinates with affiliate"@en ;
    rdfs:comment "Network coordination involves specific affiliate organization."@en .

icac-specialized:providesResourceTo rdf:type owl:ObjectProperty ;
    rdfs:domain icac-specialized:InterAffiliateResourceSharing ;
    rdfs:range icac-specialized:ICACAffiliateOrganization ;
    rdfs:label "provides resource to"@en ;
