@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core#> .
@prefix uco-identity: <https://ontology.unifiedcyberontology.org/uco/identity#> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/uco/action#> .
@prefix uco-location: <https://ontology.unifiedcyberontology.org/uco/location#> .
@prefix uco-role: <https://ontology.unifiedcyberontology.org/uco/role#> .
@prefix icac-educational: <https://ontology.unifiedcyberontology.org/icac/educational#> .
@prefix icac-educational-shapes: <https://ontology.unifiedcyberontology.org/icac/educational/shapes#> .

# gUFO Integration
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix icac-gufo: <https://ontology.unifiedcyberontology.org/icac/gufo#> .

# Enhanced Ontology Declaration with gUFO Validation
<https://ontology.unifiedcyberontology.org/icac/educational/shapes/0.2> rdf:type owl:Ontology ;
    rdfs:label "ICAC Educational SHACL Shapes with gUFO Validation"@en ;
    rdfs:comment "Comprehensive SHACL validation shapes for gUFO-enhanced ICAC educational exploitation ontology, including foundational type validation, anti-rigidity constraints for educator roles and phases, temporal consistency validation, educational exploitation workflow validation, and advanced cross-reference validation for educator-perpetrated exploitation systems."@en ;
    owl:versionIRI <https://ontology.unifiedcyberontology.org/icac/educational/shapes/0.2> ;
    owl:imports <https://ontology.unifiedcyberontology.org/icac/educational/0.1> ,
                <http://purl.org/nemo/gufo> ,
                <https://ontology.unifiedcyberontology.org/uco/core> ;
    owl:versionInfo "0.2 - gUFO Enhanced Validation"@en .

# =============================================================================
# gUFO EDUCATIONAL INSTITUTION VALIDATION (Objects/Organizations)
# =============================================================================

# Educational Institution gUFO Object Validation
icac-educational-shapes:EducationalInstitutionGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:EducationalInstitution ,
                   icac-educational:IndependentSchool ,
                   icac-educational:PublicSchool ,
                   icac-educational:PrivateSchool ,
                   icac-educational:EliteEducationalInstitution ,
                   icac-educational:IntermediateSchool ,
                   icac-educational:MiddleSchool ;
    rdfs:label "gUFO Educational Institution Shape"@en ;
    rdfs:comment "Validates educational institutions as gUFO Organizations with foundational constraints."@en ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue gufo:Organization ;
        sh:minCount 1 ;
        sh:message "Educational institution must be typed as gUFO Organization"@en
    ] ;
    sh:property [
        sh:path uco-core:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 3 ;
        sh:maxLength 100 ;
        sh:message "Educational institution must have a name (3-100 characters)"@en
    ] ;
    sh:property [
        sh:path icac-educational:institutionType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("independent" "public" "private" "elite" "charter") ;
        sh:message "Institution type must be specified from valid options"@en
    ] ;
    sh:property [
        sh:path icac-educational:institutionLocation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 5 ;
        sh:maxLength 200 ;
        sh:message "Institution location must be specified (5-200 characters)"@en
    ] ;
    sh:property [
        sh:path icac-educational:studentPopulation ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:minInclusive 10 ;
        sh:maxInclusive 50000 ;
        sh:message "Student population must be between 10 and 50,000"@en
    ] .

# Elite Educational Institution Enhanced Validation
icac-educational-shapes:EliteEducationalInstitutionGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:EliteEducationalInstitution ;
    rdfs:label "gUFO Elite Educational Institution Shape"@en ;
    rdfs:comment "Validates elite educational institutions with enhanced gUFO Organization constraints."@en ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue gufo:Organization ;
        sh:minCount 1 ;
        sh:message "Elite institution must be typed as gUFO Organization"@en
    ] ;
    sh:property [
        sh:path icac-educational:institutionReputation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("elite" "prestigious" "highly_selective") ;
        sh:message "Elite institution must have appropriate reputation level"@en
    ] .

# =============================================================================
# gUFO EDUCATOR ROLE VALIDATION (Anti-Rigid Roles)
# =============================================================================

# Educator Role gUFO Role Validation
icac-educational-shapes:EducatorRoleGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:EducatorRole ,
                   icac-educational:TeacherRole ,
                   icac-educational:MathTeacherRole ,
                   icac-educational:SubstituteTeacherRole ,
                   icac-educational:AdministratorRole ,
                   icac-educational:CounselorRole ,
                   icac-educational:CoachRole ,
                   icac-educational:GymTeacherRole ;
    rdfs:label "gUFO Educator Role Shape"@en ;
    rdfs:comment "Validates educator roles as anti-rigid gUFO roles."@en ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue gufo:Role ;
        sh:minCount 1 ;
        sh:message "Educator role must be typed as gUFO Role (anti-rigid sortal)"@en
    ] ;
    sh:property [
        sh:path icac-gufo:employmentBeginTimePoint ;
        sh:datatype xsd:dateTimeStamp ;
        sh:maxCount 1 ;
        sh:message "Educator role can have at most one employment begin point"@en
    ] ;
    sh:property [
        sh:path icac-gufo:employmentEndTimePoint ;
        sh:datatype xsd:dateTimeStamp ;
        sh:maxCount 1 ;
        sh:message "Educator role can have at most one employment end point"@en
    ] ;
    sh:property [
        sh:path icac-educational:employmentDuration ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.1 ; # Minimum 1 month
        sh:maxInclusive 600.0 ; # Maximum 50 years
        sh:message "Employment duration must be between 0.1 and 600 months"@en
    ] ;
    sh:property [
        sh:path icac-educational:accessLevel ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ("direct_student_contact" "limited_contact" "administrative_only" "no_contact") ;
        sh:message "Access level must be from valid options when specified"@en
    ] ;
    # Role temporal consistency
    sh:sparql [
        sh:message "Employment begin point must precede end point"@en ;
        sh:prefixes [
            sh:declare [
                sh:prefix "icac-gufo" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/icac/gufo#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this icac-gufo:employmentBeginTimePoint ?begin ;
                      icac-gufo:employmentEndTimePoint ?end .
                FILTER (?begin >= ?end)
            }
        """
    ] .

# Teacher Role Enhanced Validation
icac-educational-shapes:TeacherRoleGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:TeacherRole ,
                   icac-educational:MathTeacherRole ,
                   icac-educational:SubstituteTeacherRole ,
                   icac-educational:GymTeacherRole ;
    rdfs:label "gUFO Teacher Role Shape"@en ;
    rdfs:comment "Validates teacher roles with enhanced gUFO anti-rigid constraints."@en ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue gufo:Role ;
        sh:minCount 1 ;
        sh:message "Teacher role must be typed as gUFO Role (anti-rigid sortal)"@en
    ] ;
    sh:property [
        sh:path icac-educational:subjectTaught ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minLength 2 ;
        sh:maxLength 50 ;
        sh:message "Subject taught should be 2-50 characters when specified"@en
    ] ;
    sh:property [
        sh:path icac-educational:gradeLevel ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ("Elementary" "Middle School" "High School" "K-12" "Mixed") ;
        sh:message "Grade level must be from valid options when specified"@en
    ] .

# =============================================================================
# gUFO EDUCATIONAL PHASE VALIDATION (Anti-Rigid Phases)
# =============================================================================

# Educational Phase gUFO Phase Validation
icac-educational-shapes:EducationalPhaseGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:AcademicTermPhase ,
                   icac-educational:EmploymentPhase ,
                   icac-educational:ExploitationEscalationPhase ,
                   icac-educational:InvestigationPhase ;
    rdfs:label "gUFO Educational Phase Shape"@en ;
    rdfs:comment "Validates educational phases as anti-rigid gUFO phases."@en ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue gufo:Phase ;
        sh:minCount 1 ;
        sh:message "Educational phase must be typed as gUFO Phase (anti-rigid sortal)"@en
    ] ;
    sh:property [
        sh:path icac-gufo:beginTimePoint ;
        sh:datatype xsd:dateTimeStamp ;
        sh:maxCount 1 ;
        sh:message "Educational phase can have at most one begin point"@en
    ] ;
    sh:property [
        sh:path icac-gufo:endTimePoint ;
        sh:datatype xsd:dateTimeStamp ;
        sh:maxCount 1 ;
        sh:message "Educational phase can have at most one end point"@en
    ] ;
    # Phase temporal consistency
    sh:sparql [
        sh:message "Phase begin point must precede end point"@en ;
        sh:prefixes [
            sh:declare [
                sh:prefix "icac-gufo" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/icac/gufo#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this icac-gufo:beginTimePoint ?begin ;
                      icac-gufo:endTimePoint ?end .
                FILTER (?begin >= ?end)
            }
        """
    ] .

# Academic Term Phase Validation
icac-educational-shapes:AcademicTermPhaseShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:AcademicTermPhase ;
    rdfs:label "Academic Term Phase Shape"@en ;
    rdfs:comment "Validates academic term phases with gUFO anti-rigid constraints."@en ;
    sh:sparql [
        sh:message "Academic term phase should align with institutional academic calendar"@en ;
        sh:prefixes [
            sh:declare [
                sh:prefix "icac-educational" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/icac/educational#"^^xsd:anyURI
            ] , [
                sh:prefix "icac-gufo" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/icac/gufo#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this a icac-educational:AcademicTermPhase ;
                      icac-gufo:beginTimePoint ?termBegin .
                ?institution icac-gufo:academicYearBeginTimePoint ?yearBegin .
                ?exploitation icac-educational:occursAtInstitution ?institution ;
                             gufo:occursInPhase ?this .
                FILTER (?termBegin < ?yearBegin)
            }
        """
    ] .

# =============================================================================
# gUFO EXPLOITATION EVENT VALIDATION (Events)
# =============================================================================

# Educator Perpetrated Exploitation gUFO Event Validation
icac-educational-shapes:EducatorExploitationGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:EducatorPerpetratedExploitation ,
                   icac-educational:TeacherStudentExploitation ,
                   icac-educational:CrossInstitutionalExploitation ,
                   icac-educational:PositionOfTrustExploitation ,
                   icac-educational:ClassroomBasedExploitation ,
                   icac-educational:AcademicActivityExploitation ,
                   icac-educational:ImmediatePhysicalContactExploitation ;
    rdfs:label "gUFO Educator Exploitation Shape"@en ;
    rdfs:comment "Validates educator-perpetrated exploitation as gUFO Events with temporal boundaries."@en ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue gufo:Event ;
        sh:minCount 1 ;
        sh:message "Educator exploitation must be typed as gUFO Event"@en
    ] ;
    sh:property [
        sh:path icac-gufo:exploitationFirstIncidentTimePoint ;
        sh:datatype xsd:dateTimeStamp ;
        sh:maxCount 1 ;
        sh:message "Exploitation can have at most one first incident time point"@en
    ] ;
    sh:property [
        sh:path icac-gufo:exploitationDuration ;
        sh:datatype xsd:duration ;
        sh:maxCount 1 ;
        sh:message "Exploitation can have at most one duration"@en
    ] ;
    sh:property [
        sh:path icac-educational:exploitationDuration ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.1 ; # Minimum 1 month
        sh:maxInclusive 120.0 ; # Maximum 10 years
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:message "Exploitation duration must be between 0.1 and 120 months when specified"@en
    ] ;
    sh:property [
        sh:path icac-educational:victimCount ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:minInclusive 1 ;
        sh:maxInclusive 1000 ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:message "Victim count must be between 1 and 1000 when specified"@en
    ] ;
    sh:property [
        sh:path icac-educational:exploitsPosition ;
        sh:class icac-educational:EducatorRole ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:message "Exploitation can specify educator position being exploited"@en
    ] .

# Harassment Event gUFO Event Validation
icac-educational-shapes:HarassmentEventGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:WrittenHarassment ,
                   icac-educational:AssignmentHarassment ,
                   icac-educational:DegradingWrittenComments ,
                   icac-educational:AcademicIntimidation ;
    rdfs:label "gUFO Harassment Event Shape"@en ;
    rdfs:comment "Validates harassment events as gUFO Events with temporal boundaries."@en ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue gufo:Event ;
        sh:minCount 1 ;
        sh:message "Harassment event must be typed as gUFO Event"@en
    ] ;
    sh:property [
        sh:path icac-gufo:beginTimePoint ;
        sh:datatype xsd:dateTimeStamp ;
        sh:maxCount 1 ;
        sh:message "Harassment event can have at most one begin point"@en
    ] ;
    sh:property [
        sh:path icac-gufo:endTimePoint ;
        sh:datatype xsd:dateTimeStamp ;
        sh:maxCount 1 ;
        sh:message "Harassment event can have at most one end point"@en
    ] .

# Cross Institutional Exploitation Enhanced Validation
icac-educational-shapes:CrossInstitutionalExploitationGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:CrossInstitutionalExploitation ;
    rdfs:label "gUFO Cross Institutional Exploitation Shape"@en ;
    rdfs:comment "Validates cross-institutional exploitation with multi-institution constraints."@en ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue gufo:Event ;
        sh:minCount 1 ;
        sh:message "Cross institutional exploitation must be typed as gUFO Event"@en
    ] ;
    sh:property [
        sh:path icac-educational:institutionCount ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:minInclusive 2 ; # Must be multiple institutions
        sh:maxInclusive 50 ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:message "Cross-institutional exploitation should involve 2-50 institutions when specified"@en
    ] .

# =============================================================================
# gUFO EDUCATIONAL SITUATION VALIDATION
# =============================================================================

# Educational Situation gUFO Situation Validation
icac-educational-shapes:EducationalSituationGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:EducationalExploitationSituation ,
                   icac-educational:InstitutionalResponseSituation ,
                   icac-educational:MultiVictimExploitationSituation ,
                   icac-educational:CrossInstitutionalInvestigationSituation ;
    rdfs:label "gUFO Educational Situation Shape"@en ;
    rdfs:comment "Validates educational situations with gUFO constraints."@en ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue gufo:Situation ;
        sh:minCount 1 ;
        sh:message "Educational situation must be typed as gUFO Situation"@en
    ] ;
    sh:property [
        sh:path icac-gufo:situationBeginTimePoint ;
        sh:datatype xsd:dateTimeStamp ;
        sh:maxCount 1 ;
        sh:message "Educational situation can have at most one begin point"@en
    ] ;
    sh:property [
        sh:path icac-gufo:situationEndTimePoint ;
        sh:datatype xsd:dateTimeStamp ;
        sh:maxCount 1 ;
        sh:message "Educational situation can have at most one end point"@en
    ] .

# Multi Victim Exploitation Situation Validation
icac-educational-shapes:MultiVictimExploitationSituationShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:MultiVictimExploitationSituation ;
    rdfs:label "Multi Victim Exploitation Situation Shape"@en ;
    rdfs:comment "Validates multi-victim exploitation situations."@en ;
    sh:sparql [
        sh:message "Multi-victim exploitation situation must involve multiple victims"@en ;
        sh:prefixes [
            sh:declare [
                sh:prefix "icac-educational" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/icac/educational#"^^xsd:anyURI
            ] , [
                sh:prefix "gufo" ;
                sh:namespace "http://purl.org/nemo/gufo#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this a icac-educational:MultiVictimExploitationSituation .
                {
                    SELECT ?this (COUNT(DISTINCT ?victim) as ?victimCount)
                    WHERE {
                        ?exploitation gufo:occursInSituation ?this .
                        ?exploitation icac-educational:targetsStudent ?victim .
                    }
                    GROUP BY ?this
                }
                FILTER (?victimCount < 2)
            }
        """
    ] .

# =============================================================================
# gUFO CLASSROOM CONTEXT VALIDATION (Objects)
# =============================================================================

# Classroom Context gUFO Object Validation
icac-educational-shapes:ClassroomContextGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:ClassroomExploitationContext ,
                   icac-educational:AssignmentCompletionExploitation ,
                   icac-educational:TestTakingExploitation ,
                   icac-educational:OneOnOneAcademicExploitation ,
                   icac-educational:AfterHoursClassroomExploitation ;
    rdfs:label "gUFO Classroom Context Shape"@en ;
    rdfs:comment "Validates classroom contexts as gUFO Objects."@en ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue gufo:Object ;
        sh:minCount 1 ;
        sh:message "Classroom context must be typed as gUFO Object"@en
    ] ;
    sh:property [
        sh:path icac-gufo:contextTimePoint ;
        sh:datatype xsd:dateTimeStamp ;
        sh:maxCount 1 ;
        sh:message "Classroom context can have at most one time point"@en
    ] .

# =============================================================================
# gUFO VICTIM TARGETING VALIDATION
# =============================================================================

# Student Victim Targeting Validation
icac-educational-shapes:StudentVictimTargetingGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:StudentVictimTargeting ;
    rdfs:label "gUFO Student Victim Targeting Shape"@en ;
    rdfs:comment "Validates student victim targeting with gUFO foundational constraints."@en ;
    sh:property [
        sh:path icac-educational:victimAgeRange ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9]+-[0-9]+$" ;
        sh:message "Victim age range must be in format 'min-max' (e.g., '13-15') when specified"@en
    ] ;
    sh:property [
        sh:path icac-educational:targetsStudent ;
        sh:class uco-identity:Person ;
        sh:minCount 0 ;
        sh:message "Student targeting can specify target students"@en
    ] .

# Multiple Institution Targeting Validation
icac-educational-shapes:MultipleInstitutionTargetingGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:MultipleInstitutionTargeting ;
    rdfs:label "gUFO Multiple Institution Targeting Shape"@en ;
    rdfs:comment "Validates multiple institution targeting with gUFO constraints."@en ;
    sh:property [
        sh:path icac-educational:institutionCount ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:minInclusive 2 ;
        sh:maxInclusive 50 ;
        sh:message "Multiple institution targeting must involve 2-50 institutions"@en
    ] .

# =============================================================================
# gUFO INVESTIGATION VALIDATION (Events)
# =============================================================================

# Educational Institution Investigation gUFO Event Validation
icac-educational-shapes:EducationalInvestigationGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:EducationalInstitutionInvestigation ;
    rdfs:label "gUFO Educational Investigation Shape"@en ;
    rdfs:comment "Validates educational investigations as gUFO Events."@en ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue gufo:Event ;
        sh:minCount 1 ;
        sh:message "Educational investigation must be typed as gUFO Event"@en
    ] ;
    sh:property [
        sh:path icac-educational:investigatesNetwork ;
        sh:class icac-educational:EducatorPerpetratedExploitation ;
        sh:minCount 0 ;
        sh:message "Educational investigation can investigate exploitation operations"@en
    ] ;
    sh:property [
        sh:path uco-core:startTime ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:message "Investigation can have at most one start time"@en
    ] .

# =============================================================================
# gUFO EVIDENCE VALIDATION (Objects)
# =============================================================================

# Evidence gUFO Object Validation
icac-educational-shapes:EvidenceGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:IPAddressEvidence ,
                   icac-educational:DigitalCommunicationEvidence ,
                   icac-educational:VictimAccountEvidence ;
    rdfs:label "gUFO Evidence Shape"@en ;
    rdfs:comment "Validates evidence as gUFO Objects."@en ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue gufo:Object ;
        sh:minCount 1 ;
        sh:message "Evidence must be typed as gUFO Object"@en
    ] .

# IP Address Evidence Enhanced Validation
icac-educational-shapes:IPAddressEvidenceGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:IPAddressEvidence ;
    rdfs:label "gUFO IP Address Evidence Shape"@en ;
    rdfs:comment "Validates IP address evidence with gUFO Object constraints."@en ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue gufo:Object ;
        sh:minCount 1 ;
        sh:message "IP address evidence must be typed as gUFO Object"@en
    ] ;
    sh:property [
        sh:path icac-educational:linkedToLocation ;
        sh:class uco-location:Location ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:message "IP address evidence can link to exactly one location"@en
    ] ;
    sh:property [
        sh:path icac-educational:documentsExploitation ;
        sh:class icac-educational:EducatorPerpetratedExploitation ;
        sh:minCount 0 ;
        sh:message "IP address evidence can document exploitation"@en
    ] .

# Digital Communication Evidence Enhanced Validation
icac-educational-shapes:DigitalCommunicationEvidenceGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:DigitalCommunicationEvidence ;
    rdfs:label "gUFO Digital Communication Evidence Shape"@en ;
    rdfs:comment "Validates digital communication evidence with gUFO Object constraints."@en ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue gufo:Object ;
        sh:minCount 1 ;
        sh:message "Digital communication evidence must be typed as gUFO Object"@en
    ] ;
    sh:property [
        sh:path icac-educational:documentsExploitation ;
        sh:class icac-educational:EducatorPerpetratedExploitation ;
        sh:minCount 0 ;
        sh:message "Digital communication evidence can document exploitation"@en
    ] .

# Victim Account Evidence Enhanced Validation
icac-educational-shapes:VictimAccountEvidenceGUFOShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:VictimAccountEvidence ;
    rdfs:label "gUFO Victim Account Evidence Shape"@en ;
    rdfs:comment "Validates victim account evidence with gUFO Object constraints."@en ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue gufo:Object ;
        sh:minCount 1 ;
        sh:message "Victim account evidence must be typed as gUFO Object"@en
    ] ;
    sh:property [
        sh:path icac-educational:providedBy ;
        sh:class uco-identity:Person ;
        sh:minCount 0 ;
        sh:message "Victim account evidence can be provided by victim(s)"@en
    ] .

# =============================================================================
# gUFO FOUNDATIONAL TYPE COMPLIANCE
# =============================================================================

# gUFO Type Consistency Shape for Educational Domain
icac-educational-shapes:EducationalFoundationalTypeShape rdf:type sh:NodeShape ;
    sh:targetNode icac-educational:EducationalInstitution ;
    rdfs:label "Educational gUFO Foundational Type Consistency Shape"@en ;
    rdfs:comment "Validates proper gUFO foundational typing for educational entities."@en ;
    sh:sparql [
        sh:message "All educational gUFO entities must have proper foundational typing"@en ;
        sh:prefixes [
            sh:declare [
                sh:prefix "gufo" ;
                sh:namespace "http://purl.org/nemo/gufo#"^^xsd:anyURI
            ] , [
                sh:prefix "icac-educational" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/icac/educational#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT ?entity
            WHERE {
                ?entity a icac-educational:EducationalInstitution .
                FILTER NOT EXISTS { ?entity a gufo:Organization . }
            } UNION {
                ?entity a icac-educational:EducatorPerpetratedExploitation .
                FILTER NOT EXISTS { ?entity a gufo:Event . }
            } UNION {
                ?entity a icac-educational:EducatorRole .
                FILTER NOT EXISTS { ?entity a gufo:Role . }
            } UNION {
                ?entity a icac-educational:AcademicTermPhase .
                FILTER NOT EXISTS { ?entity a gufo:Phase . }
            } UNION {
                ?entity a icac-educational:EducationalExploitationSituation .
                FILTER NOT EXISTS { ?entity a gufo:Situation . }
            }
        """
    ] .

# =============================================================================
# TEMPORAL CONSISTENCY VALIDATION
# =============================================================================

# Educational Temporal Consistency Shape
icac-educational-shapes:EducationalTemporalConsistencyShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:EducatorPerpetratedExploitation ;
    rdfs:label "Educational Temporal Consistency Shape"@en ;
    rdfs:comment "Validates temporal consistency across educational events and phases."@en ;
    sh:sparql [
        sh:message "Exploitation should occur during active employment phase"@en ;
        sh:prefixes [
            sh:declare [
                sh:prefix "icac-educational" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/icac/educational#"^^xsd:anyURI
            ] , [
                sh:prefix "icac-gufo" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/icac/gufo#"^^xsd:anyURI
            ] , [
                sh:prefix "gufo" ;
                sh:namespace "http://purl.org/nemo/gufo#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this icac-gufo:exploitationFirstIncidentTimePoint ?exploitationTime .
                ?educator icac-educational:perpetratesExploitation ?this .
                ?educator gufo:playsRole ?role .
                ?role a icac-educational:EducatorRole ;
                      icac-gufo:employmentBeginTimePoint ?employBegin ;
                      icac-gufo:employmentEndTimePoint ?employEnd .
                FILTER (?exploitationTime < ?employBegin || ?exploitationTime > ?employEnd)
            }
        """
    ] .

# Educational Workflow Temporal Validation
icac-educational-shapes:EducationalWorkflowTemporalShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:InvestigationPhase ;
    rdfs:label "Educational Workflow Temporal Shape"@en ;
    rdfs:comment "Validates temporal workflow progression in educational investigation processes."@en ;
    sh:sparql [
        sh:message "Investigation phase should follow exploitation reporting"@en ;
        sh:prefixes [
            sh:declare [
                sh:prefix "icac-educational" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/icac/educational#"^^xsd:anyURI
            ] , [
                sh:prefix "icac-gufo" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/icac/gufo#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this a icac-educational:InvestigationPhase ;
                      icac-gufo:beginTimePoint ?investigationTime .
                ?situation icac-gufo:institutionalReportingTimePoint ?reportTime .
                ?this gufo:occursInSituation ?situation .
                FILTER (?investigationTime < ?reportTime)
            }
        """
    ] .

# =============================================================================
# CROSS-REFERENCE VALIDATION
# =============================================================================

# Exploitation Role Cross Reference Shape
icac-educational-shapes:ExploitationRoleCrossReferenceShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:EducatorPerpetratedExploitation ;
    rdfs:label "Exploitation Role Cross Reference Shape"@en ;
    rdfs:comment "Validates that exploitation involves appropriate educator roles."@en ;
    sh:sparql [
        sh:message "Educator exploitation should involve person with educator role"@en ;
        sh:prefixes [
            sh:declare [
                sh:prefix "icac-educational" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/icac/educational#"^^xsd:anyURI
            ] , [
                sh:prefix "uco-identity" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/uco/identity#"^^xsd:anyURI
            ] , [
                sh:prefix "gufo" ;
                sh:namespace "http://purl.org/nemo/gufo#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this icac-educational:exploitsPosition ?role .
                FILTER NOT EXISTS {
                    ?person icac-educational:employedAt ?institution .
                    ?person gufo:playsRole ?role .
                    ?role a icac-educational:EducatorRole .
                }
            }
        """
    ] .

# Institution Count Cross Reference Shape
icac-educational-shapes:InstitutionCountCrossReferenceShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:CrossInstitutionalExploitation ;
    rdfs:label "Institution Count Cross Reference Shape"@en ;
    rdfs:comment "Validates institution count consistency in cross-institutional exploitation."@en ;
    sh:sparql [
        sh:message "Institution count should match number of institutions actually targeted"@en ;
        sh:prefixes [
            sh:declare [
                sh:prefix "icac-educational" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/icac/educational#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this icac-educational:institutionCount ?count .
                {
                    SELECT ?this (COUNT(DISTINCT ?institution) AS ?actualCount)
                    WHERE {
                        ?this icac-educational:targetsStudent ?victim .
                        ?victim icac-educational:attendsInstitution ?institution .
                    }
                    GROUP BY ?this
                }
                FILTER (?count != ?actualCount)
            }
        """
    ] .

# Evidence Documentation Cross Reference Shape
icac-educational-shapes:EvidenceDocumentationCrossReferenceShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:IPAddressEvidence ,
                   icac-educational:DigitalCommunicationEvidence ;
    rdfs:label "Evidence Documentation Cross Reference Shape"@en ;
    rdfs:comment "Validates that evidence properly documents exploitation incidents."@en ;
    sh:sparql [
        sh:message "Evidence should document at least one exploitation incident when claimed"@en ;
        sh:prefixes [
            sh:declare [
                sh:prefix "icac-educational" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/icac/educational#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this icac-educational:documentsExploitation ?exploitation .
                FILTER NOT EXISTS {
                    ?exploitation a icac-educational:EducatorPerpetratedExploitation .
                }
            }
        """
    ] .

# =============================================================================
# ROLE PARTICIPATION VALIDATION
# =============================================================================

# Educational Role Participation Shape
icac-educational-shapes:EducationalRoleParticipationShape rdf:type sh:NodeShape ;
    sh:targetClass uco-identity:Person ;
    rdfs:label "Educational Role Participation Shape"@en ;
    rdfs:comment "Validates educational role participation constraints."@en ;
    sh:sparql [
        sh:message "Person in educator role should be employed at educational institution"@en ;
        sh:prefixes [
            sh:declare [
                sh:prefix "icac-educational" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/icac/educational#"^^xsd:anyURI
            ] , [
                sh:prefix "gufo" ;
                sh:namespace "http://purl.org/nemo/gufo#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this gufo:playsRole ?role .
                ?role a icac-educational:EducatorRole .
                FILTER NOT EXISTS {
                    ?this icac-educational:employedAt ?institution .
                    ?institution a icac-educational:EducationalInstitution .
                }
            }
        """
    ] .

# =============================================================================
# DATA QUALITY VALIDATION
# =============================================================================

# Educational Data Quality Shape
icac-educational-shapes:EducationalDataQualityShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:EducationalInstitution ,
                   icac-educational:EducatorRole ,
                   icac-educational:EducatorPerpetratedExploitation ;
    rdfs:label "Educational Data Quality Shape"@en ;
    rdfs:comment "Validates data quality for educational entities."@en ;
    sh:property [
        sh:path uco-core:name ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minLength 2 ;
        sh:maxLength 200 ;
        sh:message "Name should be between 2 and 200 characters when provided"@en
    ] ;
    sh:property [
        sh:path uco-core:description ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minLength 10 ;
        sh:maxLength 2000 ;
        sh:message "Description should be between 10 and 2000 characters when provided"@en
    ] .

# Victim Age Validation Shape
icac-educational-shapes:VictimAgeValidationShape rdf:type sh:NodeShape ;
    sh:targetClass icac-educational:StudentVictimTargeting ;
    rdfs:label "Victim Age Validation Shape"@en ;
    rdfs:comment "Validates victim age consistency and reasonableness."@en ;
    sh:sparql [
        sh:message "Victim age range should be consistent with actual victim ages"@en ;
        sh:prefixes [
            sh:declare [
                sh:prefix "icac-educational" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/icac/educational#"^^xsd:anyURI
            ] , [
                sh:prefix "uco-identity" ;
                sh:namespace "https://ontology.unifiedcyberontology.org/uco/identity#"^^xsd:anyURI
            ]
        ] ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this icac-educational:victimAgeRange ?ageRange .
                ?this icac-educational:targetsStudent ?victim .
                ?victim uco-identity:birthDate ?birthDate .
                BIND(YEAR(NOW()) - YEAR(?birthDate) AS ?age)
                BIND(STRBEFORE(?ageRange, "-") AS ?minAgeStr)
                BIND(STRAFTER(?ageRange, "-") AS ?maxAgeStr)
                BIND(xsd:integer(?minAgeStr) AS ?minAge)
                BIND(xsd:integer(?maxAgeStr) AS ?maxAge)
                FILTER(?age < ?minAge || ?age > ?maxAge)
            }
        """
    ] . 