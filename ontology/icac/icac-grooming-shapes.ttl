@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/core#> .
@prefix uco-identity: <https://ontology.unifiedcyberontology.org/identity#> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/action#> .
@prefix uco-role: <https://ontology.unifiedcyberontology.org/role#> .
@prefix case-investigation: <https://ontology.caseontology.org/case/investigation#> .
@prefix icac: <https://ontology.unifiedcyberontology.org/icac#> .
@prefix icac-grooming: <https://ontology.unifiedcyberontology.org/icac/grooming#> .

# =============================================================================
# GROOMING BEHAVIOR SHAPES
# =============================================================================

icac-grooming:GroomingBehaviorShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:GroomingBehavior ;
    rdfs:label "Grooming Behavior Shape"@en ;
    rdfs:comment "Validation shape for grooming behavior instances."@en ;
    sh:property [
        sh:path icac-grooming:groomingStage ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "initial_contact" "trust_building" "isolation" "dependency_creation" "sexual_introduction" "maintenance" "control" ) ;
        sh:message "Grooming behavior must specify grooming stage from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:behaviorType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "attention_giving" "gift_giving" "special_treatment" "isolation_tactics" "boundary_testing" "sexual_content_introduction" "secrecy_enforcement" "threat_making" ) ;
        sh:message "Grooming behavior must specify behavior type from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:behaviorFrequency ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "single_occurrence" "occasional" "frequent" "daily" "multiple_daily" "constant" ) ;
        sh:message "Behavior frequency must be from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:behaviorIntensity ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "low" "moderate" "high" "extreme" "overwhelming" ) ;
        sh:message "Behavior intensity must be from the allowed list."@en
    ] ;
    sh:property [
        sh:path uco-core:startTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:message "Grooming behavior may have a start time."@en
    ] ;
    sh:property [
        sh:path uco-core:endTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:message "Grooming behavior may have an end time."@en
    ] .

icac-grooming:TrustBuildingShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:TrustBuilding ;
    rdfs:label "Trust Building Shape"@en ;
    rdfs:comment "Validation shape for trust building behavior instances."@en ;
    sh:property [
        sh:path icac-grooming:trustBuildingMethod ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "active_listening" "emotional_support" "shared_interests" "special_attention" "gift_giving" "privilege_granting" "secret_sharing" "understanding_persona" ) ;
        sh:message "Trust building must specify method from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:trustLevel ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "minimal" "developing" "moderate" "strong" "complete" "absolute" ) ;
        sh:message "Trust level must be from the allowed list."@en
    ] .

icac-grooming:IsolationTacticsShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:IsolationTactics ;
    rdfs:label "Isolation Tactics Shape"@en ;
    rdfs:comment "Validation shape for isolation tactics instances."@en ;
    sh:property [
        sh:path icac-grooming:isolationMethod ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "physical_separation" "emotional_manipulation" "relationship_interference" "activity_restriction" "communication_control" "social_undermining" "dependency_creation" ) ;
        sh:message "Isolation tactics must specify method from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:isolationEffectiveness ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "ineffective" "partially_effective" "effective" "highly_effective" "complete" ) ;
        sh:message "Isolation effectiveness must be from the allowed list."@en
    ] .

icac-grooming:BoundaryTestingShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:BoundaryTesting ;
    rdfs:label "Boundary Testing Shape"@en ;
    rdfs:comment "Validation shape for boundary testing behavior instances."@en ;
    sh:property [
        sh:path icac-grooming:boundaryType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "physical" "emotional" "sexual" "privacy" "authority" "social" "digital" ) ;
        sh:message "Boundary testing must specify boundary type from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:testingMethod ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "gradual_escalation" "sudden_violation" "repeated_testing" "permission_seeking" "normalization" "desensitization" ) ;
        sh:message "Boundary testing must specify testing method from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:victimResponse ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "resistance" "acceptance" "confusion" "compliance" "withdrawal" "normalization" ) ;
        sh:message "Victim response must be from the allowed list."@en
    ] .

# =============================================================================
# VICTIM VULNERABILITY SHAPES
# =============================================================================

icac-grooming:VictimVulnerabilityShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:VictimVulnerability ;
    rdfs:label "Victim Vulnerability Shape"@en ;
    rdfs:comment "Validation shape for victim vulnerability instances."@en ;
    sh:property [
        sh:path icac-grooming:vulnerabilityType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "emotional" "social" "economic" "physical" "psychological" "developmental" "situational" "digital" ) ;
        sh:message "Victim vulnerability must specify vulnerability type from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:vulnerabilityLevel ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "low" "moderate" "high" "severe" "extreme" "critical" ) ;
        sh:message "Victim vulnerability must specify vulnerability level from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:vulnerabilityDuration ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 20.0 ;
        sh:message "Vulnerability duration must be between 0 and 20 years."@en
    ] .

icac-grooming:EmotionalVulnerabilityShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:EmotionalVulnerability ;
    rdfs:label "Emotional Vulnerability Shape"@en ;
    rdfs:comment "Validation shape for emotional vulnerability instances."@en ;
    sh:property [
        sh:path icac-grooming:emotionalState ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "loneliness" "depression" "anxiety" "low_self_esteem" "anger" "confusion" "grief" "trauma_response" ) ;
        sh:message "Emotional vulnerability must specify emotional state from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:emotionalNeed ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "attention" "validation" "acceptance" "love" "security" "understanding" "belonging" "control" ) ;
        sh:message "Emotional need must be from the allowed list."@en
    ] .

icac-grooming:SocialVulnerabilityShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:SocialVulnerability ;
    rdfs:label "Social Vulnerability Shape"@en ;
    rdfs:comment "Validation shape for social vulnerability instances."@en ;
    sh:property [
        sh:path icac-grooming:socialIsolation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "none" "mild" "moderate" "severe" "complete" "self_imposed" ) ;
        sh:message "Social vulnerability must specify isolation level from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:socialSupport ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "strong" "adequate" "limited" "minimal" "absent" "dysfunctional" ) ;
        sh:message "Social support must be from the allowed list."@en
    ] .

# =============================================================================
# ESCALATION PATTERN SHAPES
# =============================================================================

icac-grooming:EscalationPatternShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:EscalationPattern ;
    rdfs:label "Escalation Pattern Shape"@en ;
    rdfs:comment "Validation shape for escalation pattern instances."@en ;
    sh:property [
        sh:path icac-grooming:escalationType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "gradual" "rapid" "stepped" "cyclical" "irregular" "sudden" "systematic" ) ;
        sh:message "Escalation pattern must specify escalation type from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:escalationSpeed ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "very_slow" "slow" "moderate" "fast" "very_fast" "immediate" ) ;
        sh:message "Escalation pattern must specify escalation speed from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:escalationDuration ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 365.0 ;
        sh:message "Escalation duration must be between 0 and 365 days."@en
    ] ;
    sh:property [
        sh:path icac-grooming:patternConfidence ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "Pattern confidence must be between 0.0 and 1.0."@en
    ] .

icac-grooming:OnlineToOfflineProgressionShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:OnlineToOfflineProgression ;
    rdfs:label "Online to Offline Progression Shape"@en ;
    rdfs:comment "Validation shape for online to offline progression instances."@en ;
    sh:property [
        sh:path icac-grooming:progressionDuration ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1 ;
        sh:maxInclusive 365 ;
        sh:message "Online to offline progression duration must be between 1 and 365 days."@en
    ] ;
    sh:property [
        sh:path icac-grooming:progressionStages ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minInclusive 2 ;
        sh:maxInclusive 10 ;
        sh:message "Progression stages must be between 2 and 10 when specified."@en
    ] .

# =============================================================================
# COMMUNICATION TACTICS SHAPES
# =============================================================================

icac-grooming:CommunicationTacticsShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:CommunicationTactics ;
    rdfs:label "Communication Tactics Shape"@en ;
    rdfs:comment "Validation shape for communication tactics instances."@en ;
    sh:property [
        sh:path icac-grooming:communicationMethod ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "text_messaging" "voice_calls" "video_calls" "social_media" "gaming_platforms" "email" "anonymous_chat" "encrypted_messaging" ) ;
        sh:message "Communication tactics must specify method from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:communicationFrequency ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "sporadic" "weekly" "daily" "multiple_daily" "constant" "on_demand" ) ;
        sh:message "Communication frequency must be from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:communicationTone ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "friendly" "caring" "romantic" "sexual" "threatening" "manipulative" "controlling" ) ;
        sh:message "Communication tone must be from the allowed list."@en
    ] .

icac-grooming:AnonymousPlatformContactShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:AnonymousPlatformContact ;
    rdfs:label "Anonymous Platform Contact Shape"@en ;
    rdfs:comment "Validation shape for anonymous platform contact instances."@en ;
    sh:property [
        sh:path icac-grooming:platformAnonymityLevel ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "partial_anonymous" "full_anonymous" "pseudonymous" "temporary_anonymous" "verified_anonymous" ) ;
        sh:message "Anonymous platform contact must specify anonymity level from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:identityVerificationRequired ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Anonymous platform contact must specify if identity verification is required."@en
    ] .

# =============================================================================
# PREDATORY COMMUNICATION SHAPES
# =============================================================================

icac-grooming:PredatoryCommunicationShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:PredatoryCommunication ;
    rdfs:label "Predatory Communication Shape"@en ;
    rdfs:comment "Validation shape for predatory communication instances."@en ;
    sh:property [
        sh:path icac-grooming:predatoryTactic ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "flattery" "sympathy" "shared_interests" "age_deception" "authority_claim" "special_relationship" "secrecy_request" "threat_implicit" "threat_explicit" ) ;
        sh:message "Predatory communication must specify tactic from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:manipulationLevel ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "subtle" "moderate" "obvious" "aggressive" "extreme" "coercive" ) ;
        sh:message "Predatory communication must specify manipulation level from the allowed list."@en
    ] .

icac-grooming:SexualContentIntroductionShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:SexualContentIntroduction ;
    rdfs:label "Sexual Content Introduction Shape"@en ;
    rdfs:comment "Validation shape for sexual content introduction instances."@en ;
    sh:property [
        sh:path icac-grooming:contentType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "sexual_conversation" "sexual_images" "sexual_videos" "sexual_questions" "sexual_education" "sexual_games" "sexual_requests" ) ;
        sh:message "Sexual content introduction must specify content type from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-grooming:introductionMethod ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "gradual" "sudden" "educational_guise" "game_format" "curiosity_appeal" "normalization" "peer_pressure" ) ;
        sh:message "Sexual content introduction must specify introduction method from the allowed list."@en
    ] .

# =============================================================================
# PHYSICAL MEETING ARRANGEMENT SHAPES
# =============================================================================

icac-grooming:PhysicalMeetingArrangementShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:PhysicalMeetingArrangement ;
    rdfs:label "Physical Meeting Arrangement Shape"@en ;
    rdfs:comment "Validation shape for physical meeting arrangement instances."@en ;
    sh:property [
        sh:path icac-grooming:meetingLocationSpecified ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Physical meeting arrangement must specify if meeting location is specified."@en
    ] ;
    sh:property [
        sh:path icac-grooming:meetingTimeSpecified ;
        sh:datatype xsd:boolean ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:message "Physical meeting arrangement may specify if meeting time is specified."@en
    ] ;
    sh:property [
        sh:path icac-grooming:meetingPurpose ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "social" "romantic" "sexual" "educational" "recreational" "deceptive" "unspecified" ) ;
        sh:message "Meeting purpose must be from the allowed list."@en
    ] .

icac-grooming:InterstateTransportPlanShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:InterstateTransportPlan ;
    rdfs:label "Interstate Transport Plan Shape"@en ;
    rdfs:comment "Validation shape for interstate transport plan instances."@en ;
    sh:property [
        sh:path icac-grooming:crossesStateBoundaries ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Interstate transport plan must cross state boundaries."@en
    ] ;
    sh:property [
        sh:path icac-grooming:transportationMethod ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "vehicle" "public_transport" "flight" "train" "bus" "ride_share" "walking" ) ;
        sh:message "Transportation method must be from the allowed list."@en
    ] .

# =============================================================================
# OBJECT PROPERTY SHAPES
# =============================================================================

icac-grooming:TargetsVictimShape rdf:type sh:PropertyShape ;
    sh:path icac-grooming:targetsVictim ;
    sh:name "targets victim" ;
    sh:description "Links grooming behavior to victim being targeted" ;
    sh:class uco-identity:Person ;
    sh:minCount 0 .

icac-grooming:ExploitsVulnerabilityShape rdf:type sh:PropertyShape ;
    sh:path icac-grooming:exploitsVulnerability ;
    sh:name "exploits vulnerability" ;
    sh:description "Links grooming to victim vulnerability being exploited" ;
    sh:class icac-grooming:VictimVulnerability ;
    sh:minCount 0 .

icac-grooming:FollowsPatternShape rdf:type sh:PropertyShape ;
    sh:path icac-grooming:followsPattern ;
    sh:name "follows pattern" ;
    sh:description "Links grooming to escalation pattern followed" ;
    sh:class icac-grooming:EscalationPattern ;
    sh:minCount 0 .

icac-grooming:UsesCommunicationShape rdf:type sh:PropertyShape ;
    sh:path icac-grooming:usesCommunication ;
    sh:name "uses communication" ;
    sh:description "Links grooming to communication tactics used" ;
    sh:class icac-grooming:CommunicationTactics ;
    sh:minCount 0 .

icac-grooming:LeadsToMeetingShape rdf:type sh:PropertyShape ;
    sh:path icac-grooming:leadsToMeeting ;
    sh:name "leads to meeting" ;
    sh:description "Links grooming to physical meeting arrangement" ;
    sh:class icac-grooming:PhysicalMeetingArrangement ;
    sh:minCount 0 .

icac-grooming:PrimaryPlatformShape rdf:type sh:PropertyShape ;
    sh:path icac-grooming:primaryPlatform ;
    sh:name "primary platform" ;
    sh:description "Links contact to primary platform used" ;
    sh:class uco-core:UcoObject ;
    sh:minCount 0 .

# =============================================================================
# CROSS-REFERENCE VALIDATION SHAPES
# =============================================================================

icac-grooming:GroomingCrossReferenceShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:GroomingBehavior ;
    rdfs:label "Grooming Cross Reference Shape"@en ;
    rdfs:comment "Validates cross-references between grooming and related entities."@en ;
    sh:sparql [
        sh:message "Grooming behavior should target at least one victim."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this a icac-grooming:GroomingBehavior .
                FILTER NOT EXISTS {
                    $this icac-grooming:targetsVictim ?victim .
                }
            }
        """
    ] .

icac-grooming:EscalationConsistencyShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:EscalationPattern ;
    rdfs:label "Escalation Consistency Shape"@en ;
    rdfs:comment "Validates escalation pattern consistency."@en ;
    sh:sparql [
        sh:message "Rapid escalation should have short duration."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this icac-grooming:escalationSpeed "very_fast" ;
                      icac-grooming:escalationDuration ?duration .
                FILTER (?duration > 30.0)
            }
        """
    ] .

# =============================================================================
# TEMPORAL VALIDATION SHAPES
# =============================================================================

icac-grooming:TemporalValidationShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:GroomingBehavior ;
    rdfs:label "Temporal Validation Shape"@en ;
    rdfs:comment "Validates temporal consistency in grooming behaviors."@en ;
    sh:sparql [
        sh:message "Start time must be before end time when both are specified."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this uco-core:startTime ?start ;
                      uco-core:endTime ?end .
                FILTER (?start >= ?end)
            }
        """
    ] .

# =============================================================================
# DATA QUALITY SHAPES
# =============================================================================

icac-grooming:DataQualityShape rdf:type sh:NodeShape ;
    sh:targetClass icac-grooming:GroomingBehavior ;
    rdfs:label "Data Quality Shape"@en ;
    rdfs:comment "Validates data quality for grooming behaviors."@en ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minLength 5 ;
        sh:maxLength 200 ;
        sh:message "Label should be between 5 and 200 characters when provided."@en
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minLength 10 ;
        sh:maxLength 1000 ;
        sh:message "Comment should be between 10 and 1000 characters when provided."@en
    ] . 