# EDUCATOR SENTENCING RELATIONSHIPS
# =============================================================================

icac-sentencing:requiresPostConvictionRequirement rdf:type owl:ObjectProperty ;
    rdfs:label "requires post conviction requirement"@en ;
    rdfs:comment "Links sentencing to post-conviction requirements imposed."@en ;
    rdfs:domain icac-sentencing:EducatorSentencing ;
    rdfs:range icac-sentencing:PostConvictionRequirement .

icac-sentencing:involvesEducationalInstitution rdf:type owl:ObjectProperty ;
