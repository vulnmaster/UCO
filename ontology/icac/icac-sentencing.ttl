icac-sentencing:communityImpactLevel rdf:type owl:DatatypeProperty ;
    rdfs:label "community impact level"@en ;
    rdfs:comment "Level of community impact (local, institutional, widespread)."@en ;
    rdfs:domain icac-sentencing:CommunityImpactSentencing ;
    rdfs:range xsd:string .

icac-sentencing:victimTraumaSparing rdf:type owl:DatatypeProperty ;
