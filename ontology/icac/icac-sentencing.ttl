    rdfs:comment "Sentencing for child exploitation committed by educational personnel."@en ;
    rdfs:subClassOf icac-sentencing:ICACOffenseSentencing .

icac-sentencing:PositionOfTrustSentencing rdf:type owl:Class ;
    rdfs:label "Position of Trust Sentencing"@en ;
    rdfs:comment "Sentencing with enhancement for abuse of position of trust in educational setting."@en ;
    rdfs:subClassOf icac-sentencing:EducatorSentencing .

icac-sentencing:UseOfChildInSexualPerformanceSentencing rdf:type owl:Class ;
    rdfs:label "Use of Child in Sexual Performance Sentencing"@en ;
    rdfs:comment "Sentencing for use of child in sexual performance as sexually motivated felony."@en ;
    rdfs:subClassOf icac-sentencing:EducatorSentencing .

icac-sentencing:EndangeringWelfareOfChildSentencing rdf:type owl:Class ;
    rdfs:label "Endangering Welfare of Child Sentencing"@en ;
    rdfs:comment "Sentencing for endangering welfare of children through exploitation."@en ;
    rdfs:subClassOf icac-sentencing:EducatorSentencing .

icac-sentencing:SexuallyMotivatedFelonySentencing rdf:type owl:Class ;
    rdfs:label "Sexually Motivated Felony Sentencing"@en ;
    rdfs:comment "Sentencing for felony with sexual motivation enhancement."@en ;
    rdfs:subClassOf icac-sentencing:EducatorSentencing .

# =============================================================================
# POST-CONVICTION REQUIREMENTS
# =============================================================================

icac-sentencing:PostConvictionRequirement rdf:type owl:Class ;
    rdfs:label "Post Conviction Requirement"@en ;
    rdfs:comment "Requirements imposed following conviction for child exploitation."@en ;
    rdfs:subClassOf uco-action:Action .

icac-sentencing:ExtendedPostReleaseSupervision rdf:type owl:Class ;
    rdfs:label "Extended Post Release Supervision"@en ;
    rdfs:comment "Extended supervision period following incarceration for child exploitation."@en ;
    rdfs:subClassOf icac-sentencing:PostConvictionRequirement .

icac-sentencing:MandatorySexOffenderRegistration rdf:type owl:Class ;
    rdfs:label "Mandatory Sex Offender Registration"@en ;
    rdfs:comment "Mandatory registration as sex offender following conviction."@en ;
    rdfs:subClassOf icac-sentencing:PostConvictionRequirement .

icac-sentencing:EducationalEmploymentProhibition rdf:type owl:Class ;
    rdfs:label "Educational Employment Prohibition"@en ;
    rdfs:comment "Prohibition from employment in educational institutions."@en ;
    rdfs:subClassOf icac-sentencing:PostConvictionRequirement .

icac-sentencing:DigitalCommunicationRestriction rdf:type owl:Class ;
    rdfs:label "Digital Communication Restriction"@en ;
    rdfs:comment "Restrictions on digital communication with minors."@en ;
    rdfs:subClassOf icac-sentencing:PostConvictionRequirement .

icac-sentencing:InternetAccessRestriction rdf:type owl:Class ;
