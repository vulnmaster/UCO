    rdfs:comment "Sentencing considering impact on educational institution and community trust."@en ;
    rdfs:subClassOf icac-sentencing:EducatorSentencing .

icac-sentencing:TrustViolationSentencing rdf:type owl:Class ;
    rdfs:label "Trust Violation Sentencing"@en ;
    rdfs:comment "Sentencing enhancement for violation of public trust in educational role."@en ;
    rdfs:subClassOf icac-sentencing:InstitutionalImpactSentencing .

icac-sentencing:CommunityImpactSentencing rdf:type owl:Class ;
    rdfs:label "Community Impact Sentencing"@en ;
    rdfs:comment "Sentencing considering broader community impact of educator exploitation."@en ;
    rdfs:subClassOf icac-sentencing:InstitutionalImpactSentencing .

