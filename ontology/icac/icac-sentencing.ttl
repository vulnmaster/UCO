# =============================================================================
# MULTI-AGENCY PROSECUTION FRAMEWORK (Illinois Analysis)
# =============================================================================

icac-sentencing:MultiAgencyProsecution rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Multi-Agency Prosecution"@en ;
    rdfs:comment "Prosecution conducted jointly by multiple prosecutorial agencies."@en .

icac-sentencing:CoProsecution rdf:type owl:Class ;
    rdfs:subClassOf icac-sentencing:MultiAgencyProsecution ;
    rdfs:label "Co-Prosecution"@en ;
    rdfs:comment "Joint prosecution where multiple agencies share responsibility and resources."@en .

icac-sentencing:StateAttorneyGeneralProsecution rdf:type owl:Class ;
    rdfs:subClassOf icac-sentencing:MultiAgencyProsecution ;
    rdfs:label "State Attorney General Prosecution"@en ;
    rdfs:comment "Prosecution led by state Attorney General office with specialized capabilities."@en .

icac-sentencing:CountyStateProsecution rdf:type owl:Class ;
    rdfs:subClassOf icac-sentencing:MultiAgencyProsecution ;
    rdfs:label "County State Prosecution"@en ;
    rdfs:comment "Prosecution led by county state's attorney office with local jurisdiction."@en .

# =============================================================================
# SPECIALIZED PROSECUTION UNITS (Illinois Framework)
# =============================================================================

icac-sentencing:HighTechCrimesBureau rdf:type owl:Class ;
    rdfs:subClassOf uco-identity:Organization ;
    rdfs:label "High Tech Crimes Bureau"@en ;
    rdfs:comment "Specialized prosecution unit within Attorney General office for technology-related crimes."@en .

icac-sentencing:StateAttorneyGeneralOffice rdf:type owl:Class ;
    rdfs:subClassOf uco-identity:Organization ;
    rdfs:label "State Attorney General Office"@en ;
    rdfs:comment "State-level prosecution agency headed by elected Attorney General."@en .

icac-sentencing:CountyStatesAttorneyOffice rdf:type owl:Class ;
    rdfs:subClassOf uco-identity:Organization ;
    rdfs:label "County State's Attorney Office"@en ;
    rdfs:comment "County-level prosecution agency responsible for local prosecution."@en .

icac-sentencing:AssistantAttorneyGeneral rdf:type owl:Class ;
    rdfs:subClassOf icac-sentencing:Prosecutor ;
    rdfs:label "Assistant Attorney General"@en ;
    rdfs:comment "Attorney working within state Attorney General office prosecuting cases."@en .

# =============================================================================
# DETENTION AND COURT SCHEDULING (Illinois Case Model)
# =============================================================================

icac-sentencing:PreTrialDetention rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Pre-Trial Detention"@en ;
    rdfs:comment "Detention of defendant pending trial proceedings."@en .

icac-sentencing:CourtScheduling rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Court Scheduling"@en ;
    rdfs:comment "Scheduling of court proceedings and hearings."@en .

icac-sentencing:CountyJail rdf:type owl:Class ;
    rdfs:subClassOf uco-location:Location ;
    rdfs:label "County Jail"@en ;
    rdfs:comment "County-level detention facility for pre-trial and short-term inmates."@en .

# =============================================================================
# ENHANCED CHARGE PROPERTIES (Illinois Framework)
# =============================================================================

icac-sentencing:chargeClassification rdf:type owl:ObjectProperty ;
    rdfs:domain icac-sentencing:CriminalCharge ;
    rdfs:range icac-sentencing:StateChargeClassification ;
    rdfs:label "charge classification"@en ;
    rdfs:comment "State-specific classification of criminal charge."@en .

icac-sentencing:maximumSentenceYears rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-sentencing:CriminalCharge ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "maximum sentence years"@en ;
    rdfs:comment "Maximum prison sentence in years for charge classification."@en .

icac-sentencing:minimumSentenceYears rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-sentencing:CriminalCharge ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "minimum sentence years"@en ;
    rdfs:comment "Minimum prison sentence in years for charge classification."@en .

icac-sentencing:chargeCount rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-sentencing:CriminalCharge ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "charge count"@en ;
    rdfs:comment "Number of counts for this type of charge."@en .

icac-sentencing:victimAgeAtOffense rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-sentencing:CriminalCharge ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "victim age at offense"@en ;
    rdfs:comment "Age of victim at time of offense (relevant for charge severity)."@en .

# Multi-Agency Prosecution Properties
icac-sentencing:coProsecutedBy rdf:type owl:ObjectProperty ;
    rdfs:domain icac-sentencing:CoProsecution ;
    rdfs:range uco-identity:Organization ;
    rdfs:label "co-prosecuted by"@en ;
    rdfs:comment "Organization participating in co-prosecution."@en .

icac-sentencing:leadProsecutor rdf:type owl:ObjectProperty ;
    rdfs:domain icac-sentencing:MultiAgencyProsecution ;
    rdfs:range uco-identity:Organization ;
    rdfs:label "lead prosecutor"@en ;
    rdfs:comment "Primary prosecutorial agency leading the case."@en .

icac-sentencing:supportingProsecutor rdf:type owl:ObjectProperty ;
    rdfs:domain icac-sentencing:MultiAgencyProsecution ;
    rdfs:range uco-identity:Organization ;
    rdfs:label "supporting prosecutor"@en ;
    rdfs:comment "Secondary prosecutorial agency providing support."@en .

icac-sentencing:prosecutionType rdf:type owl:ObjectProperty ;
    rdfs:domain icac-sentencing:CriminalCharge ;
    rdfs:range icac-sentencing:MultiAgencyProsecution ;
    rdfs:label "prosecution type"@en ;
    rdfs:comment "Type of prosecution effort handling the criminal charges."@en .

icac-sentencing:handledByBureau rdf:type owl:ObjectProperty ;
    rdfs:domain icac-sentencing:MultiAgencyProsecution ;
    rdfs:range icac-sentencing:HighTechCrimesBureau ;
    rdfs:label "handled by bureau"@en ;
    rdfs:comment "Specialized bureau within prosecution office handling the case."@en .

# Detention and Scheduling Properties
icac-sentencing:detainedAt rdf:type owl:ObjectProperty ;
    rdfs:domain icac-sentencing:PreTrialDetention ;
    rdfs:range uco-location:Location ;
    rdfs:label "detained at"@en ;
    rdfs:comment "Location where defendant is detained."@en .

icac-sentencing:nextCourtDate rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-sentencing:CourtScheduling ;
    rdfs:range xsd:dateTime ;
    rdfs:label "next court date"@en ;
    rdfs:comment "Date and time of next scheduled court proceeding."@en .

icac-sentencing:detentionStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-sentencing:PreTrialDetention ;
    rdfs:range xsd:string ;
    rdfs:label "detention status"@en ;
    rdfs:comment "Current detention status (detained, released, bond, etc.)."@en .

# Evidence Discovery Properties
icac-sentencing:evidenceFoundOnDevice rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-sentencing:CriminalCharge ;
    rdfs:range xsd:boolean ;
    rdfs:label "evidence found on device"@en ;
    rdfs:comment "Whether evidence was found on electronic device."@en .

icac-sentencing:evidenceFoundOnSocialMedia rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-sentencing:CriminalCharge ;
    rdfs:range xsd:boolean ;
    rdfs:label "evidence found on social media"@en ;
    rdfs:comment "Whether evidence was found on social media accounts."@en .

# =============================================================================
# SEX TRAFFICKING CHARGES AND SENTENCING (Brooklyn Case Enhancement)
# =============================================================================

icac-sentencing:SexTraffickingOfMinor rdf:type owl:Class ;
    rdfs:label "Sex Trafficking of Minor"@en ;
    rdfs:comment "Federal or state charge for sex trafficking of a person under 18 years of age."@en ;
    rdfs:subClassOf icac-sentencing:FederalCharge .

icac-sentencing:SexTraffickingConspiracy rdf:type owl:Class ;
    rdfs:label "Sex Trafficking Conspiracy"@en ;
    rdfs:comment "Conspiracy charge for coordinated sex trafficking enterprise involving multiple defendants."@en ;
    rdfs:subClassOf icac-sentencing:FederalCharge .

icac-sentencing:PromotingProstitution rdf:type owl:Class ;
    rdfs:label "Promoting Prostitution"@en ;
    rdfs:comment "State charge for promoting or facilitating prostitution, often used in trafficking cases."@en ;
    rdfs:subClassOf icac-sentencing:StateCharge .

icac-sentencing:PromotingProstitutionOfMinor rdf:type owl:Class ;
    rdfs:label "Promoting Prostitution of Minor"@en ;
    rdfs:comment "Enhanced charge for promoting prostitution involving victims under 18."@en ;
    rdfs:subClassOf icac-sentencing:PromotingProstitution .

icac-sentencing:InterstateTransportationForProstitution rdf:type owl:Class ;
    rdfs:label "Interstate Transportation for Prostitution"@en ;
    rdfs:comment "Federal charge for transporting individuals across state lines for prostitution (Mann Act)."@en ;
    rdfs:subClassOf icac-sentencing:FederalCharge .

icac-sentencing:CoercingProstitution rdf:type owl:Class ;
    rdfs:label "Coercing Prostitution"@en ;
    rdfs:comment "Charge for using force, fraud, or coercion to compel prostitution."@en ;
    rdfs:subClassOf icac-sentencing:StateCharge .

icac-sentencing:MoneyLaunderingTraffickingProceeds rdf:type owl:Class ;
    rdfs:label "Money Laundering Trafficking Proceeds"@en ;
    rdfs:comment "Charge for laundering money obtained from sex trafficking operations."@en ;
    rdfs:subClassOf icac-sentencing:FederalCharge .

icac-sentencing:TraffickingRelatedEnterprise rdf:type owl:Class ;
    rdfs:label "Trafficking Related Enterprise"@en ;
    rdfs:comment "RICO charges for operating criminal enterprise engaged in sex trafficking."@en ;
    rdfs:subClassOf icac-sentencing:FederalCharge .

# Sentencing Enhancements for Trafficking
icac-sentencing:TraffickingEnhancement rdf:type owl:Class ;
    rdfs:label "Trafficking Enhancement"@en ;
    rdfs:comment "Sentencing enhancement applied to trafficking cases involving aggravating factors."@en ;
    rdfs:subClassOf icac-sentencing:SentencingEnhancement .

icac-sentencing:MultipleVictimEnhancement rdf:type owl:Class ;
    rdfs:label "Multiple Victim Enhancement"@en ;
    rdfs:comment "Enhancement for trafficking cases involving multiple victims."@en ;
    rdfs:subClassOf icac-sentencing:TraffickingEnhancement .

icac-sentencing:VictimVulnerabilityEnhancement rdf:type owl:Class ;
    rdfs:label "Victim Vulnerability Enhancement"@en ;
    rdfs:comment "Enhancement based on victim vulnerability (age, mental capacity, circumstances)."@en ;
    rdfs:subClassOf icac-sentencing:TraffickingEnhancement .

icac-sentencing:LeadershipRoleEnhancement rdf:type owl:Class ;
    rdfs:label "Leadership Role Enhancement"@en ;
    rdfs:comment "Enhancement for defendants who played leadership role in trafficking enterprise."@en ;
    rdfs:subClassOf icac-sentencing:TraffickingEnhancement .

# =============================================================================
# MULTI-DEFENDANT SENTENCING FRAMEWORK
# =============================================================================

icac-sentencing:MultiDefendantSentencing rdf:type owl:Class ;
    rdfs:label "Multi-Defendant Sentencing"@en ;
    rdfs:comment "Sentencing coordination for cases involving multiple defendants in same criminal enterprise."@en ;
    rdfs:subClassOf icac-sentencing:CriminalSentence .

icac-sentencing:CoDefendantSentencing rdf:type owl:Class ;
    rdfs:label "Co-Defendant Sentencing"@en ;
    rdfs:comment "Sentencing of co-defendants in coordinated criminal enterprise with consideration of relative culpability."@en ;
    rdfs:subClassOf icac-sentencing:MultiDefendantSentencing .

icac-sentencing:SentencingDisparity rdf:type owl:Class ;
    rdfs:label "Sentencing Disparity"@en ;
    rdfs:comment "Difference in sentences between co-defendants based on role, cooperation, or other factors."@en ;
    rdfs:subClassOf uco-core:UcoObject .

icac-sentencing:PleaBargainSentencing rdf:type owl:Class ;
    rdfs:label "Plea Bargain Sentencing"@en ;
    rdfs:comment "Sentencing resulting from plea agreement, often involving cooperation with prosecution."@en ;
    rdfs:subClassOf icac-sentencing:CriminalSentence .

# =============================================================================
# TRAFFICKING SENTENCING PROPERTIES
# =============================================================================

# Trafficking-Specific Properties
icac-sentencing:traffickingVictimCount rdf:type owl:DatatypeProperty ;
    rdfs:label "trafficking victim count"@en ;
    rdfs:comment "Number of trafficking victims involved in charges (affects sentencing)."@en ;
    rdfs:domain icac-sentencing:SexTraffickingOfMinor ;
    rdfs:range xsd:nonNegativeInteger .

icac-sentencing:commercialSexActCount rdf:type owl:DatatypeProperty ;
    rdfs:label "commercial sex act count"@en ;
    rdfs:comment "Number of commercial sex acts facilitated or coerced."@en ;
    rdfs:domain icac-sentencing:PromotingProstitution ;
    rdfs:range xsd:nonNegativeInteger .

icac-sentencing:traffickingDuration rdf:type owl:DatatypeProperty ;
    rdfs:label "trafficking duration"@en ;
    rdfs:comment "Duration of trafficking operation in months."@en ;
    rdfs:domain icac-sentencing:SexTraffickingOfMinor ;
    rdfs:range xsd:decimal .

icac-sentencing:enterpriseRole rdf:type owl:DatatypeProperty ;
    rdfs:label "enterprise role"@en ;
    rdfs:comment "Role in trafficking enterprise (leader, organizer, manager, member)."@en ;
    rdfs:domain icac-sentencing:TraffickingRelatedEnterprise ;
    rdfs:range xsd:string .

icac-sentencing:cooperationLevel rdf:type owl:DatatypeProperty ;
    rdfs:label "cooperation level"@en ;
    rdfs:comment "Level of cooperation with prosecution (substantial, limited, none)."@en ;
    rdfs:domain icac-sentencing:PleaBargainSentencing ;
    rdfs:range xsd:string .

# Multi-Defendant Properties
icac-sentencing:coDefendantCount rdf:type owl:DatatypeProperty ;
    rdfs:label "co-defendant count"@en ;
    rdfs:comment "Number of co-defendants in case (e.g., 8 in Brooklyn case)."@en ;
    rdfs:domain icac-sentencing:MultiDefendantSentencing ;
    rdfs:range xsd:nonNegativeInteger .

icac-sentencing:culpabilityRank rdf:type owl:DatatypeProperty ;
    rdfs:label "culpability rank"@en ;
    rdfs:comment "Relative culpability ranking among co-defendants (1 = most culpable)."@en ;
    rdfs:domain icac-sentencing:CoDefendantSentencing ;
    rdfs:range xsd:nonNegativeInteger .

icac-sentencing:sentenceVariance rdf:type owl:DatatypeProperty ;
    rdfs:label "sentence variance"@en ;
    rdfs:comment "Variance from guidelines in months (positive = above guidelines)."@en ;
    rdfs:domain icac-sentencing:CriminalSentence ;
    rdfs:range xsd:decimal .

# =============================================================================
# TRAFFICKING SENTENCING RELATIONSHIPS
# =============================================================================

# Charge Relationships
icac-sentencing:enhancedBy rdf:type owl:ObjectProperty ;
    rdfs:label "enhanced by"@en ;
    rdfs:comment "Links base charge to enhancement applied."@en ;
    rdfs:domain icac-sentencing:FederalCharge ;
    rdfs:range icac-sentencing:TraffickingEnhancement .

icac-sentencing:baseCharge rdf:type owl:ObjectProperty ;
    rdfs:label "base charge"@en ;
    rdfs:comment "Links enhancement to base charge it enhances."@en ;
    rdfs:domain icac-sentencing:TraffickingEnhancement ;
    rdfs:range icac-sentencing:FederalCharge .

# Multi-Defendant Relationships
icac-sentencing:coDefendantWith rdf:type owl:ObjectProperty ;
    rdfs:label "co-defendant with"@en ;
    rdfs:comment "Links defendant to their co-defendants in same case."@en ;
    rdfs:domain uco-identity:Person ;
    rdfs:range uco-identity:Person .

icac-sentencing:sentencedWith rdf:type owl:ObjectProperty ;
    rdfs:label "sentenced with"@en ;
    rdfs:comment "Links co-defendant sentencing to other co-defendants sentenced in same proceeding."@en ;
    rdfs:domain icac-sentencing:CoDefendantSentencing ;
    rdfs:range icac-sentencing:CoDefendantSentencing .

icac-sentencing:hasDisparity rdf:type owl:ObjectProperty ;
    rdfs:label "has disparity"@en ;
    rdfs:comment "Links co-defendant sentences to disparity analysis."@en ;
    rdfs:domain icac-sentencing:CoDefendantSentencing ;
    rdfs:range icac-sentencing:SentencingDisparity .

icac-sentencing:resultedFromPlea rdf:type owl:ObjectProperty ;
    rdfs:label "resulted from plea"@en ;
    rdfs:comment "Links sentence to plea bargain that resulted in it."@en ;
    rdfs:domain icac-sentencing:CriminalSentence ;
    rdfs:range icac-sentencing:PleaBargainSentencing .

# =============================================================================
# EDUCATOR-SPECIFIC SENTENCING (March 2025 Brooklyn Teacher Case)
# =============================================================================

icac-sentencing:EducatorSentencing rdf:type owl:Class ;
