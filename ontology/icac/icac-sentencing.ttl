    rdfs:comment "Restrictions on internet access and social media use."@en ;
    rdfs:subClassOf icac-sentencing:PostConvictionRequirement .

# =============================================================================
# INSTITUTIONAL IMPACT SENTENCING
# =============================================================================

icac-sentencing:InstitutionalImpactSentencing rdf:type owl:Class ;
