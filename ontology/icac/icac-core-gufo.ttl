@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/core#> .
@prefix uco-identity: <https://ontology.unifiedcyberontology.org/identity#> .
@prefix uco-observable: <https://ontology.unifiedcyberontology.org/observable#> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/action#> .
@prefix uco-role: <https://ontology.unifiedcyberontology.org/role#> .
@prefix uco-channel: <https://ontology.unifiedcyberontology.org/channel#> .
@prefix case-investigation: <https://ontology.caseontology.org/case/investigation#> .
@prefix icac: <https://ontology.unifiedcyberontology.org/icac#> .
@prefix icac-gufo: <https://ontology.unifiedcyberontology.org/icac/gufo#> .
@prefix hotline: <https://ontology.unifiedcyberontology.org/hotlines/2025/core#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .

# =============================================================================
# ONTOLOGY DECLARATION
# =============================================================================

<https://ontology.unifiedcyberontology.org/icac/gufo/1.0> rdf:type owl:Ontology ;
    rdfs:label "ICAC Core Ontology with gUFO Integration - Phase 1"@en ;
    rdfs:comment "Phase 1 gUFO integration for ICAC core ontology, focusing on investigation phases, role modeling, and action vs lifecycle distinction. Based on Unified Foundational Ontology (UFO) implementation."@en ;
    owl:versionIRI <https://ontology.unifiedcyberontology.org/icac/gufo/1.0> ;
    dcterms:creator "ICAC Ontology Team" ;
    dcterms:issued "2025-01-03"^^xsd:date ;
    dcterms:modified "2025-01-03"^^xsd:date ;
    dcterms:description "Phase 1 pilot integration of gUFO foundational concepts into ICAC core ontology. Introduces investigation phase modeling, enhanced role semantics, and action lifecycle distinction."@en ;
    owl:imports <https://ontology.unifiedcyberontology.org/core> ,
                <https://ontology.caseontology.org/case> ,
                <https://ontology.unifiedcyberontology.org/hotlines/2025/core> ,
                <http://purl.org/nemo/gufo> .

# =============================================================================
# PHASE 1: CORE INVESTIGATION MODELING WITH gUFO
# =============================================================================

# Base Investigation as Kind (rigid sortal providing identity)
icac-gufo:Investigation rdf:type owl:Class, gufo:Kind ;
    rdfs:label "Investigation"@en ;
    rdfs:comment "A child-protection investigation that follows standard lifecycle phases. Modeled as gUFO Kind providing identity criteria for all investigation instances."@en ;
    rdfs:subClassOf case-investigation:Investigation, gufo:Object .

# Investigation Phases (anti-rigid sortals based on intrinsic aspects)
icac-gufo:InitialPhase rdf:type owl:Class, gufo:Phase ;
    rdfs:label "Initial Investigation Phase"@en ;
    rdfs:comment "Initial phase of investigation beginning with cybertip receipt or hotline call. Phase applies based on intrinsic investigation state."@en ;
    rdfs:subClassOf icac-gufo:Investigation .

icac-gufo:AnalysisPhase rdf:type owl:Class, gufo:Phase ;
    rdfs:label "Analysis Investigation Phase"@en ;
    rdfs:comment "Analysis phase involving cybertip review and preliminary investigation. Phase applies based on intrinsic investigation state."@en ;
    rdfs:subClassOf icac-gufo:Investigation .

icac-gufo:LegalProcessPhase rdf:type owl:Class, gufo:Phase ;
    rdfs:label "Legal Process Investigation Phase"@en ;
    rdfs:comment "Legal process phase involving search warrants, subpoenas, and formal legal procedures. Phase applies based on intrinsic investigation state."@en ;
    rdfs:subClassOf icac-gufo:Investigation .

icac-gufo:EvidencePhase rdf:type owl:Class, gufo:Phase ;
    rdfs:label "Evidence Investigation Phase"@en ;
    rdfs:comment "Evidence phase involving digital forensics analysis and evidence review. Phase applies based on intrinsic investigation state."@en ;
    rdfs:subClassOf icac-gufo:Investigation .

icac-gufo:ResolutionPhase rdf:type owl:Class, gufo:Phase ;
    rdfs:label "Resolution Investigation Phase"@en ;
    rdfs:comment "Resolution phase involving victim rescue, prosecution, or case closure. Phase applies based on intrinsic investigation state."@en ;
    rdfs:subClassOf icac-gufo:Investigation .

icac-gufo:CompletedPhase rdf:type owl:Class, gufo:Phase ;
    rdfs:label "Completed Investigation Phase"@en ;
    rdfs:comment "Completed phase representing closed investigation with final outcomes. Phase applies based on intrinsic investigation state."@en ;
    rdfs:subClassOf icac-gufo:Investigation .

# =============================================================================
# PHASE 1: ENHANCED ROLE MODELING WITH gUFO
# =============================================================================

# Base Person as Kind (rigid sortal providing identity)
icac-gufo:Person rdf:type owl:Class, gufo:Kind ;
    rdfs:label "Person"@en ;
    rdfs:comment "A person involved in ICAC investigations. Modeled as gUFO Kind providing identity criteria for all person instances."@en ;
    rdfs:subClassOf uco-identity:Person, gufo:Object .

# Investigation Roles (anti-rigid sortals based on extrinsic aspects)
icac-gufo:InvestigatorRole rdf:type owl:Class, gufo:Role ;
    rdfs:label "Investigator Role"@en ;
    rdfs:comment "Role of person conducting ICAC investigation. Role applies based on extrinsic relationship to investigation context."@en ;
    rdfs:subClassOf icac-gufo:Person .

icac-gufo:VictimRole rdf:type owl:Class, gufo:Role ;
    rdfs:label "Victim Role"@en ;
    rdfs:comment "Role of person who is victim of child sexual abuse or exploitation. Role applies based on extrinsic relationship to abuse context."@en ;
    rdfs:subClassOf icac-gufo:Person .

icac-gufo:OffenderRole rdf:type owl:Class, gufo:Role ;
    rdfs:label "Offender Role"@en ;
    rdfs:comment "Role of person who commits child sexual abuse or exploitation. Role applies based on extrinsic relationship to criminal context."@en ;
    rdfs:subClassOf icac-gufo:Person .

icac-gufo:WitnessRole rdf:type owl:Class, gufo:Role ;
    rdfs:label "Witness Role"@en ;
    rdfs:comment "Role of person who provides testimony or evidence in investigation. Role applies based on extrinsic relationship to investigation context."@en ;
    rdfs:subClassOf icac-gufo:Person .

icac-gufo:InformantRole rdf:type owl:Class, gufo:Role ;
    rdfs:label "Informant Role"@en ;
    rdfs:comment "Role of person who provides intelligence information to investigators. Role applies based on extrinsic relationship to investigation context."@en ;
    rdfs:subClassOf icac-gufo:Person .

icac-gufo:RescuerRole rdf:type owl:Class, gufo:Role ;
    rdfs:label "Rescuer Role"@en ;
    rdfs:comment "Role of person involved in victim rescue and protection (law enforcement, NGO worker). Role applies based on extrinsic relationship to rescue context."@en ;
    rdfs:subClassOf icac-gufo:Person .

# =============================================================================
# PHASE 1: ACTION vs LIFECYCLE DISTINCTION WITH gUFO
# =============================================================================

# Investigation Actions as Events (concrete occurrences)
icac-gufo:ReceiveCybertipEvent rdf:type owl:Class ;
    rdfs:label "Receive Cybertip Event"@en ;
    rdfs:comment "Concrete event of receiving cybertip report from reporting entity. Modeled as gUFO Event with temporal boundaries."@en ;
    rdfs:subClassOf uco-action:Action, gufo:Event .

icac-gufo:ReviewCybertipEvent rdf:type owl:Class ;
    rdfs:label "Review Cybertip Event"@en ;
    rdfs:comment "Concrete event of reviewing and analyzing cybertip report by analyst. Modeled as gUFO Event with temporal boundaries."@en ;
    rdfs:subClassOf uco-action:Action, gufo:Event .

icac-gufo:LegalProcessEvent rdf:type owl:Class ;
    rdfs:label "Legal Process Event"@en ;
    rdfs:comment "Concrete event of executing legal process (search warrant, subpoena). Modeled as gUFO Event with temporal boundaries."@en ;
    rdfs:subClassOf uco-action:Action, gufo:Event .

icac-gufo:EvidenceReviewEvent rdf:type owl:Class ;
    rdfs:label "Evidence Review Event"@en ;
    rdfs:comment "Concrete event of reviewing and analyzing digital evidence. Modeled as gUFO Event with temporal boundaries."@en ;
    rdfs:subClassOf uco-action:Action, gufo:Event .

icac-gufo:VictimRescueEvent rdf:type owl:Class ;
    rdfs:label "Victim Rescue Event"@en ;
    rdfs:comment "Concrete event of rescuing and providing support to identified victims. Modeled as gUFO Event with temporal boundaries."@en ;
    rdfs:subClassOf uco-action:Action, gufo:Event .

# Investigation Lifecycle States as Situations (states that hold)
icac-gufo:InvestigationPendingSituation rdf:type owl:Class ;
    rdfs:label "Investigation Pending Situation"@en ;
    rdfs:comment "Situation where investigation is pending initiation or analyst assignment. Modeled as gUFO Situation representing state."@en ;
    rdfs:subClassOf gufo:Situation .

icac-gufo:InvestigationActiveSituation rdf:type owl:Class ;
    rdfs:label "Investigation Active Situation"@en ;
    rdfs:comment "Situation where investigation is actively being conducted. Modeled as gUFO Situation representing state."@en ;
    rdfs:subClassOf gufo:Situation .

icac-gufo:InvestigationSuspendedSituation rdf:type owl:Class ;
    rdfs:label "Investigation Suspended Situation"@en ;
    rdfs:comment "Situation where investigation is temporarily suspended pending resources or information. Modeled as gUFO Situation representing state."@en ;
    rdfs:subClassOf gufo:Situation .

icac-gufo:InvestigationClosedSituation rdf:type owl:Class ;
    rdfs:label "Investigation Closed Situation"@en ;
    rdfs:comment "Situation where investigation is closed with final determination. Modeled as gUFO Situation representing state."@en ;
    rdfs:subClassOf gufo:Situation .

# =============================================================================
# PHASE 1: CRIMINAL EVENT MODELING WITH gUFO
# =============================================================================

# Base Criminal Event as Kind
icac-gufo:ChildSexualAbuseEvent rdf:type owl:Class, gufo:Kind ;
    rdfs:label "Child Sexual Abuse Event"@en ;
    rdfs:comment "Base kind for events involving child sexual abuse or exploitation. Modeled as gUFO Kind providing identity criteria."@en ;
    rdfs:subClassOf uco-action:Crime, gufo:Event .

# Specific Criminal Event Types as SubKinds
icac-gufo:CSAMIncident rdf:type owl:Class, gufo:SubKind ;
    rdfs:label "Child Sexual Abuse Material Incident"@en ;
    rdfs:comment "Incidents involving CSAM possession, manufacture, or distribution. Modeled as gUFO SubKind of ChildSexualAbuseEvent."@en ;
    rdfs:subClassOf icac-gufo:ChildSexualAbuseEvent .

icac-gufo:LiveStreamingCSA rdf:type owl:Class, gufo:SubKind ;
    rdfs:label "Live Streaming Child Sexual Abuse"@en ;
    rdfs:comment "Incidents involving live streaming of child sexual abuse. Modeled as gUFO SubKind of ChildSexualAbuseEvent."@en ;
    rdfs:subClassOf icac-gufo:ChildSexualAbuseEvent .

icac-gufo:GroomingSolicitation rdf:type owl:Class, gufo:SubKind ;
    rdfs:label "Grooming and Solicitation"@en ;
    rdfs:comment "Incidents involving grooming or solicitation of children. Modeled as gUFO SubKind of ChildSexualAbuseEvent."@en ;
    rdfs:subClassOf icac-gufo:ChildSexualAbuseEvent .

icac-gufo:Sextortion rdf:type owl:Class, gufo:SubKind ;
    rdfs:label "Sextortion"@en ;
    rdfs:comment "Incidents involving sexual extortion of children. Modeled as gUFO SubKind of ChildSexualAbuseEvent."@en ;
    rdfs:subClassOf icac-gufo:ChildSexualAbuseEvent .

# =============================================================================
# PHASE 1: TEMPORAL FRAMEWORK PROPERTIES
# =============================================================================

# Phase Transition Properties (using gUFO temporal framework)
icac-gufo:hasPhaseBeginPoint rdf:type owl:DatatypeProperty ;
    rdfs:label "has phase begin point"@en ;
    rdfs:comment "Temporal point when investigation phase begins. Extends gUFO temporal framework."@en ;
    rdfs:subPropertyOf gufo:hasBeginPointInXSDDateTimeStamp ;
    rdfs:domain gufo:Phase ;
    rdfs:range xsd:dateTimeStamp .

icac-gufo:hasPhaseEndPoint rdf:type owl:DatatypeProperty ;
    rdfs:label "has phase end point"@en ;
    rdfs:comment "Temporal point when investigation phase ends. Extends gUFO temporal framework."@en ;
    rdfs:subPropertyOf gufo:hasEndPointInXSDDateTimeStamp ;
    rdfs:domain gufo:Phase ;
    rdfs:range xsd:dateTimeStamp .

icac-gufo:phaseDuration rdf:type owl:DatatypeProperty ;
    rdfs:label "phase duration"@en ;
    rdfs:comment "Duration of investigation phase in ISO 8601 format."@en ;
    rdfs:domain gufo:Phase ;
    rdfs:range xsd:duration .

# Role Temporal Properties
icac-gufo:hasRoleBeginPoint rdf:type owl:DatatypeProperty ;
    rdfs:label "has role begin point"@en ;
    rdfs:comment "Temporal point when person assumes role in investigation. Extends gUFO temporal framework."@en ;
    rdfs:subPropertyOf gufo:hasBeginPointInXSDDateTimeStamp ;
    rdfs:domain gufo:Role ;
    rdfs:range xsd:dateTimeStamp .

icac-gufo:hasRoleEndPoint rdf:type owl:DatatypeProperty ;
    rdfs:label "has role end point"@en ;
    rdfs:comment "Temporal point when person ceases role in investigation. Extends gUFO temporal framework."@en ;
    rdfs:subPropertyOf gufo:hasEndPointInXSDDateTimeStamp ;
    rdfs:domain gufo:Role ;
    rdfs:range xsd:dateTimeStamp .

# =============================================================================
# PHASE 1: ENHANCED RELATIONSHIPS WITH gUFO
# =============================================================================

# Investigation Phase Relationships
icac-gufo:inPhase rdf:type owl:ObjectProperty ;
    rdfs:label "in phase"@en ;
    rdfs:comment "Links investigation to its current phase."@en ;
    rdfs:domain icac-gufo:Investigation ;
    rdfs:range gufo:Phase .

icac-gufo:hasPhase rdf:type owl:ObjectProperty ;
    rdfs:label "has phase"@en ;
    rdfs:comment "Links investigation to all phases it has experienced."@en ;
    rdfs:domain icac-gufo:Investigation ;
    rdfs:range gufo:Phase .

icac-gufo:precedesPhase rdf:type owl:ObjectProperty ;
    rdfs:label "precedes phase"@en ;
    rdfs:comment "Links investigation phase to its chronologically next phase."@en ;
    rdfs:domain gufo:Phase ;
    rdfs:range gufo:Phase .

# Role Relationships
icac-gufo:playsRole rdf:type owl:ObjectProperty ;
    rdfs:label "plays role"@en ;
    rdfs:comment "Links person to role they play in investigation context."@en ;
    rdfs:domain icac-gufo:Person ;
    rdfs:range gufo:Role .

icac-gufo:hasRole rdf:type owl:ObjectProperty ;
    rdfs:label "has role"@en ;
    rdfs:comment "Links investigation to roles involved in it."@en ;
    rdfs:domain icac-gufo:Investigation ;
    rdfs:range gufo:Role .

# Event-Situation Relationships
icac-gufo:occursInSituation rdf:type owl:ObjectProperty ;
    rdfs:label "occurs in situation"@en ;
    rdfs:comment "Links investigation event to situation in which it occurs."@en ;
    rdfs:domain gufo:Event ;
    rdfs:range gufo:Situation .

icac-gufo:createsSituation rdf:type owl:ObjectProperty ;
    rdfs:label "creates situation"@en ;
    rdfs:comment "Links investigation event to situation it creates or modifies."@en ;
    rdfs:domain gufo:Event ;
    rdfs:range gufo:Situation .

# Participation Relationships (gUFO pattern)
icac-gufo:participatesInInvestigation rdf:type owl:ObjectProperty ;
    rdfs:label "participates in investigation"@en ;
    rdfs:comment "Links person (in role) to investigation they participate in."@en ;
    rdfs:domain gufo:Role ;
    rdfs:range icac-gufo:Investigation .

icac-gufo:participatesInEvent rdf:type owl:ObjectProperty ;
    rdfs:label "participates in event"@en ;
    rdfs:comment "Links person (in role) to investigation event they participate in."@en ;
    rdfs:domain gufo:Role ;
    rdfs:range gufo:Event .

# =============================================================================
# PHASE 1: BACKWARD COMPATIBILITY MAPPINGS
# =============================================================================

# Map original ICAC classes to gUFO-enhanced versions
icac:ICACInvestigation owl:equivalentClass icac-gufo:Investigation .
icac:VictimRole owl:equivalentClass icac-gufo:VictimRole .
icac:OffenderRole owl:equivalentClass icac-gufo:OffenderRole .
icac:RescuerRole owl:equivalentClass icac-gufo:RescuerRole .
icac:ChildSexualAbuseEvent owl:equivalentClass icac-gufo:ChildSexualAbuseEvent .
icac:CSAMIncident owl:equivalentClass icac-gufo:CSAMIncident .
icac:LiveStreamingCSA owl:equivalentClass icac-gufo:LiveStreamingCSA .
icac:GroomingSolicitation owl:equivalentClass icac-gufo:GroomingSolicitation .
icac:Sextortion owl:equivalentClass icac-gufo:Sextortion .

# Map original action classes to event versions
icac:ReceiveCybertipAction owl:equivalentClass icac-gufo:ReceiveCybertipEvent .
icac:ReviewCybertipAction owl:equivalentClass icac-gufo:ReviewCybertipEvent .
icac:LegalProcessAction owl:equivalentClass icac-gufo:LegalProcessEvent .
icac:EvidenceReviewAction owl:equivalentClass icac-gufo:EvidenceReviewEvent .
icac:VictimRescueAction owl:equivalentClass icac-gufo:VictimRescueEvent .

# =============================================================================
# PHASE 1: VALIDATION CONSTRAINTS
# =============================================================================

# Phase transition constraints
[] rdf:type owl:AllDisjointClasses ;
   owl:members ( icac-gufo:InitialPhase 
                 icac-gufo:AnalysisPhase 
                 icac-gufo:LegalProcessPhase 
                 icac-gufo:EvidencePhase 
                 icac-gufo:ResolutionPhase 
                 icac-gufo:CompletedPhase ) .

# Role exclusivity constraints (some roles are exclusive)
[] rdf:type owl:AllDisjointClasses ;
   owl:members ( icac-gufo:VictimRole icac-gufo:OffenderRole ) .

# Investigation must be in exactly one phase at any time
icac-gufo:Investigation rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty icac-gufo:inPhase ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass gufo:Phase
] . 