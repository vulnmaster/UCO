@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core#> .
@prefix uco-identity: <https://ontology.unifiedcyberontology.org/uco/identity#> .
@prefix uco-observable: <https://ontology.unifiedcyberontology.org/uco/observable#> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/uco/action#> .
@prefix uco-tool: <https://ontology.unifiedcyberontology.org/uco/tool#> .
@prefix icac: <https://ontology.unifiedcyberontology.org/icac#> .
@prefix icac-ai: <https://ontology.unifiedcyberontology.org/icac/ai-generated#> .

# Ontology Declaration
<https://ontology.unifiedcyberontology.org/icac/ai-generated/0.1> rdf:type owl:Ontology ;
    rdfs:label "ICAC AI-Generated Content Ontology"@en ;
    rdfs:comment "An ontology for representing artificial intelligence-generated child sexual abuse material and related detection, investigation, and prosecution challenges. Based on analysis of Operation Cumberland 2025 and emerging AI-CSAM threats identified by Europol and international law enforcement."@en ;
    owl:versionIRI <https://ontology.unifiedcyberontology.org/icac/ai-generated/0.1> ;
    dcterms:creator "UCO Ontology Team" ;
    dcterms:issued "2025-05-23"^^xsd:date ;
    dcterms:modified "2025-05-23"^^xsd:date ;
    owl:imports <https://ontology.unifiedcyberontology.org/uco/core> ,
                <https://ontology.unifiedcyberontology.org/uco/identity> ,
                <https://ontology.unifiedcyberontology.org/uco/observable> ,
                <https://ontology.unifiedcyberontology.org/uco/action> ,
                <https://ontology.unifiedcyberontology.org/uco/tool> ,
                <https://ontology.unifiedcyberontology.org/icac/0.3> .

# =============================================================================
# AI-GENERATED CONTENT CLASSES (extending UCO Observable)
# =============================================================================

icac-ai:AIGeneratedCSAM rdf:type owl:Class ;
    rdfs:label "AI-Generated CSAM"@en ;
    rdfs:comment "Child sexual abuse material fully generated by artificial intelligence without depicting real victims, but still contributing to objectification and sexualization of children."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

icac-ai:DeepfakeCSAM rdf:type owl:Class ;
    rdfs:label "Deepfake CSAM"@en ;
    rdfs:comment "CSAM created by using AI to alter genuine content, potentially making real victims appear in fabricated scenarios or altering existing abuse material."@en ;
    rdfs:subClassOf icac-ai:AIGeneratedCSAM .

icac-ai:SyntheticMediaCSAM rdf:type owl:Class ;
    rdfs:label "Synthetic Media CSAM"@en ;
    rdfs:comment "Completely synthetic media generated using AI models trained on large datasets, creating realistic but artificial depictions."@en ;
    rdfs:subClassOf icac-ai:AIGeneratedCSAM .

icac-ai:HybridCSAM rdf:type owl:Class ;
    rdfs:label "Hybrid CSAM"@en ;
    rdfs:comment "Content combining real and AI-generated elements, making it difficult to distinguish between authentic and artificial material."@en ;
    rdfs:subClassOf icac-ai:AIGeneratedCSAM .

icac-ai:AIAlteredCSAM rdf:type owl:Class ;
    rdfs:label "AI-Altered CSAM"@en ;
    rdfs:comment "Existing CSAM that has been modified using AI techniques to alter appearance, age, or other characteristics."@en ;
    rdfs:subClassOf icac-ai:DeepfakeCSAM .

# =============================================================================
# AI GENERATION PROCESS CLASSES (extending UCO Action)
# =============================================================================

icac-ai:AIContentGeneration rdf:type owl:Class ;
    rdfs:label "AI Content Generation"@en ;
    rdfs:comment "Process of creating artificial CSAM using machine learning models, neural networks, or other AI technologies."@en ;
    rdfs:subClassOf uco-action:Action .

icac-ai:ModelTraining rdf:type owl:Class ;
    rdfs:label "Model Training"@en ;
    rdfs:comment "Process of training AI models on datasets that may include illegal content for the purpose of generating new CSAM."@en ;
    rdfs:subClassOf icac-ai:AIContentGeneration .

icac-ai:ImageGeneration rdf:type owl:Class ;
    rdfs:label "Image Generation"@en ;
    rdfs:comment "Generation of static images using AI models such as diffusion models, GANs, or other generative techniques."@en ;
    rdfs:subClassOf icac-ai:AIContentGeneration .

icac-ai:VideoGeneration rdf:type owl:Class ;
    rdfs:label "Video Generation"@en ;
    rdfs:comment "Generation of video content using AI models capable of creating temporal sequences and motion."@en ;
    rdfs:subClassOf icac-ai:AIContentGeneration .

icac-ai:FaceSwapping rdf:type owl:Class ;
    rdfs:label "Face Swapping"@en ;
    rdfs:comment "AI technique for replacing faces in existing content with different faces, potentially placing victims in abusive scenarios."@en ;
    rdfs:subClassOf icac-ai:AIContentGeneration .

icac-ai:AgeProgression rdf:type owl:Class ;
    rdfs:label "Age Progression"@en ;
    rdfs:comment "AI technique for artificially aging or de-aging subjects in content, potentially creating illegal material from legal content."@en ;
    rdfs:subClassOf icac-ai:AIContentGeneration .

# =============================================================================
# AI DETECTION AND ANALYSIS CLASSES (extending UCO Action)
# =============================================================================

icac-ai:AIContentDetection rdf:type owl:Class ;
    rdfs:label "AI Content Detection"@en ;
    rdfs:comment "Process of identifying AI-generated or AI-altered content to distinguish from authentic material during investigations."@en ;
    rdfs:subClassOf uco-action:Action .

icac-ai:SyntheticMediaAnalysis rdf:type owl:Class ;
    rdfs:label "Synthetic Media Analysis"@en ;
    rdfs:comment "Forensic analysis of media to determine if it was artificially generated and identify generation techniques used."@en ;
    rdfs:subClassOf icac-ai:AIContentDetection .

icac-ai:DeepfakeDetection rdf:type owl:Class ;
    rdfs:label "Deepfake Detection"@en ;
    rdfs:comment "Specialized analysis for detecting deepfake technology use in content, including face replacement and manipulation."@en ;
    rdfs:subClassOf icac-ai:AIContentDetection .

icac-ai:ArtifactAnalysis rdf:type owl:Class ;
    rdfs:label "Artifact Analysis"@en ;
    rdfs:comment "Analysis of digital artifacts and inconsistencies that may indicate AI generation, such as compression patterns or noise characteristics."@en ;
    rdfs:subClassOf icac-ai:SyntheticMediaAnalysis .

icac-ai:BiometricInconsistencyAnalysis rdf:type owl:Class ;
    rdfs:label "Biometric Inconsistency Analysis"@en ;
    rdfs:comment "Analysis of biometric inconsistencies in AI-generated content, such as unnatural eye movements or facial feature distortions."@en ;
    rdfs:subClassOf icac-ai:SyntheticMediaAnalysis .

# =============================================================================
# AI DETECTION TOOLS (extending UCO Tool)
# =============================================================================

icac-ai:AIDetectionTool rdf:type owl:Class ;
    rdfs:label "AI Detection Tool"@en ;
    rdfs:comment "Software tool specialized for detecting AI-generated content in digital media."@en ;
    rdfs:subClassOf uco-tool:AnalyticTool .

icac-ai:DeepfakeDetectionTool rdf:type owl:Class ;
    rdfs:label "Deepfake Detection Tool"@en ;
    rdfs:comment "Tool specifically designed to identify deepfake content and face manipulation techniques."@en ;
    rdfs:subClassOf icac-ai:AIDetectionTool .

icac-ai:SyntheticImageDetector rdf:type owl:Class ;
    rdfs:label "Synthetic Image Detector"@en ;
    rdfs:comment "Tool for detecting synthetically generated images using machine learning classifiers."@en ;
    rdfs:subClassOf icac-ai:AIDetectionTool .

icac-ai:MetadataAnalysisTool rdf:type owl:Class ;
    rdfs:label "Metadata Analysis Tool"@en ;
    rdfs:comment "Tool for analyzing metadata patterns that may indicate AI generation or manipulation."@en ;
    rdfs:subClassOf icac-ai:AIDetectionTool .

# =============================================================================
# AI-CSAM INVESTIGATION CLASSES (extending UCO Action)
# =============================================================================

icac-ai:AICSAMInvestigation rdf:type owl:Class ;
    rdfs:label "AI-CSAM Investigation"@en ;
    rdfs:comment "Investigation specifically focused on AI-generated child sexual abuse material, requiring specialized techniques and legal frameworks."@en ;
    rdfs:subClassOf uco-action:Action .

icac-ai:GenerationSourceTracking rdf:type owl:Class ;
    rdfs:label "Generation Source Tracking"@en ;
    rdfs:comment "Investigation process to identify the source, tools, and methods used to generate AI-CSAM."@en ;
    rdfs:subClassOf icac-ai:AICSAMInvestigation .

icac-ai:ModelIdentification rdf:type owl:Class ;
    rdfs:label "Model Identification"@en ;
    rdfs:comment "Process of identifying the specific AI model or algorithm used to generate illegal content."@en ;
    rdfs:subClassOf icac-ai:GenerationSourceTracking .

icac-ai:TrainingDataAnalysis rdf:type owl:Class ;
    rdfs:label "Training Data Analysis"@en ;
    rdfs:comment "Analysis of datasets potentially used to train AI models for generating illegal content."@en ;
    rdfs:subClassOf icac-ai:AICSAMInvestigation .

# =============================================================================
# AI-CSAM PROPERTIES
# =============================================================================

# Generation Properties
icac-ai:aiModelUsed rdf:type owl:DatatypeProperty ;
    rdfs:label "AI model used"@en ;
    rdfs:comment "Type of AI model used for generation (e.g., 'Stable Diffusion', 'GAN', 'VAE', 'Transformer')."@en ;
    rdfs:domain icac-ai:AIGeneratedCSAM ;
    rdfs:range xsd:string .

icac-ai:generationTechnique rdf:type owl:DatatypeProperty ;
    rdfs:label "generation technique"@en ;
    rdfs:comment "Specific technique used for content generation (e.g., 'text-to-image', 'image-to-image', 'style transfer')."@en ;
    rdfs:domain icac-ai:AIContentGeneration ;
    rdfs:range xsd:string .

icac-ai:artificialnessLevel rdf:type owl:DatatypeProperty ;
    rdfs:label "artificialness level"@en ;
    rdfs:comment "Degree of artificial generation (fully_synthetic, partially_altered, minimally_modified)."@en ;
    rdfs:domain icac-ai:AIGeneratedCSAM ;
    rdfs:range xsd:string .

icac-ai:realVictimDepicted rdf:type owl:DatatypeProperty ;
    rdfs:label "real victim depicted"@en ;
    rdfs:comment "Whether content depicts or is based on a real victim."@en ;
    rdfs:domain icac-ai:AIGeneratedCSAM ;
    rdfs:range xsd:boolean .

icac-ai:generationComplexity rdf:type owl:DatatypeProperty ;
    rdfs:label "generation complexity"@en ;
    rdfs:comment "Technical sophistication level (basic, intermediate, advanced, expert)."@en ;
    rdfs:domain icac-ai:AIContentGeneration ;
    rdfs:range xsd:string .

icac-ai:renderingQuality rdf:type owl:DatatypeProperty ;
    rdfs:label "rendering quality"@en ;
    rdfs:comment "Quality of AI-generated output (low, medium, high, photorealistic)."@en ;
    rdfs:domain icac-ai:AIGeneratedCSAM ;
    rdfs:range xsd:string .

# Detection Properties
icac-ai:detectionConfidence rdf:type owl:DatatypeProperty ;
    rdfs:label "detection confidence"@en ;
    rdfs:comment "Confidence level of AI detection analysis (0.0-1.0)."@en ;
    rdfs:domain icac-ai:AIContentDetection ;
    rdfs:range xsd:decimal .

icac-ai:detectionMethod rdf:type owl:DatatypeProperty ;
    rdfs:label "detection method"@en ;
    rdfs:comment "Method used for AI detection (neural_network, statistical_analysis, artifact_detection, metadata_analysis)."@en ;
    rdfs:domain icac-ai:AIContentDetection ;
    rdfs:range xsd:string .

icac-ai:artifactsDetected rdf:type owl:DatatypeProperty ;
    rdfs:label "artifacts detected"@en ;
    rdfs:comment "Specific artifacts indicating AI generation (compression_anomalies, facial_inconsistencies, lighting_errors)."@en ;
    rdfs:domain icac-ai:ArtifactAnalysis ;
    rdfs:range xsd:string .

icac-ai:falsePositiveRate rdf:type owl:DatatypeProperty ;
    rdfs:label "false positive rate"@en ;
    rdfs:comment "Rate of false positives in AI detection (0.0-1.0)."@en ;
    rdfs:domain icac-ai:AIDetectionTool ;
    rdfs:range xsd:decimal .

icac-ai:processingTime rdf:type owl:DatatypeProperty ;
    rdfs:label "processing time"@en ;
    rdfs:comment "Time required for AI detection analysis in seconds."@en ;
    rdfs:domain icac-ai:AIContentDetection ;
    rdfs:range xsd:decimal .

# Investigation Properties
icac-ai:investigationChallengeLevel rdf:type owl:DatatypeProperty ;
    rdfs:label "investigation challenge level"@en ;
    rdfs:comment "Difficulty level of investigating AI-CSAM (low, moderate, high, extreme)."@en ;
    rdfs:domain icac-ai:AICSAMInvestigation ;
    rdfs:range xsd:string .

icac-ai:victimIdentificationDifficulty rdf:type owl:DatatypeProperty ;
    rdfs:label "victim identification difficulty"@en ;
    rdfs:comment "Difficulty in identifying real victims when AI content is involved (none, low, moderate, high, impossible)."@en ;
    rdfs:domain icac-ai:AICSAMInvestigation ;
    rdfs:range xsd:string .

icac-ai:sourceTraceability rdf:type owl:DatatypeProperty ;
    rdfs:label "source traceability"@en ;
    rdfs:comment "Degree to which generation source can be traced (untraceable, limited, moderate, high)."@en ;
    rdfs:domain icac-ai:GenerationSourceTracking ;
    rdfs:range xsd:string .

icac-ai:technicalExpertiseRequired rdf:type owl:DatatypeProperty ;
    rdfs:label "technical expertise required"@en ;
    rdfs:comment "Level of technical expertise needed to generate content (basic, intermediate, advanced, expert)."@en ;
    rdfs:domain icac-ai:AIContentGeneration ;
    rdfs:range xsd:string .

# Legal and Procedural Properties
icac-ai:legalFrameworkChallenges rdf:type owl:DatatypeProperty ;
    rdfs:label "legal framework challenges"@en ;
    rdfs:comment "Challenges in existing legal frameworks for AI-generated content (legislation_gaps, jurisdiction_issues, evidence_admissibility)."@en ;
    rdfs:domain icac-ai:AICSAMInvestigation ;
    rdfs:range xsd:string .

icac-ai:prosecutionDifficulty rdf:type owl:DatatypeProperty ;
    rdfs:label "prosecution difficulty"@en ;
    rdfs:comment "Difficulty in prosecuting AI-CSAM cases (low, moderate, high, extreme)."@en ;
    rdfs:domain icac-ai:AICSAMInvestigation ;
    rdfs:range xsd:string .

icac-ai:evidenceAdmissibility rdf:type owl:DatatypeProperty ;
    rdfs:label "evidence admissibility"@en ;
    rdfs:comment "Admissibility of AI-detection evidence in court (accepted, challenged, rejected, unclear)."@en ;
    rdfs:domain icac-ai:AIContentDetection ;
    rdfs:range xsd:string .

# =============================================================================
# AI-CSAM RELATIONSHIPS
# =============================================================================

# Generation Relationships
icac-ai:generatedUsing rdf:type owl:ObjectProperty ;
    rdfs:label "generated using"@en ;
    rdfs:comment "Links AI-generated content to the generation process used."@en ;
    rdfs:domain icac-ai:AIGeneratedCSAM ;
    rdfs:range icac-ai:AIContentGeneration .

icac-ai:basedOnModel rdf:type owl:ObjectProperty ;
    rdfs:label "based on model"@en ;
    rdfs:comment "Links generation process to the AI model used."@en ;
    rdfs:domain icac-ai:AIContentGeneration ;
    rdfs:range uco-observable:ObservableObject .

icac-ai:utilizesTool rdf:type owl:ObjectProperty ;
    rdfs:label "utilizes tool"@en ;
    rdfs:comment "Links generation process to tools used for creation."@en ;
    rdfs:domain icac-ai:AIContentGeneration ;
    rdfs:range uco-tool:Tool .

# Detection Relationships
icac-ai:detectedBy rdf:type owl:ObjectProperty ;
    rdfs:label "detected by"@en ;
    rdfs:comment "Links AI-generated content to detection analysis performed."@en ;
    rdfs:domain icac-ai:AIGeneratedCSAM ;
    rdfs:range icac-ai:AIContentDetection .

icac-ai:usesDetectionTool rdf:type owl:ObjectProperty ;
    rdfs:label "uses detection tool"@en ;
    rdfs:comment "Links detection process to tools used for analysis."@en ;
    rdfs:domain icac-ai:AIContentDetection ;
    rdfs:range icac-ai:AIDetectionTool .

icac-ai:revealsArtifacts rdf:type owl:ObjectProperty ;
    rdfs:label "reveals artifacts"@en ;
    rdfs:comment "Links detection analysis to artifacts discovered."@en ;
    rdfs:domain icac-ai:AIContentDetection ;
    rdfs:range uco-observable:ObservableObject .

# Investigation Relationships
icac-ai:subjectOfInvestigation rdf:type owl:ObjectProperty ;
    rdfs:label "subject of investigation"@en ;
    rdfs:comment "Links AI-generated content to investigations examining it."@en ;
    rdfs:domain icac-ai:AIGeneratedCSAM ;
    rdfs:range icac-ai:AICSAMInvestigation .

icac-ai:tracesToSource rdf:type owl:ObjectProperty ;
    rdfs:label "traces to source"@en ;
    rdfs:comment "Links source tracking to identified origin or creator."@en ;
    rdfs:domain icac-ai:GenerationSourceTracking ;
    rdfs:range uco-identity:Identity .

icac-ai:analyzesTrainingData rdf:type owl:ObjectProperty ;
    rdfs:label "analyzes training data"@en ;
    rdfs:comment "Links investigation to training data analysis performed."@en ;
    rdfs:domain icac-ai:AICSAMInvestigation ;
    rdfs:range icac-ai:TrainingDataAnalysis .

# Legal and Procedural Relationships
icac-ai:challengesLegalFramework rdf:type owl:ObjectProperty ;
    rdfs:label "challenges legal framework"@en ;
    rdfs:comment "Links AI-CSAM to legal framework challenges it creates."@en ;
    rdfs:domain icac-ai:AIGeneratedCSAM ;
    rdfs:range uco-observable:ObservableObject .

icac-ai:requiresSpecializedProsecution rdf:type owl:ObjectProperty ;
    rdfs:label "requires specialized prosecution"@en ;
    rdfs:comment "Links AI-CSAM investigation to specialized prosecution approaches needed."@en ;
    rdfs:domain icac-ai:AICSAMInvestigation ;
    rdfs:range uco-action:Action .

icac-ai:complicatesVictimIdentification rdf:type owl:ObjectProperty ;
    rdfs:label "complicates victim identification"@en ;
    rdfs:comment "Links AI-generated content to victim identification processes it affects."@en ;
    rdfs:domain icac-ai:AIGeneratedCSAM ;
    rdfs:range uco-action:Action . 