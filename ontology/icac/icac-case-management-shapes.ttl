        sh:in ( "supervisor" "senior_investigator" "prosecutor" "legal_counsel" "quality_assurance" "external_expert" ) ;
        sh:message "Case review must specify reviewer role from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:recommendationsCount ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minInclusive 0 ;
        sh:maxInclusive 50 ;
        sh:message "Recommendations count must be between 0 and 50."@en
    ] .

# =============================================================================
# CASE METRICS SHAPES
# =============================================================================

icac-case:CaseMetricsShape rdf:type sh:NodeShape ;
    sh:targetClass icac-case:CaseMetrics ;
    rdfs:label "Case Metrics Shape"@en ;
    rdfs:comment "Validation shape for case metrics instances."@en ;
    sh:property [
        sh:path icac-case:metricType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "case_duration" "resolution_rate" "conviction_rate" "resource_utilization" "cost_per_case" "quality_score" ) ;
        sh:message "Case metrics must specify metric type from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:metricValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 10000.0 ;
        sh:message "Metric value must be between 0.0 and 10000.0."@en
    ] ;
    sh:property [
        sh:path icac-case:measurementUnit ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "days" "hours" "percentage" "count" "dollars" "score" "ratio" ) ;
        sh:message "Case metrics must specify measurement unit from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:reportingPeriod ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "daily" "weekly" "monthly" "quarterly" "annually" "case_based" ) ;
        sh:message "Case metrics must specify reporting period from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:benchmarkValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 10000.0 ;
        sh:message "Benchmark value must be between 0.0 and 10000.0."@en
    ] .

# =============================================================================
# CASE CLOSURE SHAPES
# =============================================================================

icac-case:CaseClosureShape rdf:type sh:NodeShape ;
    sh:targetClass icac-case:CaseClosure ;
    rdfs:label "Case Closure Shape"@en ;
    rdfs:comment "Validation shape for case closure instances."@en ;
    sh:property [
        sh:path icac-case:closureReason ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "conviction" "plea_agreement" "dismissal" "insufficient_evidence" "statute_limitations" "death_of_suspect" "administrative_closure" ) ;
        sh:message "Case closure must specify closure reason from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:closureDate ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Case closure must specify closure date."@en
    ] ;
    sh:property [
        sh:path icac-case:finalDisposition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "guilty_verdict" "not_guilty_verdict" "plea_guilty" "plea_no_contest" "charges_dropped" "case_dismissed" "no_charges_filed" ) ;
        sh:message "Case closure must specify final disposition from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:appealStatus ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "no_appeal" "appeal_pending" "appeal_denied" "appeal_granted" "remanded" "overturned" ) ;
        sh:message "Appeal status must be from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:archivalDate ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:message "Case closure may specify archival date."@en
    ] .

# =============================================================================
# OBJECT PROPERTY SHAPES
# =============================================================================

icac-case:ManagesCaseShape rdf:type sh:PropertyShape ;
    sh:path icac-case:managesCase ;
    sh:name "manages case" ;
    sh:description "Links case management to specific cases" ;
    sh:class case-investigation:Investigation ;
    sh:minCount 1 ;
    sh:maxCount 1 .

icac-case:FollowsWorkflowShape rdf:type sh:PropertyShape ;
    sh:path icac-case:followsWorkflow ;
    sh:name "follows workflow" ;
    sh:description "Links case to workflow stages" ;
    sh:class icac-case:CaseWorkflow ;
    sh:minCount 1 .

icac-case:HasAssignmentShape rdf:type sh:PropertyShape ;
    sh:path icac-case:hasAssignment ;
    sh:name "has assignment" ;
    sh:description "Links case to assignments" ;
    sh:class icac-case:CaseAssignment ;
    sh:minCount 1 .

icac-case:TrackedByShape rdf:type sh:PropertyShape ;
    sh:path icac-case:trackedBy ;
    sh:name "tracked by" ;
    sh:description "Links case to tracking systems" ;
    sh:class icac-case:CaseTracking ;
    sh:minCount 1 .

icac-case:HasDocumentationShape rdf:type sh:PropertyShape ;
    sh:path icac-case:hasDocumentation ;
    sh:name "has documentation" ;
    sh:description "Links case to documentation" ;
    sh:class icac-case:CaseDocumentation ;
    sh:minCount 1 .

icac-case:UndergoesReviewShape rdf:type sh:PropertyShape ;
    sh:path icac-case:undergoesReview ;
    sh:name "undergoes review" ;
    sh:description "Links case to reviews" ;
    sh:class icac-case:CaseReview ;
    sh:minCount 0 .

icac-case:GeneratesMetricsShape rdf:type sh:PropertyShape ;
    sh:path icac-case:generatesMetrics ;
    sh:name "generates metrics" ;
    sh:description "Links case to performance metrics" ;
    sh:class icac-case:CaseMetrics ;
    sh:minCount 0 .

icac-case:ResultsInClosureShape rdf:type sh:PropertyShape ;
    sh:path icac-case:resultsInClosure ;
    sh:name "results in closure" ;
    sh:description "Links case to closure information" ;
    sh:class icac-case:CaseClosure ;
    sh:minCount 0 ;
    sh:maxCount 1 .

# =============================================================================
# CROSS-REFERENCE VALIDATION SHAPES
# =============================================================================

icac-case:CaseManagementCrossReferenceShape rdf:type sh:NodeShape ;
    sh:targetClass icac-case:CaseManagement ;
    rdfs:label "Case Management Cross Reference Shape"@en ;
    rdfs:comment "Validates cross-references between case management and related entities."@en ;
    sh:sparql [
        sh:message "Case management must have assignments, tracking, and documentation."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this a icac-case:CaseManagement .
                FILTER NOT EXISTS {
                    $this icac-case:hasAssignment ?assignment ;
                          icac-case:trackedBy ?tracking ;
                          icac-case:hasDocumentation ?documentation .
                }
            }
        """
    ] .

icac-case:WorkflowConsistencyShape rdf:type sh:NodeShape ;
    sh:targetClass icac-case:CaseWorkflow ;
    rdfs:label "Workflow Consistency Shape"@en ;
    rdfs:comment "Validates workflow stage consistency."@en ;
    sh:sparql [
        sh:message "Workflow stages should follow logical progression."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this icac-case:workflowStage "disposition" .
                FILTER NOT EXISTS {
                    ?case icac-case:followsWorkflow $this, ?prior .
                    ?prior icac-case:workflowStage "court_proceedings" .
                }
            }
        """
    ] .

icac-case:AssignmentWorkloadShape rdf:type sh:NodeShape ;
    sh:targetClass icac-case:InvestigatorAssignment ;
    rdfs:label "Assignment Workload Shape"@en ;
    rdfs:comment "Validates investigator workload consistency."@en ;
    sh:sparql [
        sh:message "High caseload should be balanced with experience level."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this icac-case:caseloadCount ?caseload ;
                      icac-case:investigatorExperience ?experience .
                FILTER (?caseload > 20 && ?experience < 3.0)
            }
        """
    ] .

# =============================================================================
# TEMPORAL VALIDATION SHAPES
# =============================================================================

icac-case:TemporalValidationShape rdf:type sh:NodeShape ;
    sh:targetClass icac-case:CaseManagement ;
    rdfs:label "Temporal Validation Shape"@en ;
    rdfs:comment "Validates temporal consistency in case management."@en ;
    sh:sparql [
        sh:message "Case open date must be before case close date when both are specified."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this icac-case:caseOpenDate ?open ;
                      icac-case:caseCloseDate ?close .
                FILTER (?open >= ?close)
            }
        """
    ] .

icac-case:WorkflowTimingShape rdf:type sh:NodeShape ;
    sh:targetClass icac-case:CaseWorkflow ;
    rdfs:label "Workflow Timing Shape"@en ;
    rdfs:comment "Validates workflow stage timing."@en ;
    sh:sparql [
        sh:message "Stage start date must be before stage end date when both are specified."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this icac-case:stageStartDate ?start ;
                      icac-case:stageEndDate ?end .
                FILTER (?start >= ?end)
            }
        """
    ] .

icac-case:DocumentationTimingShape rdf:type sh:NodeShape ;
    sh:targetClass icac-case:CaseDocumentation ;
    rdfs:label "Documentation Timing Shape"@en ;
    rdfs:comment "Validates documentation timing consistency."@en ;
    sh:sparql [
        sh:message "Creation date must be before or equal to last modified date."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this icac-case:creationDate ?creation ;
                      icac-case:lastModified ?modified .
                FILTER (?creation > ?modified)
            }
        """
    ] .

# =============================================================================
# DATA QUALITY SHAPES
# =============================================================================

icac-case:DataQualityShape rdf:type sh:NodeShape ;
    sh:targetClass icac-case:CaseManagement ;
    rdfs:label "Data Quality Shape"@en ;
    rdfs:comment "Validates data quality for case management."@en ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minLength 5 ;
        sh:maxLength 200 ;
        sh:message "Label should be between 5 and 200 characters when provided."@en
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minLength 10 ;
        sh:maxLength 1000 ;
        sh:message "Comment should be between 10 and 1000 characters when provided."@en
    ] . 