@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/core#> .
@prefix uco-identity: <https://ontology.unifiedcyberontology.org/identity#> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/action#> .
@prefix uco-role: <https://ontology.unifiedcyberontology.org/role#> .
@prefix case-investigation: <https://ontology.caseontology.org/case/investigation#> .
@prefix icac: <https://ontology.unifiedcyberontology.org/icac#> .
@prefix icac-case: <https://ontology.unifiedcyberontology.org/icac/case-management#> .

# =============================================================================
# CASE MANAGEMENT SHAPES
# =============================================================================

icac-case:CaseManagementShape rdf:type sh:NodeShape ;
    sh:targetClass icac-case:CaseManagement ;
    rdfs:label "Case Management Shape"@en ;
    rdfs:comment "Validation shape for case management instances."@en ;
    sh:property [
        sh:path icac-case:caseStatus ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "open" "active" "pending" "suspended" "closed" "archived" "transferred" "merged" ) ;
        sh:message "Case management must specify case status from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:casePriority ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "critical" "high" "medium" "low" "routine" "administrative" ) ;
        sh:message "Case management must specify case priority from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:caseType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "possession" "distribution" "production" "trafficking" "exploitation" "grooming" "sextortion" "multi_offense" ) ;
        sh:message "Case management must specify case type from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:assignedInvestigator ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 3 ;
        sh:maxLength 100 ;
        sh:message "Case management must specify assigned investigator (3-100 characters)."@en
    ] ;
    sh:property [
        sh:path icac-case:caseOpenDate ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Case management must specify case open date."@en
    ] ;
    sh:property [
        sh:path icac-case:caseCloseDate ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:message "Case management may specify case close date."@en
    ] ;
    sh:property [
        sh:path icac-case:jurisdictionLevel ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "local" "state" "federal" "multi_state" "international" "joint_jurisdiction" ) ;
        sh:message "Case management must specify jurisdiction level from the allowed list."@en
    ] .

icac-case:CaseWorkflowShape rdf:type sh:NodeShape ;
    sh:targetClass icac-case:CaseWorkflow ;
    rdfs:label "Case Workflow Shape"@en ;
    rdfs:comment "Validation shape for case workflow instances."@en ;
    sh:property [
        sh:path icac-case:workflowStage ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "intake" "initial_review" "investigation" "evidence_analysis" "prosecution_review" "court_proceedings" "disposition" ) ;
        sh:message "Case workflow must specify workflow stage from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:stageStartDate ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Case workflow must specify stage start date."@en
    ] ;
    sh:property [
        sh:path icac-case:stageEndDate ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:message "Case workflow may specify stage end date."@en
    ] ;
    sh:property [
        sh:path icac-case:stageDuration ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.1 ;
        sh:maxInclusive 3650.0 ;
        sh:message "Stage duration must be between 0.1 and 3650 days (10 years)."@en
    ] ;
    sh:property [
        sh:path icac-case:stageOutcome ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "completed" "pending" "escalated" "transferred" "suspended" "terminated" ) ;
        sh:message "Stage outcome must be from the allowed list."@en
    ] .

# =============================================================================
# CASE ASSIGNMENT SHAPES
# =============================================================================

icac-case:CaseAssignmentShape rdf:type sh:NodeShape ;
    sh:targetClass icac-case:CaseAssignment ;
    rdfs:label "Case Assignment Shape"@en ;
    rdfs:comment "Validation shape for case assignment instances."@en ;
    sh:property [
        sh:path icac-case:assignmentType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "primary_investigator" "secondary_investigator" "lead_detective" "analyst" "supervisor" "prosecutor" ) ;
        sh:message "Case assignment must specify assignment type from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:assignmentDate ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Case assignment must specify assignment date."@en
    ] ;
    sh:property [
        sh:path icac-case:assignmentStatus ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "active" "inactive" "transferred" "completed" "suspended" "terminated" ) ;
        sh:message "Case assignment must specify assignment status from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:workloadPercentage ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minInclusive 1.0 ;
        sh:maxInclusive 100.0 ;
        sh:message "Workload percentage must be between 1.0 and 100.0."@en
    ] ;
    sh:property [
        sh:path icac-case:specialization ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "digital_forensics" "undercover_operations" "victim_services" "legal_analysis" "technical_analysis" "general_investigation" ) ;
        sh:message "Specialization must be from the allowed list."@en
    ] .

icac-case:InvestigatorAssignmentShape rdf:type sh:NodeShape ;
    sh:targetClass icac-case:InvestigatorAssignment ;
    rdfs:label "Investigator Assignment Shape"@en ;
    rdfs:comment "Validation shape for investigator assignment instances."@en ;
    sh:property [
        sh:path icac-case:investigatorExperience ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.5 ;
        sh:maxInclusive 40.0 ;
        sh:message "Investigator experience must be between 0.5 and 40 years."@en
    ] ;
    sh:property [
        sh:path icac-case:caseloadCount ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1 ;
        sh:maxInclusive 100 ;
        sh:message "Investigator caseload count must be between 1 and 100."@en
    ] ;
    sh:property [
        sh:path icac-case:certificationLevel ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:in ( "basic" "intermediate" "advanced" "expert" "specialized" "master" ) ;
        sh:message "Certification level must be from the allowed list."@en
    ] .

# =============================================================================
# CASE TRACKING SHAPES
# =============================================================================

icac-case:CaseTrackingShape rdf:type sh:NodeShape ;
    sh:targetClass icac-case:CaseTracking ;
    rdfs:label "Case Tracking Shape"@en ;
    rdfs:comment "Validation shape for case tracking instances."@en ;
    sh:property [
        sh:path icac-case:trackingNumber ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 5 ;
        sh:maxLength 50 ;
        sh:message "Case tracking must specify tracking number (5-50 characters)."@en
    ] ;
    sh:property [
        sh:path icac-case:trackingSystem ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "local_system" "state_system" "federal_system" "ncmec_system" "multi_system" "custom_system" ) ;
        sh:message "Case tracking must specify tracking system from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:lastUpdate ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Case tracking must specify last update time."@en
    ] ;
    sh:property [
        sh:path icac-case:updateFrequency ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "real_time" "daily" "weekly" "bi_weekly" "monthly" "as_needed" ) ;
        sh:message "Case tracking must specify update frequency from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:accessLevel ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "public" "restricted" "confidential" "classified" "need_to_know" "compartmented" ) ;
        sh:message "Case tracking must specify access level from the allowed list."@en
    ] .

# =============================================================================
# CASE DOCUMENTATION SHAPES
# =============================================================================

icac-case:CaseDocumentationShape rdf:type sh:NodeShape ;
    sh:targetClass icac-case:CaseDocumentation ;
    rdfs:label "Case Documentation Shape"@en ;
    rdfs:comment "Validation shape for case documentation instances."@en ;
    sh:property [
        sh:path icac-case:documentType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "case_report" "evidence_log" "interview_notes" "search_warrant" "arrest_warrant" "court_filing" "expert_report" ) ;
        sh:message "Case documentation must specify document type from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:documentStatus ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "draft" "review" "approved" "filed" "sealed" "archived" "destroyed" ) ;
        sh:message "Case documentation must specify document status from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:creationDate ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Case documentation must specify creation date."@en
    ] ;
    sh:property [
        sh:path icac-case:lastModified ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Case documentation must specify last modified date."@en
    ] ;
    sh:property [
        sh:path icac-case:retentionPeriod ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1.0 ;
        sh:maxInclusive 36500.0 ;
        sh:message "Retention period must be between 1 and 36500 days (100 years)."@en
    ] ;
    sh:property [
        sh:path icac-case:classificationLevel ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "unclassified" "law_enforcement_sensitive" "confidential" "restricted" "classified" "top_secret" ) ;
        sh:message "Case documentation must specify classification level from the allowed list."@en
    ] .

# =============================================================================
# CASE REVIEW SHAPES
# =============================================================================

icac-case:CaseReviewShape rdf:type sh:NodeShape ;
    sh:targetClass icac-case:CaseReview ;
    rdfs:label "Case Review Shape"@en ;
    rdfs:comment "Validation shape for case review instances."@en ;
    sh:property [
        sh:path icac-case:reviewType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "supervisory_review" "peer_review" "quality_assurance" "legal_review" "administrative_review" "external_review" ) ;
        sh:message "Case review must specify review type from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:reviewDate ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Case review must specify review date."@en
    ] ;
    sh:property [
        sh:path icac-case:reviewOutcome ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "approved" "approved_with_conditions" "requires_revision" "rejected" "escalated" "deferred" ) ;
        sh:message "Case review must specify review outcome from the allowed list."@en
    ] ;
    sh:property [
        sh:path icac-case:reviewerRole ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
