@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core#> .
@prefix uco-identity: <https://ontology.unifiedcyberontology.org/uco/identity#> .
@prefix uco-observable: <https://ontology.unifiedcyberontology.org/uco/observable#> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/uco/action#> .
@prefix uco-role: <https://ontology.unifiedcyberontology.org/uco/role#> .
@prefix icac: <https://ontology.unifiedcyberontology.org/icac#> .
@prefix icac-asset-forfeiture: <https://ontology.unifiedcyberontology.org/icac/asset-forfeiture#> .

# Ontology Declaration
<https://ontology.unifiedcyberontology.org/icac/asset-forfeiture/0.1> rdf:type owl:Ontology ;
    rdfs:label "ICAC Asset Forfeiture and Financial Recovery Ontology"@en ;
    rdfs:comment "An ontology for representing asset forfeiture, property restraints, and financial recovery actions in Internet Crimes Against Children investigations, based on Criminal Assets Confiscation Taskforce (CACT) operations and Commonwealth financial penalties."@en ;
    owl:versionIRI <https://ontology.unifiedcyberontology.org/icac/asset-forfeiture/0.1> ;
    dcterms:creator "UCO Ontology Team" ;
    dcterms:issued "2025-05-23"^^xsd:date ;
    dcterms:modified "2025-05-23"^^xsd:date ;
    owl:imports <https://ontology.unifiedcyberontology.org/uco/core> ,
                <https://ontology.unifiedcyberontology.org/uco/identity> ,
                <https://ontology.unifiedcyberontology.org/uco/observable> ,
                <https://ontology.unifiedcyberontology.org/uco/action> ,
                <https://ontology.unifiedcyberontology.org/uco/role> ,
                <https://ontology.unifiedcyberontology.org/icac/0.3> .

# =============================================================================
# ASSET FORFEITURE ACTIONS (extending UCO Action)
# =============================================================================

icac-asset-forfeiture:AssetForfeitureAction rdf:type owl:Class ;
    rdfs:label "Asset Forfeiture Action"@en ;
    rdfs:comment "Legal action to forfeit assets derived from or used in child exploitation crimes."@en ;
    rdfs:subClassOf uco-action:Action .

icac-asset-forfeiture:PropertyRestraintAction rdf:type owl:Class ;
    rdfs:label "Property Restraint Action"@en ;
    rdfs:comment "Legal action to restrain property pending forfeiture proceedings, preventing disposal or transfer."@en ;
    rdfs:subClassOf icac-asset-forfeiture:AssetForfeitureAction .

icac-asset-forfeiture:PropertyForfeitureAction rdf:type owl:Class ;
    rdfs:label "Property Forfeiture Action"@en ;
    rdfs:comment "Legal action resulting in permanent forfeiture of property to the Commonwealth or state."@en ;
    rdfs:subClassOf icac-asset-forfeiture:AssetForfeitureAction .

icac-asset-forfeiture:FinancialPenaltyAction rdf:type owl:Class ;
    rdfs:label "Financial Penalty Action"@en ;
    rdfs:comment "Court-ordered financial penalty equal to benefits derived from child exploitation offenses."@en ;
    rdfs:subClassOf icac-asset-forfeiture:AssetForfeitureAction .

icac-asset-forfeiture:EquipmentSeizureAction rdf:type owl:Class ;
    rdfs:label "Equipment Seizure Action"@en ;
    rdfs:comment "Seizure of equipment used in commission of child exploitation offenses."@en ;
    rdfs:subClassOf icac-asset-forfeiture:AssetForfeitureAction .

# =============================================================================
# CRIMINAL ASSETS CONFISCATION TASKFORCE (CACT)
# =============================================================================

icac-asset-forfeiture:CriminalAssetsConfiscationTaskforce rdf:type owl:Class ;
    rdfs:label "Criminal Assets Confiscation Taskforce"@en ;
    rdfs:comment "Specialized taskforce responsible for asset restraint and forfeiture in child exploitation cases."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

icac-asset-forfeiture:CACTInvestigation rdf:type owl:Class ;
    rdfs:label "CACT Investigation"@en ;
    rdfs:comment "Investigation conducted by Criminal Assets Confiscation Taskforce targeting assets of child exploitation offenders."@en ;
    rdfs:subClassOf uco-action:Action .

icac-asset-forfeiture:AssetAssessmentAction rdf:type owl:Class ;
    rdfs:label "Asset Assessment Action"@en ;
    rdfs:comment "Action to assess the value and ownership of assets for potential forfeiture."@en ;
    rdfs:subClassOf uco-action:Action .

# =============================================================================
# FORFEITURE TARGET ASSETS (extending UCO Observable)
# =============================================================================

icac-asset-forfeiture:ResidentialProperty rdf:type owl:Class ;
    rdfs:label "Residential Property"@en ;
    rdfs:comment "Residential home subject to restraint or forfeiture in child exploitation cases."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

icac-asset-forfeiture:TechnicalEquipment rdf:type owl:Class ;
    rdfs:label "Technical Equipment"@en ;
    rdfs:comment "Technical equipment used in child exploitation offenses (cameras, computers, drones, etc.)."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

icac-asset-forfeiture:FinancialAccount rdf:type owl:Class ;
    rdfs:label "Financial Account"@en ;
    rdfs:comment "Bank account or financial instrument subject to restraint or forfeiture."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

icac-asset-forfeiture:Vehicle rdf:type owl:Class ;
    rdfs:label "Vehicle"@en ;
    rdfs:comment "Vehicle used in or purchased with proceeds from child exploitation offenses."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

icac-asset-forfeiture:HouseholdItems rdf:type owl:Class ;
    rdfs:label "Household Items"@en ;
    rdfs:comment "High-value household items including electronics, furniture, and appliances subject to forfeiture."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

# =============================================================================
# FORFEITURE LEGAL BASIS (extending UCO Observable)
# =============================================================================

icac-asset-forfeiture:LegalBasisForForfeiture rdf:type owl:Class ;
    rdfs:label "Legal Basis for Forfeiture"@en ;
    rdfs:comment "Legal justification and framework for asset forfeiture action."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

icac-asset-forfeiture:ProceedsOfCrime rdf:type owl:Class ;
    rdfs:label "Proceeds of Crime"@en ;
    rdfs:comment "Assets that are proceeds or benefits derived from child exploitation offenses."@en ;
    rdfs:subClassOf icac-asset-forfeiture:LegalBasisForForfeiture .

icac-asset-forfeiture:InstrumentOfOffense rdf:type owl:Class ;
    rdfs:label "Instrument of Offense"@en ;
    rdfs:comment "Assets used as instruments in the commission of child exploitation offenses."@en ;
    rdfs:subClassOf icac-asset-forfeiture:LegalBasisForForfeiture .

icac-asset-forfeiture:NonProfitOffenderAssets rdf:type owl:Class ;
    rdfs:label "Non-Profit Offender Assets"@en ;
    rdfs:comment "Assets of offenders who were not accused of profiting from their crimes, representing first-of-kind forfeiture precedent."@en ;
    rdfs:subClassOf icac-asset-forfeiture:LegalBasisForForfeiture .

# =============================================================================
# FORFEITURE OUTCOMES (extending UCO Observable)
# =============================================================================

icac-asset-forfeiture:ForfeitureOutcome rdf:type owl:Class ;
    rdfs:label "Forfeiture Outcome"@en ;
    rdfs:comment "Result of asset forfeiture proceedings."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

icac-asset-forfeiture:PartialForfeiture rdf:type owl:Class ;
    rdfs:label "Partial Forfeiture"@en ;
    rdfs:comment "Forfeiture of a percentage of property value (e.g., 50% of market value)."@en ;
    rdfs:subClassOf icac-asset-forfeiture:ForfeitureOutcome .

icac-asset-forfeiture:CompleteForfeiture rdf:type owl:Class ;
    rdfs:label "Complete Forfeiture"@en ;
    rdfs:comment "Complete forfeiture of property to the Commonwealth or state."@en ;
    rdfs:subClassOf icac-asset-forfeiture:ForfeitureOutcome .

icac-asset-forfeiture:ConsentOrder rdf:type owl:Class ;
    rdfs:label "Consent Order"@en ;
    rdfs:comment "Court order agreed to by parties for financial penalty payment."@en ;
    rdfs:subClassOf icac-asset-forfeiture:ForfeitureOutcome .

# =============================================================================
# MULTI-JURISDICTIONAL COORDINATION
# =============================================================================

icac-asset-forfeiture:MultiStateForfeiture rdf:type owl:Class ;
    rdfs:label "Multi-State Forfeiture"@en ;
    rdfs:comment "Asset forfeiture operation spanning multiple Australian states and territories."@en ;
    rdfs:subClassOf icac-asset-forfeiture:AssetForfeitureAction .

icac-asset-forfeiture:StateSupremeCourt rdf:type owl:Class ;
    rdfs:label "State Supreme Court"@en ;
    rdfs:comment "State Supreme Court with jurisdiction over forfeiture proceedings."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

# =============================================================================
# FORFEITURE ROLES (extending UCO Role)
# =============================================================================

icac-asset-forfeiture:AssetForfeitureOfficer rdf:type owl:Class ;
    rdfs:label "Asset Forfeiture Officer"@en ;
    rdfs:comment "Officer specializing in asset identification and forfeiture proceedings."@en ;
    rdfs:subClassOf uco-role:Role .

icac-asset-forfeiture:AssetValuationExpert rdf:type owl:Class ;
    rdfs:label "Asset Valuation Expert"@en ;
    rdfs:comment "Expert responsible for determining market value of assets for forfeiture proceedings."@en ;
    rdfs:subClassOf uco-role:Role .

icac-asset-forfeiture:LegalCounsel rdf:type owl:Class ;
    rdfs:label "Legal Counsel"@en ;
    rdfs:comment "Legal counsel specialized in asset forfeiture law and proceedings."@en ;
    rdfs:subClassOf uco-role:Role .

# =============================================================================
# PROPERTIES FOR ASSET FORFEITURE
# =============================================================================

# Financial Properties
icac-asset-forfeiture:marketValue rdf:type owl:DatatypeProperty ;
    rdfs:label "market value"@en ;
    rdfs:comment "Market value of property subject to forfeiture (e.g., $850,000)."@en ;
    rdfs:domain icac-asset-forfeiture:ResidentialProperty ;
    rdfs:range xsd:decimal .

icac-asset-forfeiture:forfeiturePercentage rdf:type owl:DatatypeProperty ;
    rdfs:label "forfeiture percentage"@en ;
    rdfs:comment "Percentage of property value subject to forfeiture (e.g., 50%)."@en ;
    rdfs:domain icac-asset-forfeiture:PartialForfeiture ;
    rdfs:range xsd:decimal .

icac-asset-forfeiture:financialPenaltyAmount rdf:type owl:DatatypeProperty ;
    rdfs:label "financial penalty amount"@en ;
    rdfs:comment "Amount of financial penalty equal to benefits derived from offenses."@en ;
    rdfs:domain icac-asset-forfeiture:FinancialPenaltyAction ;
    rdfs:range xsd:decimal .

icac-asset-forfeiture:estimatedValue rdf:type owl:DatatypeProperty ;
    rdfs:label "estimated value"@en ;
    rdfs:comment "Estimated total value of restrained assets (e.g., $30,000)."@en ;
    rdfs:range xsd:decimal .

# Legal Properties
icac-asset-forfeiture:restraintDate rdf:type owl:DatatypeProperty ;
    rdfs:label "restraint date"@en ;
    rdfs:comment "Date when property restraint order was issued."@en ;
    rdfs:domain icac-asset-forfeiture:PropertyRestraintAction ;
    rdfs:range xsd:dateTime .

icac-asset-forfeiture:forfeitureDate rdf:type owl:DatatypeProperty ;
    rdfs:label "forfeiture date"@en ;
    rdfs:comment "Date when property was forfeited to the Commonwealth."@en ;
    rdfs:domain icac-asset-forfeiture:PropertyForfeitureAction ;
    rdfs:range xsd:dateTime .

icac-asset-forfeiture:courtJurisdiction rdf:type owl:DatatypeProperty ;
    rdfs:label "court jurisdiction"@en ;
    rdfs:comment "Court jurisdiction for forfeiture proceedings (e.g., 'NSW', 'VIC', 'SA')."@en ;
    rdfs:range xsd:string .

# Relationship Properties
icac-asset-forfeiture:relatedCriminalCharges rdf:type owl:ObjectProperty ;
    rdfs:label "related criminal charges"@en ;
    rdfs:comment "Criminal charges related to the asset forfeiture action."@en ;
    rdfs:domain icac-asset-forfeiture:AssetForfeitureAction ;
    rdfs:range uco-observable:ObservableObject .

icac-asset-forfeiture:targetedAsset rdf:type owl:ObjectProperty ;
    rdfs:label "targeted asset"@en ;
    rdfs:comment "Asset that is the target of forfeiture action."@en ;
    rdfs:domain icac-asset-forfeiture:AssetForfeitureAction ;
    rdfs:range uco-observable:ObservableObject .

icac-asset-forfeiture:involvesTaskforce rdf:type owl:ObjectProperty ;
    rdfs:label "involves taskforce"@en ;
    rdfs:comment "Links forfeiture action to the CACT or other taskforce involved."@en ;
    rdfs:domain icac-asset-forfeiture:AssetForfeitureAction ;
    rdfs:range icac-asset-forfeiture:CriminalAssetsConfiscationTaskforce .

icac-asset-forfeiture:precedentSetting rdf:type owl:DatatypeProperty ;
    rdfs:label "precedent setting"@en ;
    rdfs:comment "Indicates whether this forfeiture set a legal precedent (e.g., first restraint of non-profit offender home)."@en ;
    rdfs:domain icac-asset-forfeiture:AssetForfeitureAction ;
    rdfs:range xsd:boolean .

# Equipment Properties
icac-asset-forfeiture:equipmentType rdf:type owl:DatatypeProperty ;
    rdfs:label "equipment type"@en ;
    rdfs:comment "Type of technical equipment (e.g., 'camera equipment', 'drone', 'scuba diving gear')."@en ;
    rdfs:domain icac-asset-forfeiture:TechnicalEquipment ;
    rdfs:range xsd:string .

icac-asset-forfeiture:itemCount rdf:type owl:DatatypeProperty ;
    rdfs:label "item count"@en ;
    rdfs:comment "Number of household items forfeited (e.g., 48 household items)."@en ;
    rdfs:domain icac-asset-forfeiture:HouseholdItems ;
    rdfs:range xsd:nonNegativeInteger .

icac-asset-forfeiture:accountFunds rdf:type owl:DatatypeProperty ;
    rdfs:label "account funds"@en ;
    rdfs:comment "Amount of funds in financial accounts subject to forfeiture."@en ;
    rdfs:domain icac-asset-forfeiture:FinancialAccount ;
    rdfs:range xsd:decimal . 