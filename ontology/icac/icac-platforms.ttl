@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core#> .
@prefix uco-identity: <https://ontology.unifiedcyberontology.org/uco/identity#> .
@prefix uco-observable: <https://ontology.unifiedcyberontology.org/uco/observable#> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/uco/action#> .
@prefix icac: <https://ontology.unifiedcyberontology.org/icac#> .
@prefix icac-platforms: <https://ontology.unifiedcyberontology.org/icac/platforms#> .

# Ontology Declaration
<https://ontology.unifiedcyberontology.org/icac/platforms/0.1> rdf:type owl:Ontology ;
    rdfs:label "ICAC Technology Platforms & Service Providers Ontology"@en ;
    rdfs:comment "An ontology for representing technology platforms, digital services, and Electronic Service Provider (ESP) capabilities in the context of child protection, extending UCO and CASE. This ontology covers social media platforms, messaging services, content hosting, and service provider policies and capabilities."@en ;
    owl:versionIRI <https://ontology.unifiedcyberontology.org/icac/platforms/0.1> ;
    dcterms:creator "UCO Ontology Team" ;
    dcterms:issued "2024-12-19"^^xsd:date ;
    dcterms:modified "2024-12-19"^^xsd:date ;
    owl:imports <https://ontology.unifiedcyberontology.org/uco/core> ,
                <https://ontology.unifiedcyberontology.org/uco/observable> ,
                <https://ontology.unifiedcyberontology.org/uco/identity> ,
                <https://ontology.unifiedcyberontology.org/uco/action> ,
                <https://ontology.unifiedcyberontology.org/icac/0.3> .

# =============================================================================
# PLATFORM SERVICE CLASSES (extending UCO Observable)
# =============================================================================

icac-platforms:SocialMediaPlatform rdf:type owl:Class ;
    rdfs:label "Social Media Platform"@en ;
    rdfs:comment "A digital platform for social networking and content sharing (e.g., Facebook, Instagram, TikTok, Twitter, LinkedIn)."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

icac-platforms:MessagingService rdf:type owl:Class ;
    rdfs:label "Messaging Service"@en ;
    rdfs:comment "A digital service for real-time communication and messaging (e.g., WhatsApp, Telegram, Signal, Discord, Kik)."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

icac-platforms:VideoStreamingPlatform rdf:type owl:Class ;
    rdfs:label "Video Streaming Platform"@en ;
    rdfs:comment "A platform for video content streaming and sharing (e.g., YouTube, Twitch, OnlyFans, Periscope)."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

icac-platforms:FileHostingService rdf:type owl:Class ;
    rdfs:label "File Hosting Service"@en ;
    rdfs:comment "A service for storing and sharing files online (e.g., Google Drive, Dropbox, OneDrive, MEGA)."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

icac-platforms:GamePlatform rdf:type owl:Class ;
    rdfs:label "Game Platform"@en ;
    rdfs:comment "A digital platform for gaming with communication features (e.g., Xbox Live, PlayStation Network, Steam, Roblox, Minecraft)."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

icac-platforms:DarkWebService rdf:type owl:Class ;
    rdfs:label "Dark Web Service"@en ;
    rdfs:comment "A service accessible through anonymizing networks like Tor, often used for illegal activities."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

icac-platforms:OnlineDatingPlatform rdf:type owl:Class ;
    rdfs:label "Online Dating Platform"@en ;
    rdfs:comment "A platform for meeting and dating online (e.g., Tinder, Bumble, Grindr, dating websites)."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

icac-platforms:CryptocurrencyService rdf:type owl:Class ;
    rdfs:label "Cryptocurrency Service"@en ;
    rdfs:comment "A service for cryptocurrency transactions and exchanges (e.g., Bitcoin, Coinbase, Binance)."@en ;
    rdfs:subClassOf uco-observable:ObservableObject .

# =============================================================================
# SERVICE PROVIDER ORGANIZATION CLASSES (extending UCO Identity)
# =============================================================================

icac-platforms:ElectronicServiceProvider rdf:type owl:Class ;
    rdfs:label "Electronic Service Provider (ESP)"@en ;
    rdfs:comment "An organization that provides digital services and platforms, with responsibilities for content moderation and law enforcement cooperation."@en ;
    rdfs:subClassOf uco-identity:Organization .

icac-platforms:TechnicalServiceProvider rdf:type owl:Class ;
    rdfs:label "Technical Service Provider"@en ;
    rdfs:comment "Organizations providing technical infrastructure (hosting, CDN, DNS, etc.) that may be involved in content distribution."@en ;
    rdfs:subClassOf uco-identity:Organization .

# =============================================================================
# PLATFORM CAPABILITY CLASSES
# =============================================================================

icac-platforms:ContentModerationCapability rdf:type owl:Class ;
    rdfs:label "Content Moderation Capability"@en ;
    rdfs:comment "The ability and methods a platform uses to detect, review, and remove inappropriate content."@en ;
    rdfs:subClassOf uco-core:UcoObject .

icac-platforms:DataRetentionPolicy rdf:type owl:Class ;
    rdfs:label "Data Retention Policy"@en ;
    rdfs:comment "A platform's policy for how long they retain user data and content."@en ;
    rdfs:subClassOf uco-core:UcoObject .

icac-platforms:LegalComplianceCapability rdf:type owl:Class ;
    rdfs:label "Legal Compliance Capability"@en ;
    rdfs:comment "A platform's ability to respond to legal requests and cooperate with law enforcement."@en ;
    rdfs:subClassOf uco-core:UcoObject .

icac-platforms:UserVerificationSystem rdf:type owl:Class ;
    rdfs:label "User Verification System"@en ;
    rdfs:comment "Systems used by platforms to verify user identity and age."@en ;
    rdfs:subClassOf uco-core:UcoObject .

# =============================================================================
# PLATFORM-SPECIFIC ACTION CLASSES (extending UCO Action)
# =============================================================================

icac-platforms:ContentModerationAction rdf:type owl:Class ;
    rdfs:label "Content Moderation Action"@en ;
    rdfs:comment "An action taken by a platform to moderate content (review, remove, restrict, etc.)."@en ;
    rdfs:subClassOf uco-action:Action .

icac-platforms:AccountSuspensionAction rdf:type owl:Class ;
    rdfs:label "Account Suspension Action"@en ;
    rdfs:comment "An action to suspend or terminate a user account due to policy violations."@en ;
    rdfs:subClassOf uco-action:Action .

icac-platforms:DataPreservationAction rdf:type owl:Class ;
    rdfs:label "Data Preservation Action"@en ;
    rdfs:comment "An action to preserve user data in response to legal requests."@en ;
    rdfs:subClassOf uco-action:Action .

icac-platforms:LegalDataDisclosureAction rdf:type owl:Class ;
    rdfs:label "Legal Data Disclosure Action"@en ;
    rdfs:comment "An action to disclose user data to law enforcement in response to legal process."@en ;
    rdfs:subClassOf uco-action:Action .

icac-platforms:ContentHashingAction rdf:type owl:Class ;
    rdfs:label "Content Hashing Action"@en ;
    rdfs:comment "An action by a platform to generate hashes of content for detection and matching."@en ;
    rdfs:subClassOf uco-action:Action .

# =============================================================================
# PLATFORM PROPERTIES
# =============================================================================

# Platform Characteristics
icac-platforms:operatedBy rdf:type owl:ObjectProperty ;
    rdfs:label "operated by"@en ;
    rdfs:comment "Links a platform or service to the organization that operates it."@en ;
    rdfs:range icac-platforms:ElectronicServiceProvider .

icac-platforms:platformType rdf:type owl:DatatypeProperty ;
    rdfs:label "platform type"@en ;
    rdfs:comment "The type or category of the platform (e.g., 'social media', 'messaging', 'file hosting')."@en ;
    rdfs:range xsd:string .

icac-platforms:primaryUserBase rdf:type owl:DatatypeProperty ;
    rdfs:label "primary user base"@en ;
    rdfs:comment "The primary demographic of platform users (e.g., 'adults', 'teens', 'children', 'all ages')."@en ;
    rdfs:range xsd:string .

icac-platforms:encryptionLevel rdf:type owl:DatatypeProperty ;
    rdfs:label "encryption level"@en ;
    rdfs:comment "The level of encryption used by the service (e.g., 'none', 'in-transit', 'end-to-end')."@en ;
    rdfs:range xsd:string .

icac-platforms:requiresRegistration rdf:type owl:DatatypeProperty ;
    rdfs:label "requires registration"@en ;
    rdfs:comment "Whether the platform requires user registration to access services."@en ;
    rdfs:range xsd:boolean .

# Content Moderation Properties
icac-platforms:hasContentModerationCapability rdf:type owl:ObjectProperty ;
    rdfs:label "has content moderation capability"@en ;
    rdfs:comment "Links a platform to its content moderation capabilities."@en ;
    rdfs:range icac-platforms:ContentModerationCapability .

icac-platforms:moderationMethod rdf:type owl:DatatypeProperty ;
    rdfs:label "moderation method"@en ;
    rdfs:comment "The method used for content moderation (e.g., 'automated', 'human review', 'hybrid', 'user reporting')."@en ;
    rdfs:domain icac-platforms:ContentModerationCapability ;
    rdfs:range xsd:string .

icac-platforms:csaiDetectionEnabled rdf:type owl:DatatypeProperty ;
    rdfs:label "CSAI detection enabled"@en ;
    rdfs:comment "Whether the platform has Child Sexual Abuse Imagery detection systems enabled."@en ;
    rdfs:domain icac-platforms:ContentModerationCapability ;
    rdfs:range xsd:boolean .

icac-platforms:hashMatchingEnabled rdf:type owl:DatatypeProperty ;
    rdfs:label "hash matching enabled"@en ;
    rdfs:comment "Whether the platform uses hash matching against known CSAM databases."@en ;
    rdfs:domain icac-platforms:ContentModerationCapability ;
    rdfs:range xsd:boolean .

# Data Retention Properties
icac-platforms:hasDataRetentionPolicy rdf:type owl:ObjectProperty ;
    rdfs:label "has data retention policy"@en ;
    rdfs:comment "Links a platform to its data retention policy."@en ;
    rdfs:range icac-platforms:DataRetentionPolicy .

icac-platforms:userDataRetentionPeriod rdf:type owl:DatatypeProperty ;
    rdfs:label "user data retention period"@en ;
    rdfs:comment "How long user account data is retained (in days)."@en ;
    rdfs:domain icac-platforms:DataRetentionPolicy ;
    rdfs:range xsd:integer .

icac-platforms:contentRetentionPeriod rdf:type owl:DatatypeProperty ;
    rdfs:label "content retention period"@en ;
    rdfs:comment "How long user-generated content is retained (in days)."@en ;
    rdfs:domain icac-platforms:DataRetentionPolicy ;
    rdfs:range xsd:integer .

icac-platforms:logRetentionPeriod rdf:type owl:DatatypeProperty ;
    rdfs:label "log retention period"@en ;
    rdfs:comment "How long access and activity logs are retained (in days)."@en ;
    rdfs:domain icac-platforms:DataRetentionPolicy ;
    rdfs:range xsd:integer .

# Legal Compliance Properties
icac-platforms:hasLegalComplianceCapability rdf:type owl:ObjectProperty ;
    rdfs:label "has legal compliance capability"@en ;
    rdfs:comment "Links a platform to its legal compliance capabilities."@en ;
    rdfs:range icac-platforms:LegalComplianceCapability .

icac-platforms:acceptsLegalProcess rdf:type owl:DatatypeProperty ;
    rdfs:label "accepts legal process"@en ;
    rdfs:comment "Whether the platform accepts and responds to legal process requests."@en ;
    rdfs:domain icac-platforms:LegalComplianceCapability ;
    rdfs:range xsd:boolean .

icac-platforms:legalProcessContactInfo rdf:type owl:DatatypeProperty ;
    rdfs:label "legal process contact info"@en ;
    rdfs:comment "Contact information for submitting legal process requests."@en ;
    rdfs:domain icac-platforms:LegalComplianceCapability ;
    rdfs:range xsd:string .

icac-platforms:emergencyDisclosureCapable rdf:type owl:DatatypeProperty ;
    rdfs:label "emergency disclosure capable"@en ;
    rdfs:comment "Whether the platform can provide emergency disclosures for imminent threats."@en ;
    rdfs:domain icac-platforms:LegalComplianceCapability ;
    rdfs:range xsd:boolean .

icac-platforms:responseTimeFrame rdf:type owl:DatatypeProperty ;
    rdfs:label "response time frame"@en ;
    rdfs:comment "Typical response time for legal process requests (in days)."@en ;
    rdfs:domain icac-platforms:LegalComplianceCapability ;
    rdfs:range xsd:integer .

# User Verification Properties
icac-platforms:hasUserVerificationSystem rdf:type owl:ObjectProperty ;
    rdfs:label "has user verification system"@en ;
    rdfs:comment "Links a platform to its user verification system."@en ;
    rdfs:range icac-platforms:UserVerificationSystem .

icac-platforms:ageVerificationMethod rdf:type owl:DatatypeProperty ;
    rdfs:label "age verification method"@en ;
    rdfs:comment "The method used for age verification (e.g., 'self-declaration', 'ID verification', 'credit card', 'none')."@en ;
    rdfs:domain icac-platforms:UserVerificationSystem ;
    rdfs:range xsd:string .

icac-platforms:identityVerificationRequired rdf:type owl:DatatypeProperty ;
    rdfs:label "identity verification required"@en ;
    rdfs:comment "Whether identity verification is required for account creation."@en ;
    rdfs:domain icac-platforms:UserVerificationSystem ;
    rdfs:range xsd:boolean .

# Action Properties
icac-platforms:moderationDecision rdf:type owl:DatatypeProperty ;
    rdfs:label "moderation decision"@en ;
    rdfs:comment "The decision made during content moderation (e.g., 'approved', 'removed', 'restricted', 'flagged')."@en ;
    rdfs:domain icac-platforms:ContentModerationAction ;
    rdfs:range xsd:string .

icac-platforms:suspensionReason rdf:type owl:DatatypeProperty ;
    rdfs:label "suspension reason"@en ;
    rdfs:comment "The reason for account suspension or termination."@en ;
    rdfs:domain icac-platforms:AccountSuspensionAction ;
    rdfs:range xsd:string .

icac-platforms:suspensionDuration rdf:type owl:DatatypeProperty ;
    rdfs:label "suspension duration"@en ;
    rdfs:comment "Duration of account suspension (in days, or 'permanent')."@en ;
    rdfs:domain icac-platforms:AccountSuspensionAction ;
    rdfs:range xsd:string .

icac-platforms:preservationPeriod rdf:type owl:DatatypeProperty ;
    rdfs:label "preservation period"@en ;
    rdfs:comment "How long data is preserved in response to legal requests (in days)."@en ;
    rdfs:domain icac-platforms:DataPreservationAction ;
    rdfs:range xsd:integer .

icac-platforms:dataDisclosed rdf:type owl:ObjectProperty ;
    rdfs:label "data disclosed"@en ;
    rdfs:comment "Links a disclosure action to the specific data that was disclosed."@en ;
    rdfs:domain icac-platforms:LegalDataDisclosureAction ;
    rdfs:range uco-observable:ObservableObject .

icac-platforms:legalAuthority rdf:type owl:ObjectProperty ;
    rdfs:label "legal authority"@en ;
    rdfs:comment "The legal authority (court, agency) that requested the data disclosure."@en ;
    rdfs:domain icac-platforms:LegalDataDisclosureAction ;
    rdfs:range uco-identity:Organization .

# Geographic and Jurisdictional Properties
icac-platforms:operatesInJurisdiction rdf:type owl:DatatypeProperty ;
    rdfs:label "operates in jurisdiction"@en ;
    rdfs:comment "Legal jurisdictions where the platform operates."@en ;
    rdfs:domain icac-platforms:ElectronicServiceProvider ;
    rdfs:range xsd:string .

icac-platforms:headquarteredIn rdf:type owl:DatatypeProperty ;
    rdfs:label "headquartered in"@en ;
    rdfs:comment "Country or jurisdiction where the organization is headquartered."@en ;
    rdfs:domain icac-platforms:ElectronicServiceProvider ;
    rdfs:range xsd:string .

icac-platforms:subsidiaryOf rdf:type owl:ObjectProperty ;
    rdfs:label "subsidiary of"@en ;
    rdfs:comment "Links a platform or organization to its parent company."@en ;
    rdfs:range uco-identity:Organization .

# =============================================================================
# SOCIAL MEDIA EVIDENCE FRAMEWORK (Illinois Case Analysis)
# =============================================================================

icac-platforms:SocialMediaEvidence rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Social Media Evidence"@en ;
    rdfs:comment "Digital evidence collected from social media platforms, including posts, messages, and account information."@en .

icac-platforms:SocialMediaAccount rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:Account ;
    rdfs:label "Social Media Account"@en ;
    rdfs:comment "User account on a social media platform potentially containing evidence."@en .

icac-platforms:CrossPlatformEvidence rdf:type owl:Class ;
    rdfs:subClassOf icac-platforms:SocialMediaEvidence ;
    rdfs:label "Cross-Platform Evidence"@en ;
    rdfs:comment "Evidence found across multiple social media platforms by the same user."@en .

icac-platforms:SocialMediaPost rdf:type owl:Class ;
    rdfs:subClassOf icac-platforms:SocialMediaEvidence ;
    rdfs:label "Social Media Post"@en ;
    rdfs:comment "Individual posts, updates, or content shared on social media platforms."@en .

icac-platforms:PrivateMessage rdf:type owl:Class ;
    rdfs:subClassOf icac-platforms:SocialMediaEvidence ;
    rdfs:label "Private Message"@en ;
    rdfs:comment "Private messages or direct communications on social media platforms."@en .

icac-platforms:AccountMetadata rdf:type owl:Class ;
    rdfs:subClassOf icac-platforms:SocialMediaEvidence ;
    rdfs:label "Account Metadata"@en ;
    rdfs:comment "Account-level metadata including creation date, profile information, and activity patterns."@en .

# =============================================================================
# ELECTRONIC DEVICE EVIDENCE INTEGRATION (Illinois Framework)  
# =============================================================================

icac-platforms:ElectronicDeviceEvidence rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Electronic Device Evidence"@en ;
    rdfs:comment "Digital evidence found on electronic devices including computers, phones, and storage media."@en .

icac-platforms:DeviceSocialMediaCorrelation rdf:type owl:Class ;
    rdfs:subClassOf uco-core:UcoObject ;
    rdfs:label "Device Social Media Correlation"@en ;
    rdfs:comment "Correlation between evidence found on devices and social media accounts."@en .

icac-platforms:StoredSocialMediaContent rdf:type owl:Class ;
    rdfs:subClassOf icac-platforms:ElectronicDeviceEvidence ;
    rdfs:label "Stored Social Media Content"@en ;
    rdfs:comment "Social media content downloaded and stored on electronic devices."@en .

icac-platforms:SocialMediaAppData rdf:type owl:Class ;
    rdfs:subClassOf icac-platforms:ElectronicDeviceEvidence ;
    rdfs:label "Social Media App Data"@en ;
    rdfs:comment "Application data from social media apps stored on devices."@en .

# =============================================================================
# INVESTIGATION COORDINATION (Multi-Platform Analysis)
# =============================================================================

icac-platforms:PlatformInvestigationCoordination rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Platform Investigation Coordination"@en ;
    rdfs:comment "Coordinated investigation across multiple platforms and devices."@en .

icac-platforms:SimultaneousSearchWarrant rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Simultaneous Search Warrant"@en ;
    rdfs:comment "Coordinated search warrant execution on devices and platform accounts."@en .

icac-platforms:DigitalEvidenceCorrelation rdf:type owl:Class ;
    rdfs:subClassOf uco-action:Action ;
    rdfs:label "Digital Evidence Correlation"@en ;
    rdfs:comment "Process of correlating evidence found across devices and platforms."@en .

# =============================================================================
# SOCIAL MEDIA EVIDENCE PROPERTIES (Illinois Case Framework)
# =============================================================================

# Evidence Location Properties
icac-platforms:foundOnDevice rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-platforms:ElectronicDeviceEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "found on device"@en ;
    rdfs:comment "Whether evidence was found on electronic device."@en .

icac-platforms:foundOnSocialMedia rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-platforms:SocialMediaEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "found on social media"@en ;
    rdfs:comment "Whether evidence was found on social media platform."@en .

icac-platforms:deviceType rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-platforms:ElectronicDeviceEvidence ;
    rdfs:range xsd:string ;
    rdfs:label "device type"@en ;
    rdfs:comment "Type of electronic device (computer, phone, tablet, storage media)."@en .

icac-platforms:socialMediaPlatform rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-platforms:SocialMediaEvidence ;
    rdfs:range xsd:string ;
    rdfs:label "social media platform"@en ;
    rdfs:comment "Name of social media platform where evidence was found."@en .

# Evidence Characteristics Properties
icac-platforms:contentType rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-platforms:SocialMediaEvidence ;
    rdfs:range xsd:string ;
    rdfs:label "content type"@en ;
    rdfs:comment "Type of content (text, image, video, document)."@en .

icac-platforms:evidenceCategory rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-platforms:SocialMediaEvidence ;
    rdfs:range xsd:string ;
    rdfs:label "evidence category"@en ;
    rdfs:comment "Category of evidence (possession, distribution, production, communication)."@en .

icac-platforms:accountUsername rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-platforms:SocialMediaAccount ;
    rdfs:range xsd:string ;
    rdfs:label "account username"@en ;
    rdfs:comment "Username or handle for social media account."@en .

icac-platforms:accountStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-platforms:SocialMediaAccount ;
    rdfs:range xsd:string ;
    rdfs:label "account status"@en ;
    rdfs:comment "Status of account (active, suspended, deleted, preserved)."@en .

# Evidence Correlation Properties
icac-platforms:correlatesWithDevice rdf:type owl:ObjectProperty ;
    rdfs:domain icac-platforms:SocialMediaEvidence ;
    rdfs:range icac-platforms:ElectronicDeviceEvidence ;
    rdfs:label "correlates with device"@en ;
    rdfs:comment "Links social media evidence to related device evidence."@en .

icac-platforms:correlatesWithAccount rdf:type owl:ObjectProperty ;
    rdfs:domain icac-platforms:ElectronicDeviceEvidence ;
    rdfs:range icac-platforms:SocialMediaAccount ;
    rdfs:label "correlates with account"@en ;
    rdfs:comment "Links device evidence to related social media account."@en .

icac-platforms:crossPlatformMatch rdf:type owl:ObjectProperty ;
    rdfs:domain icac-platforms:SocialMediaEvidence ;
    rdfs:range icac-platforms:SocialMediaEvidence ;
    rdfs:label "cross platform match"@en ;
    rdfs:comment "Links evidence found on different platforms but from same user."@en .

# Investigation Properties
icac-platforms:discoveredDuring rdf:type owl:ObjectProperty ;
    rdfs:domain icac-platforms:SocialMediaEvidence ;
    rdfs:range uco-action:Action ;
    rdfs:label "discovered during"@en ;
    rdfs:comment "Links evidence to the investigative action during which it was discovered."@en .

icac-platforms:searchWarrantRequired rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-platforms:SocialMediaEvidence ;
    rdfs:range xsd:boolean ;
    rdfs:label "search warrant required"@en ;
    rdfs:comment "Whether search warrant was required to obtain this evidence."@en .

icac-platforms:legalProcessUsed rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-platforms:SocialMediaEvidence ;
    rdfs:range xsd:string ;
    rdfs:label "legal process used"@en ;
    rdfs:comment "Type of legal process used to obtain evidence (warrant, subpoena, court order)."@en .

icac-platforms:evidenceTimestamp rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-platforms:SocialMediaEvidence ;
    rdfs:range xsd:dateTime ;
    rdfs:label "evidence timestamp"@en ;
    rdfs:comment "Timestamp when evidence was created or posted."@en .

icac-platforms:discoveryTimestamp rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-platforms:SocialMediaEvidence ;
    rdfs:range xsd:dateTime ;
    rdfs:label "discovery timestamp"@en ;
    rdfs:comment "Timestamp when evidence was discovered by investigators."@en .

# Multi-Agency Coordination Properties
icac-platforms:coordinatedBy rdf:type owl:ObjectProperty ;
    rdfs:domain icac-platforms:PlatformInvestigationCoordination ;
    rdfs:range uco-identity:Organization ;
    rdfs:label "coordinated by"@en ;
    rdfs:comment "Organization coordinating multi-platform investigation."@en .

icac-platforms:platformsInvestigated rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-platforms:PlatformInvestigationCoordination ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "platforms investigated"@en ;
    rdfs:comment "Number of platforms investigated in coordinated effort."@en .

icac-platforms:devicesSearched rdf:type owl:DatatypeProperty ;
    rdfs:domain icac-platforms:SimultaneousSearchWarrant ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "devices searched"@en ;
    rdfs:comment "Number of devices searched in simultaneous operation."@en . 